{
  "height": 43,
  "modules-center": [],
  "modules-right": [
    "group/monitoring",
    "group/status-tail"
  ],
  "image#metric-cpu": {
    "exec": "$HOME/.local/bin/garage-metrics --bar-svg cpu",
    "size": 82,
    "interval": 2,
    "tooltip": true,
    "on-click": "$HOME/.local/bin/garage-panel-toggle monitor cpu"
  },
  "image#metric-memory": {
    "exec": "$HOME/.local/bin/garage-metrics --bar-svg memory",
    "size": 82,
    "interval": 2,
    "tooltip": true,
    "on-click": "$HOME/.local/bin/garage-panel-toggle monitor memory"
  },
  "image#metric-network": {
    "exec": "$HOME/.local/bin/garage-metrics --bar-svg network",
    "size": 130,
    "interval": 2,
    "tooltip": true,
    "on-click": "$HOME/.local/bin/garage-panel-toggle monitor network"
  },
  "custom/ai-usage": {
    "exec": "$HOME/.local/bin/garage-ai-usage --bar",
    "return-type": "json",
    "interval": 300,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "$HOME/.local/bin/garage-panel-toggle ai-usage"
  },
  "group/monitoring": {
    "orientation": "horizontal",
    "modules": [
      "image#metric-cpu",
      "image#metric-memory",
      "image#metric-network"
    ]
  },
  "group/status-tail": {
    "orientation": "horizontal",
    "modules": [
      "custom/ai-usage",
      "custom/notifications",
      "custom/launcher",
      "custom/control-center",
      "clock"
    ]
  },
  "custom/media": {
    "exec": "$HOME/.local/bin/garage-waybar-module media",
    "return-type": "json",
    "interval": 2,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "$HOME/.local/bin/garage-panel-toggle media",
    "on-click-middle": "/usr/bin/playerctl --player=playerctld play-pause",
    "on-click-right": "/usr/bin/playerctl --player=playerctld next",
    "on-scroll-up": "/usr/bin/playerctl --player=playerctld previous",
    "on-scroll-down": "/usr/bin/playerctl --player=playerctld next"
  }
}
