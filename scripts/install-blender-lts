#!/usr/bin/env bash
set -euo pipefail

version=4.5.12
archive="blender-${version}-linux-x64.tar.xz"
checksum=95e3a2dfedba3bd32ca54fc355eac6b15a11986954ccb02815a07535d0120a25
url="https://download.blender.org/release/Blender4.5/${archive}"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/blender-lts"
install_dir="$HOME/.local/opt/blender-${version}"
archive_path="$cache_dir/$archive"

if [[ -x "$install_dir/blender" ]]; then
    echo "Blender ${version} LTS is already installed."
else
    mkdir -p "$cache_dir" "$HOME/.local/opt" "$HOME/.local/bin"

    if [[ ! -f "$archive_path" ]] || ! printf '%s  %s\n' "$checksum" "$archive_path" | sha256sum --check --status; then
        curl --fail --location --retry 3 --output "$archive_path.part" "$url"
        mv "$archive_path.part" "$archive_path"
    fi

    printf '%s  %s\n' "$checksum" "$archive_path" | sha256sum --check

    temp_dir=$(mktemp -d "$HOME/.local/opt/.blender-${version}.XXXXXX")
    trap 'rm -rf -- "$temp_dir"' EXIT
    tar -xJf "$archive_path" --strip-components=1 -C "$temp_dir"
    mv "$temp_dir" "$install_dir"
    trap - EXIT
fi

mkdir -p "$HOME/.local/bin" "$HOME/.local/share/applications"
ln -sfn "$install_dir/blender" "$HOME/.local/bin/blender"

cat > "$HOME/.local/share/applications/blender.desktop" <<EOF
[Desktop Entry]
Name=Blender 4.5 LTS
Comment=3D modeling, animation, rendering and post-production
Exec=$HOME/.local/bin/blender %f
Icon=$install_dir/blender.svg
Terminal=false
Type=Application
Categories=Graphics;3DGraphics;
MimeType=application/x-blender;
StartupWMClass=Blender
EOF

update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
echo "Blender ${version} LTS installed at $install_dir"
