#!/usr/bin/env bash
#
# Classification: process/container choreography (STAYS SHELL). The decisions
# live in the profile and installer payload; this file materializes ArchISO,
# embeds one committed Garage revision, and invokes mkarchiso.

set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
variant="${1:-netinstall}"
source_ref="${2:-HEAD}"
cache_dir="${GARAGE_ISO_CACHE_DIR:-$repo_dir/.cache/iso}"
pacman_cache="${GARAGE_ISO_PACMAN_CACHE:-$cache_dir/pacman}"
offline_package_cache="${GARAGE_ISO_OFFLINE_PACKAGE_CACHE:-$cache_dir/offline-packages}"
offline_toolchain_cache="${GARAGE_ISO_OFFLINE_TOOLCHAIN_CACHE:-$cache_dir/offline-toolchain}"
work_dir="${GARAGE_ISO_WORK_DIR:-$cache_dir/work}"
out_dir="${GARAGE_ISO_OUT_DIR:-$repo_dir/out/iso}"
container_image="${GARAGE_ISO_CONTAINER_IMAGE:-archlinux:latest}"

if (($# > 2)); then
    printf 'Usage: %s [netinstall|offline] [git-ref]\n' "${0##*/}" >&2
    exit 2
fi

case "$variant" in
    netinstall | offline) ;;
    *)
        printf 'Usage: %s [netinstall|offline] [git-ref]\n' "${0##*/}" >&2
        exit 2
        ;;
esac

if ! command -v docker >/dev/null 2>&1; then
    printf 'Garage ISO build requires Docker.\n' >&2
    exit 1
fi

source_commit="$(git -C "$repo_dir" rev-parse --verify --end-of-options "$source_ref^{commit}")"
source_epoch="$(git -C "$repo_dir" show -s --format=%ct "$source_commit")"

mkdir -p -- \
    "$cache_dir" \
    "$pacman_cache" \
    "$offline_package_cache" \
    "$offline_toolchain_cache" \
    "$work_dir" \
    "$out_dir"

# Resolve the ref once, then materialize both inputs from the same object graph.
# Never mount the invoking checkout: its profile, package list, scripts, or lock
# file may contain staged/unstaged edits even when the embedded bundle is clean.
snapshot_dir="$(mktemp -d "$cache_dir/source.XXXXXX")"
cleanup() {
    rm -rf -- "$snapshot_dir"
}
trap cleanup EXIT
bundle_dir="$snapshot_dir/payload"
source_dir="$snapshot_dir/source"
mkdir -p -- "$bundle_dir" "$source_dir"
git init --quiet --bare "$snapshot_dir/git"
git --git-dir="$snapshot_dir/git" fetch --quiet --no-tags \
    "$repo_dir" "$source_commit:refs/heads/main"
git --git-dir="$snapshot_dir/git" symbolic-ref HEAD refs/heads/main
git --git-dir="$snapshot_dir/git" archive HEAD | tar -xf - -C "$source_dir"

printf 'Building Garage %s from committed revision %s\n' "$variant" "$source_commit"
git --git-dir="$snapshot_dir/git" bundle create --quiet "$bundle_dir/garage.bundle" HEAD main
printf '%s\n' "$source_commit" >"$bundle_dir/source-commit"

docker run --rm --privileged \
    --env HOST_UID="$(id -u)" \
    --env HOST_GID="$(id -g)" \
    --env GARAGE_ISO_VARIANT="$variant" \
    --env SOURCE_DATE_EPOCH="$source_epoch" \
    --volume "$source_dir:/garage:ro" \
    --volume "$pacman_cache:/var/cache/pacman/pkg" \
    --volume "$offline_package_cache:/offline-cache" \
    --volume "$offline_toolchain_cache:/offline-toolchain" \
    --volume "$work_dir:/build" \
    --volume "$out_dir:/out" \
    --volume "$bundle_dir:/bundle:ro" \
    "$container_image" \
    bash /garage/iso/container-build

latest_iso="$(find "$out_dir" -maxdepth 1 -type f -name "garage-$variant-*.iso" -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-)"
if [[ -z $latest_iso ]]; then
    printf 'mkarchiso returned without a Garage ISO in %s\n' "$out_dir" >&2
    exit 1
fi

sha256sum "$latest_iso" >"$latest_iso.sha256"
printf '\nBuilt %s\n' "$latest_iso"
printf 'SHA-256: '
cut -d' ' -f1 <"$latest_iso.sha256"
