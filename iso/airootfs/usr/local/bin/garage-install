#!/usr/bin/env bash
# Launch Garage's guided netinstall from the live environment.
# Classification: live-service and TTY/process choreography (STAYS SHELL).

set -u

variant="$(cat /opt/garage-installer/variant 2>/dev/null || printf 'netinstall')"
archinstall_args=(
    --config /opt/garage-installer/config.json
    --plugin /opt/garage-installer/plugin.py
    --skip-version-check
)
if [[ $variant == offline ]]; then
    title='Garage offline installer'
    connection_note='Everything needed for installation is on this image. A network connection is optional.'
    # Offline mode still waits for NTP and the online keyring refresh unless
    # explicitly skipped. Pacman continues to verify the shipped signatures.
    archinstall_args+=(--offline --no-pkg-lookups --skip-ntp --skip-wkd)
else
    title='Garage netinstall'
    connection_note='The installation downloads current Arch and Garage dependencies. It needs a working network connection.'
fi

prepare_keyring() {
    if [[ $variant == offline ]]; then
        # Releng orders pacman-init after time-sync.target. On a disconnected
        # machine the wait service never finishes, leaving the keyring empty.
        systemctl stop systemd-time-wait-sync.service || return "$?"
    fi
    systemctl start pacman-init.service
}

clear
printf '%s is ready\n\n' "$title"
cat <<'BANNER'

This installer lays down minimal Arch, then schedules Garage's own bootstrap
for the first real TTY login. You will choose the disk, locale, bootloader, and
one administrator account in Archinstall.
BANNER
printf '\n%s\n' "$connection_note"

while true; do
    printf '\nPress Enter to begin, or type shell for a recovery shell: '
    IFS= read -r answer
    if [[ $answer == shell ]]; then
        exec zsh
    fi

    prepare_keyring && archinstall "${archinstall_args[@]}"
    status=$?

    printf '\nInstaller exited with status %s.\n' "$status"
    printf 'Press Enter to reopen it, or type shell for a recovery shell: '
    IFS= read -r answer
    if [[ $answer == shell ]]; then
        exec zsh
    fi
done
