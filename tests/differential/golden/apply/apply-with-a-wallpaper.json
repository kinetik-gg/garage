    "hyprctl monitors all -j",
    "luac -p $HOME/.local/state/garage/generated/.preferences.lua.XXXXXXXX",
    "env LC_ALL=C gio mime x-scheme-handler/http",
    "env LC_ALL=C gio mime x-scheme-handler/https",
    "env LC_ALL=C gio mime text/html",
    "hyprctl monitors -j",
    "luac -p $HOME/.local/state/garage/generated/.workspaces.lua.XXXXXXXX",
    "luac -p $HOME/.local/state/garage/generated/.displays.lua.XXXXXXXX",
    "gsettings range org.gnome.desktop.interface accent-color",
    "gsettings set org.gnome.desktop.interface accent-color blue",
    "hyprctl eval 'hl.config({decoration = {rounding = 7, rounding_power = 3.37}, plugin = {kinetik_glass = {layer_rounding = 7, corner_power = 3.37}, hyprexpo = {tile_rounding = 7, tile_rounding_power = 3.37}}}) hl.config({decoration = {blur = {size = hl.get_config(\"decoration:blur:size\")}}})'",
    "file --brief --mime-type -L $HOME/pic.png",
    "file --brief --mime-type -L $HOME/pic.png",
    "hyprctl monitors -j",
    "hyprctl hyprpaper wallpaper eDP-1,$HOME/pic.png",
    "hyprctl hyprpaper wallpaper DP-2,$HOME/pic.png",
    "gsettings set org.gnome.desktop.interface color-scheme prefer-dark",
    "gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark",
    "gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark",
    "systemctl --user reload-or-restart xsettingsd.service",
    "pkill -USR2 -x waybar",
    "pkill -USR1 -x kitty",
    "systemctl --user try-restart swayosd.service",
    "hyprctl reload",
    "file --brief --mime-type -L $HOME/pic.png",
    "systemctl --user restart hyprpaper.service",
    "hyprctl hyprsunset identity",
    "systemctl --user restart hypridle.service"
  ]
