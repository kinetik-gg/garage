# Local/editor noise should never enter the dotfiles repository.
.DS_Store
*~
*.bak
*.swp
*.tmp
__pycache__/
*.py[cod]

# Keep credentials and machine-generated state out if added later.
**/hosts.yml
**/fish_variables
**/cookie
**/*.db
**/*.sqlite*

# systemctl enable creates host-local activation symlinks.
**/.config/systemd/user/*.target.wants/

# Generated per-user files. bootstrap.sh recreates these with the active home.
desktop/.config/gtk-3.0/bookmarks
desktop/.config/swayosd/config.toml
desktop/.config/waybar/monitor-dashboard-url

# The palette, rendered from PALETTE in the backend on every theme render.
# Ignored here as well as in .stow-local-ignore so that pointing a render at the
# checkout -- which `render_toolkits(root=...)` makes easy -- cannot commit a
# generated copy back over the table it came from.
desktop/.config/gtk-3.0/apple-dark.css
desktop/.config/gtk-3.0/apple-light.css
desktop/.config/gtk-4.0/apple.css
desktop/.config/rofi/apple-dark.rasi
desktop/.config/rofi/apple-light.rasi
desktop/.config/swaync/swaync-dark.css
desktop/.config/swaync/swaync-light.css
desktop/.config/swayosd/swayosd-dark.css
desktop/.config/swayosd/swayosd-light.css
desktop/.config/qt6ct/colors/vanta.conf
desktop/.config/qt6ct/colors/vanta-light.conf

# System Preferences keeps writable per-machine state beside tracked defaults.
desktop/.config/garage/preferences.toml
desktop/.config/garage/displays.toml

# Generated theme/state fragments now live outside the stow tree entirely, but
# ignore the path in case anything ever lands one inside the repo checkout.
.local/state/garage/generated/
.config/user-dirs.dirs
