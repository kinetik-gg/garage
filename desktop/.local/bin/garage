    "appearance.glass_blur": {
        "default": "normal", "kind": "enum", "members": GLASS_BLUR_LEVELS,
        "route": "glass",
    },
    "appearance.glass_transparency": {
        "default": 0.04, "kind": "float",
        "minimum": 0, "maximum": GLASS_TRANSPARENCY_MAX, "route": "glass",
    },
    # px of refracted edge. Below 4 there is nothing to see; past 128 the edge
    # is wider than most of the controls it is drawn on.
    "appearance.glass_edge_width": {
        "default": 24, "kind": "int", "minimum": 4, "maximum": 128,
        "route": "glass",
    },
    # The three unit-interval material weights. 0 and 1 are both meaningful
    # ends, so the range is closed on both.
    "appearance.glass_refraction": {
        "default": 0.7, "kind": "float", "minimum": 0, "maximum": 1,
        "route": "glass",
