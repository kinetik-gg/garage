    "appearance.glass_clarity": {
        "default": 0.75, "kind": "float", "minimum": 0, "maximum": 1,
        "route": "glass",
    },
    "appearance.glass_highlight": {
        "default": 0.12, "kind": "float", "minimum": 0, "maximum": 1,
        "route": "glass",
    },

    # Held as a desktop id rather than a command so the pane can show the name
    # and icon the application ships. An id that is no longer installed is left
    # alone -- any string will do -- because resolve_terminal() falls back on its
    # own, and the choice is worth keeping in case the application comes back.
    "general.terminal": {
        "default": "", "kind": "free_string", "route": "terminal",
    },
    "general.builtin_launcher": {
        "default": True, "kind": "bool", "route": "launcher",
