# What "kind" means, as one predicate each over (entry, value). The predicates
# themselves are in_number_range(), is_clock_time() and is_hex_color(), which sit
# beside validate_preferences() where their reasoning is; this table is only the
# mapping from a name in the schema to one of them.
PREFERENCE_KINDS: dict[str, object] = {
    # Not validated at all, and settable. Either the renderer coerces whatever
    # it is handed and cannot fail on it, or nothing downstream reads it as
    # anything but a string.
    "unchecked": lambda entry, value: True,
    # Not validated and not settable: the version stamp.
    "bookkeeping": lambda entry, value: True,
    # Rewritten by the entry's own `normalise`, so it never reaches a predicate.
    "normalised": lambda entry, value: True,
    "bool": lambda entry, value: isinstance(value, bool),
    "int": lambda entry, value: in_number_range(
        value, entry["minimum"], entry["maximum"]),
    "float": lambda entry, value: in_number_range(
        value, entry["minimum"], entry["maximum"]),
    "enum": lambda entry, value: value in entry["members"],
    "time": lambda entry, value: is_clock_time(value),
    "hex_color": lambda entry, value: is_hex_color(value),
    "free_string": lambda entry, value: isinstance(value, str),
    "nonempty_string": lambda entry, value: isinstance(value, str) and bool(value),
    "locale": lambda entry, value: isinstance(value, str) and (
        not value or value in installed_locales()),
}

# Which extra keys `set` may not be given a range or a member list for, because
# they are not numbers or enums. Derived, so a kind that grows a constraint
# cannot forget to declare it: see tests/test_schema_table.py.
PREFERENCE_KIND_CONSTRAINTS: dict[str, tuple[str, ...]] = {
    "int": ("minimum", "maximum"),
    "float": ("minimum", "maximum"),
    "enum": ("members",),
    "normalised": ("normalise",),
}


# What `set` does after the file is written, per route, as data: the calls in
# order. A step is the name of a module-level function called with the config, or
# a tuple of that name and the extra arguments to pass after it -- resolved
# through globals() at call time, because every renderer and applier is defined
# further down the file. tests/test_schema_table.py checks that each name is
# really there and takes the arguments named beside it.
#
# The split this preserves: a render_* step writes a file and signals nothing, an
# apply_* or push_* step moves the running session. See render_all().
PREFERENCE_ROUTES: dict[str, tuple] = {
    # No theme work on any of these: every palette output is derived from the
    # resolved scheme alone, including the bar foreground. Nothing reads the
    # image, so a new wallpaper cannot change what the theme would emit.
    "wallpaper": ("apply_wallpaper",),
    "wallpaper_light": (("apply_live_wallpaper", "light"),),
    "wallpaper_dark": (("apply_live_wallpaper", "dark"),),
    "accent": ("apply_accent",),
    "search": ("render_search_engine",),
    "corner_radius": ("render_preferences", "apply_corner_radius"),
    "border": ("render_preferences", "apply_border"),
    "motion": ("render_preferences", "apply_motion"),
    "theme": ("apply_theme_if_scheme_moved",),
    "glass": ("render_preferences", "apply_glass"),
    "night_shift": ("apply_night_shift",),
    "terminal": ("apply_terminal",),
    # Nothing to reload: the wrapper reads the marker on every press and the
    # shell watches it, so the switch takes effect as it is written.
    "launcher": ("render_general",),
    "input": ("render_preferences",
              ("run_or_raise", ["hyprctl", "reload"],
               "Unable to reload input settings")),
    # Nothing but hypridle.conf: the whole lock section is timeouts, and no other
    # fragment carries one. Narrow also because the restart is synchronous and
    # its ExecStartPre re-enters this binary as `garage render-idle` -- all of
    # this runs with PREFERENCES_LOCK held by `set`, so the re-entrant render
    # must stay on a path that never takes it.
    "idle": ("render_idle",
             ("run_or_raise", ["systemctl", "--user", "restart", "hypridle.service"],
              "Unable to reload idle settings")),
    # Every region key reaches the bar clock -- the locale names its weekday and
    # month, the rest shape the format string -- so all four take the same route
    # out, and the locale takes one step more.
    "locale": ("apply_locale", "apply_region"),
    "region": ("apply_region",),
    "workspaces": ("apply_workspace_plan",),
    # Nothing in the compositor depends on this, so the desktop is left alone.
    "workspace_indicator": ("apply_bar_workspaces",),
}

# The route a key the table does not have takes, per section. Unreachable through
# `set`, which gates on the schema -- so this is not a fallback the product uses,
# it is the behaviour a key outside the schema has always had, kept because a
# section-wide reload was never an error and a refactor must not invent one.
# appearance and general are absent on purpose: both have always refused an
# unknown key by name, and apply_changed_preference() raises for them.
SECTION_ROUTES = {"input": "input", "lock": "idle", "region": "region",
                  "workspaces": "workspaces"}

# Keys the schema used to have, dropped from the merged view on every load so a
# file that somehow carries both a version stamp and an old key cannot write it
# back out on every save. The wallpaper singles are pre-v3 -- see WALLPAPER_SPLIT
# and migrate_preference_values(), which is where they are carried across rather
# than lost -- and highlight_color was withdrawn outright.
WITHDRAWN_KEYS = {"appearance": tuple(WALLPAPER_SPLIT) + ("highlight_color",)}


def schema_defaults() -> dict:
    """FALLBACK_DEFAULTS, derived: the table's defaults in the file's own shape.

    Nested section -> key -> value, because that is what preferences.defaults.toml
    is and what every consumer already expects. Sections and keys come out in the
    table's order.
    """
    defaults: dict[str, dict] = {}
    for dotted, entry in PREFERENCE_SCHEMA.items():
        section, key = dotted.split(".", 1)
        defaults.setdefault(section, {})[key] = entry["default"]
    return defaults


def schema_sections() -> tuple[str, ...]:
    """The sections the validation pass walks, in the table's order.

    [schema] is not one of them: the version stamp is this program's
    bookkeeping, it is written unconditionally by preference_document(), and
    coercing it would mean coercing the very thing the migration reads to decide
    whether to run.
    """
    return tuple(dict.fromkeys(
        dotted.split(".", 1)[0] for dotted, entry in PREFERENCE_SCHEMA.items()
        if entry["kind"] != "bookkeeping"))


# Layer 1 as this build compiles it in: what load_toml(DEFAULTS_PATH, ...) falls
# back to when the shipped file is missing, and what validate_preferences()
# coerces an unusable value to. Derived from the table above, which is why it can
# no longer disagree with the validation pass -- it used to be a second copy of
# the same schema, agreeing with the first only by hand. It must still agree with
# preferences.defaults.toml, and tests/test_schema.py is what enforces that.
FALLBACK_DEFAULTS = schema_defaults()
VALIDATED_SECTIONS = schema_sections()


class SettingsError(RuntimeError):
    pass


def run(command: list[str], *, check: bool = False, timeout: float = 4) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(command, text=True, capture_output=True, check=check, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as error:
        if check:
            raise SettingsError(str(error)) from error
        return subprocess.CompletedProcess(command, 1, "", str(error))


def deep_merge(base: dict, override: dict) -> dict:
    result = copy.deepcopy(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = deep_merge(result[key], value)
        else:
            result[key] = copy.deepcopy(value)
    return result


def load_toml(path: Path, fallback: dict | None = None) -> dict:
    if not path.exists():
        return copy.deepcopy(fallback or {})
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise SettingsError(f"{path.name}: {error}") from error


def shipped_defaults() -> dict:
    """Layer 1 as this process sees it: the shipped file, or the compiled-in copy.

    A function rather than two `load_toml(DEFAULTS_PATH, FALLBACK_DEFAULTS)` calls
    because the load and the save have to agree on it exactly. It is the base a
    load merges the stored file on top of, so it is also the base a save
    subtracts to get the stored file back down to departures. Subtract a
    different base -- FALLBACK_DEFAULTS while the load merged the TOML, say --
    and any key where the two disagree comes out of the save as a delta the load
    never saw, which is the fossil this is here to prevent.
    """
    return load_toml(DEFAULTS_PATH, FALLBACK_DEFAULTS)


def schema_version(stored: dict) -> int:
    """The stamp a stored preferences.toml carries, or 1 if it carries none.

    A hand-mangled stamp is treated as older than current rather than fatal:
    refusing the file here would leave the whole UI read-only.
    """
    schema = stored.get("schema")
    version = schema.get("preferences_version", 1) if isinstance(schema, dict) else 1
    if not isinstance(version, int) or isinstance(version, bool):
        return 1
    return version


def migrate_config_root() -> None:
    """v4: carry the user-owned files over from ~/.config/workstation.

    A step of the same migration the version stamp drives, and gated on the same
    stamp, but it cannot live in migrate_preferences(): the files have to be at
    their new home before preferences.toml is read at all, and by the time that
    function is handed a dict the read has already happened -- from the new path,
    which would still be empty. So the stamp is read from the old file here.

    Only real files move. preferences.defaults.toml in the old directory is a
    stow symlink into the dotfiles checkout -- layer 1, not the user's -- and
    following it would drag a tracked file out of the repo. generated/ is left
    behind for the mirror-image reason: it is layer 3, machine-written, and
    `garage render` rewrites it under STATE_ROOT anyway.

    Idempotent, and a no-op on the fresh install where the old directory never
    existed at all: a second run finds nothing left to move.
    """
    if not LEGACY_ROOT.is_dir() or LEGACY_ROOT == ROOT:
        return
    try:
        version = schema_version(load_toml(LEGACY_ROOT / "preferences.toml"))
    except SettingsError:
        # Unparseable is "older than current" rather than fatal. The file is
        # still the user's, and it is worth more at the new path -- where the
        # loader can report it once -- than stranded at the old one.
        version = 1
    if version < 4:
        for name, target in MIGRATED_FILES.items():
            # An env-overridden path is not the host config root: a second
            # profile or a test harness pointing elsewhere must not reach in and
            # move the real session's files out from under it.
            if target.parent != ROOT:
                continue
            source = LEGACY_ROOT / name
            if source.is_symlink() or not source.is_file():
                continue
            # Never over a file already at the new location. That one is what
            # the session has been reading, so the old one is the stale copy.
            if target.exists() or target.is_symlink():
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            os.replace(source, target)
        # Emptied by the moves, so nothing is left to keep it. Anything still in
        # there -- the defaults symlink, generated/, a file dropped by hand --
        # and rmdir refuses, which is exactly the wanted outcome: the directory
        # stays as it is rather than being cleared out.
        try:
            LEGACY_ROOT.rmdir()
        except OSError:
            pass


def migrate_preference_values(stored: dict) -> dict:
    """The value steps of the migration, in memory, on the raw stored file.

    Raw rather than merged on purpose. The corner radius rename reuses "normal"
    for what used to be called "small", so the value alone cannot say which scale
    wrote it -- only the absence of the version stamp can, and merging the
    defaults in first would supply one.

    Each step is gated on the version that introduced it rather than on "older
    than current". A single "not current yet" gate replays every step whenever
    the stamp is bumped, which is precisely how the corner radius walked from
    normal to large the first time a later version was added.

    v4 is not here: it moves files rather than values, so it has to run before
    the read. See migrate_config_root(). v5 is not here either: it changes the
    shape of the whole file rather than any value in it, and it rewrites the file
    to do so. See compact_preferences_file().
    """
    version = schema_version(stored)
    if version >= PREFERENCES_VERSION:
        return stored
    appearance = stored.get("appearance")
    if isinstance(appearance, dict):
        # v2 renamed the corner radius scale.
        if version < 2 and "corner_radius" in appearance:
            appearance["corner_radius"] = CORNER_RADIUS_RENAMES.get(
                str(appearance["corner_radius"]), appearance["corner_radius"])
        # v3 gave each appearance its own wallpaper. setdefault, not assignment:
        # a file written between the two schemas could already carry a half, and
        # a deliberate choice outranks the value it was split from.
        if version < 3:
            for legacy, suffix in WALLPAPER_SPLIT.items():
                if legacy in appearance:
                    value = appearance.pop(legacy)
                    for scheme in SCHEMES:
                        appearance.setdefault(f"wallpaper_{scheme}{suffix}", value)
    stored.setdefault("schema", {})["preferences_version"] = PREFERENCES_VERSION
    return stored


def compact_preferences_file(defaults: dict, sink: list[str] | None = None) -> dict | None:
    """v5: shrink a stored full document down to the departures it always meant.

    Every version up to 4 wrote preferences.toml as the whole merged
    configuration, so an install that ever changed one setting carries a frozen
    copy of all ~50 shipped defaults -- and that copy outranks layer 1 forever,
    which means no later change to any shipped default could ever reach the
    machine again, and a key withdrawn from the schema could never leave it.
    Rewriting the file the first time this build reads it is what un-fossilizes
    them. The effective configuration is untouched by the rewrite: a stored value
    that still differs from today's default is a departure and stays, and one
    that equals it is dropped only because the merge puts it straight back.

    Done here, at migration time, rather than being left to the next `set`: one
    atomic rewrite is a thing that can be tested and reasoned about, where "the
    file is wrong until the user happens to change a setting" is a second state
    the whole product would have to keep working in.

    Under PREFERENCES_LOCK, and re-reading the file inside it, because this runs
    on the *load* path: `set` and `glass.reset` hold that lock across their own
    read-modify-write, and a rewrite computed from a read taken before one of
    them ran would land after it and undo the setting it just wrote. Taken
    non-blocking, and skipped when it is held, because the load path may never
    wait on that lock -- `set lock.*` restarts hypridle while holding it, and
    hypridle's ExecStartPre re-enters this binary to render, so a blocking
    acquire here would deadlock that restart. Skipping is safe: whoever holds the
    lock is a writer, and every writer now emits departures only.

    Returns the compacted stored document so the caller's load continues from
    what was written rather than from what was read -- which is also what keeps a
    dropped unknown key from being reported a second time by a save later in the
    same process. None means nothing was rewritten and the caller should keep the
    document it already has.
    """
    # Nothing to shrink, and nothing to create: a fresh install has no layer 2
    # at all, and writing a stamp-only file here would both invent a user-owned
    # file from a read path and take the bootstrap's GPU gate -- which writes
    # preferences.toml only when it does not already exist -- out of play.
    if not PREFERENCES_PATH.exists():
        return None
    try:
        PREFERENCES_LOCK.parent.mkdir(parents=True, exist_ok=True)
        with PREFERENCES_LOCK.open("a+", encoding="utf-8") as lock:
            try:
                fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return None
            stored = migrate_preference_values(load_toml(PREFERENCES_PATH))
            document = preference_document(stored, defaults, sink)
            # Only when the rewrite would actually change something. A file that
            # is already departures-only -- the two keys the bootstrap's GPU gate
            # writes, or a hand-written file -- is left exactly as it is,
            # comments and all, because dump_toml() cannot carry a comment and
            # rewriting it would cost the user the explanation of why the value
            # is there. Its stamp then stays behind, and this step re-runs on
            # every load: a dict diff over ~50 keys, and no write.
            if preference_sections(document) != preference_sections(stored):
                atomic_write(PREFERENCES_PATH, dump_toml(document))
                return document
            return None
    except OSError:
        # A read-only config directory, or a lock file that cannot be opened. The
        # load has to survive it: the effective configuration is correct either
        # way, and the file keeps its old shape until a write can happen.
        return None


def migrate_preferences(stored: dict, defaults: dict,
                        sink: list[str] | None = None) -> dict:
    """Bring a stored preferences.toml up to PREFERENCES_VERSION.

    Two kinds of step, gated on the same stamp: the value renames, which happen
    in memory and reach the file whenever it is next written, and v5, which
    rewrites the file itself.
    """
    version = schema_version(stored)
    if version >= PREFERENCES_VERSION:
        return stored
    stored = migrate_preference_values(stored)
    if version < 5:
        compacted = compact_preferences_file(defaults, sink)
        if compacted is not None:
            return compacted
    return stored


def load_preferences(sink: list[str] | None = None) -> dict:
    defaults = shipped_defaults()
    stored = migrate_preferences(load_toml(PREFERENCES_PATH), defaults, sink)
    return validate_preferences(deep_merge(defaults, stored), sink)


def toml_value(value: object) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if isinstance(value, float) and not math.isfinite(value):
            raise SettingsError("Non-finite numbers are not supported")
        return str(value).lower()
    raise SettingsError(f"Unsupported TOML value: {value!r}")


def dump_toml(data: dict) -> str:
    lines: list[str] = []
    for section, values in data.items():
        if not isinstance(values, dict):
            continue
        if lines:
            lines.append("")
        lines.append(f"[{section}]")
        for key, value in values.items():
            if not isinstance(value, (dict, list)):
                lines.append(f"{key} = {toml_value(value)}")
    return "\n".join(lines) + "\n"


def preference_sections(document: dict) -> dict:
    """A preferences document without its [schema] stamp.

    The stamp is bookkeeping, not a preference: it is written unconditionally and
    compared separately, so every comparison of "what does this file actually
    say" leaves it out.
    """
    return {name: values for name, values in document.items() if name != "schema"}


def same_default(value: object, default: object) -> bool:
    """Whether a stored value is the shipped default rather than a departure.

    `==` alone would be wrong in one direction and right in the other, so the two
    cases are split:

      * bool is a subclass of int, so True == 1 and False == 0. A stored `true`
        against a default of `1` is a different kind of value, not the same one,
        and dropping it would hand the renderers an int where the file said bool.
        So the bool-ness has to match.
      * 1 == 1.0, and there the numbers really are the same value. The schema
        ships pointer_sensitivity as 0.0 and a UI that sends JSON `0` stores an
        int; treating that as a departure would pin a copy of the default in
        layer 2 forever over nothing but a decimal point. Layer 1 owns the type
        as well as the value, so the int is dropped and the float comes back.
    """
    if isinstance(value, bool) != isinstance(default, bool):
        return False
    return value == default


def preference_deltas(stored: dict, defaults: dict,
                      dropped: list[str] | None = None, prefix: str = "") -> dict:
    """The parts of `stored` that depart from `defaults`, and nothing else.

    Recursive, and driven by `defaults` rather than by `stored`, which gives two
    things at once: the result comes out in the shipped file's own key order, and
    a key the schema does not have cannot reach the result at all. Those keys are
    appended to `dropped` instead -- a withdrawn setting, a typo in a hand edit,
    or a downgrade to a build that no longer has it. validate_preferences()
    already ignores them, so all they do is sit in the file looking meaningful.
    """
    deltas: dict = {}
    for key, default in defaults.items():
        if key not in stored:
            continue
        value = stored[key]
        if isinstance(default, dict) or isinstance(value, dict):
            if not (isinstance(default, dict) and isinstance(value, dict)):
                # A section where a value belongs, or the reverse. Nothing can be
                # done with it and merging it would corrupt the shape.
                if dropped is not None:
                    dropped.append(f"{prefix}{key}")
                continue
            nested = preference_deltas(value, default, dropped, f"{prefix}{key}.")
            if nested:
                deltas[key] = nested
        elif not same_default(value, default):
            deltas[key] = value
    if dropped is not None:
        dropped.extend(f"{prefix}{key}" for key in stored if key not in defaults)
    return deltas


def report_preference_notes(notes: list[str], sink: list[str] | None) -> None:
    """Where a note about the stored file goes.

    stderr, which is the journal under the units that render at session start, or
    `sink` when a caller needs to count the notes instead -- `garage doctor` has
    to report them, and reading its own stderr back is not something a process can
    do honestly.
    """
    if sink is None:
        for note in notes:
            print(f"garage: preferences.toml: {note}", file=sys.stderr)
    else:
        sink.extend(notes)


def preference_document(config: dict, defaults: dict,
                        sink: list[str] | None = None) -> dict:
    """Layer 2 as a document: the version stamp, then the departures from layer 1.

    Nothing else. The whole merged configuration used to be written here, and that
    is what put a frozen copy of all ~50 shipped defaults into the first file a
    fresh install ever wrote. From then on the shipped defaults were dead to that
    machine: every one of them was overridden by a copy of its own old value, so
    changing a default in a release could never reach an install that had ever
    touched a setting, and a key removed from the schema stayed in the file
    forever.

    The consequence to be deliberate about: a key whose value equals the shipped
    default is *absent* from the file, so setting a value back to the default
    erases the delta rather than pinning it. That is the intended meaning --
    "follow the shipped default again" -- under a schema whose defaults are
    expected to move. There is deliberately no way to pin today's default against
    a future change to it: layer 2 records what the user chose *differently*, and
    "the same as what shipped" is not a choice that outlives the shipping
    changing.

    The stamp is written rather than diffed. It equals the default by
    construction, so a diff would drop it, and a file with no [schema] section
    reads as version 1 -- which would replay every migration over it on the next
    load. Nothing else in [schema] is carried: it is this program's bookkeeping,
    not a place to keep settings.
    """
    dropped: list[str] = []
    document: dict = {"schema": {"preferences_version": PREFERENCES_VERSION}}
    document.update(preference_deltas(preference_sections(config),
                                      preference_sections(defaults), dropped))
    report_preference_notes(
        [f"{name} is not a preference this build has; dropping it" for name in dropped],
        sink)
    return document


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def save_preferences(config: dict, sink: list[str] | None = None) -> None:
    """Write layer 2 from an effective configuration.

    The one writer of preferences.toml, so the departures-only rule cannot be
    forgotten by a second one. `config` is what a load produced and a caller
    changed -- the merged, validated whole -- and what lands on disk is the
    difference between that and layer 1. Every caller holds PREFERENCES_LOCK
    across its own read-modify-write; nothing is locked here, because the read
    this is the write half of happened before the call.

    The merge base is read again rather than taken as an argument: the callers
    all loaded it a moment ago, but passing it through would make it possible for
    a future one to subtract something other than what it merged.
    """
    atomic_write(PREFERENCES_PATH, dump_toml(preference_document(
        config, shipped_defaults(), sink)))


def write_lua(path: Path, text: str) -> None:
    """Install a generated Lua fragment only once Lua agrees it parses.

    hyprland.lua dofile()s these. Hyprland syntax-checks hyprland.lua before it
    tears down the live config, but that check does not follow a dofile, so a
    malformed fragment is only discovered at reload -- by which point it is
    already on disk and every later session loads it again. luac finds it here,
    while the previous good fragment is still in place.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, candidate = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        # Missing luac is not a reason to refuse the setting: the check is a
        # safety net over generated output, not a dependency of the feature.
        if shutil.which("luac"):
            check = run(["luac", "-p", candidate])
            if check.returncode != 0:
                # luac reports "luac: <chunk>:<line>: ...", and the chunk is the
                # temporary name, elided from the middle once it is long enough.
                # Neither half means anything to whoever sees this.
                detail = (check.stderr or check.stdout).strip()
                raise SettingsError(f"{path.name}: generated Lua is invalid: "
                                    + re.sub(r"^luac: .*?:(\d+): ", r"line \1: ", detail))
    finally:
        try:
            os.unlink(candidate)
        except FileNotFoundError:
            pass
    atomic_write(path, text)


def write_marker(path: Path, text: str) -> None:
    """Write a small file in place, keeping its inode.

    atomic_write() renames a temporary over the target, which is correct for
    config files but invisible to an inotify watch registered on the original
    inode: the watcher follows the replaced file and never reports the change.
    Quickshell watches these markers, so they have to be truncated in place.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())


def in_number_range(value: object, minimum: float, maximum: float) -> bool:
    """Whether a stored number is one the renderers can actually use.

    Non-finite floats fail here rather than being range-checked. NaN compares
    False against both bounds, so the two-sided rejection this replaced let nan
    and inf straight through, and the int() conversions in the renderers then
    raised OverflowError -- which main() does not catch, so it reached the user as
    a traceback instead of a message.
    """
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return False
    if isinstance(value, float) and not math.isfinite(value):
        return False
    return minimum <= value <= maximum


def is_clock_time(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"(?:[01]\d|2[0-3]):[0-5]\d", value) is not None


def is_hex_color(value: object) -> bool:
    # Stored as a literal colour rather than a swatch name so the swatch set
    # lives in one place -- the UI -- and magick can be handed the value as is.
    return isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", value) is not None


def validate_preferences(config: dict, sink: list[str] | None = None) -> dict:
    """Put every preference at a value this build can render.

    Nothing here refuses the file. A single bad value used to raise, and that one
    raise took the whole product down with it: every render failed, so the bar,
    the wallpaper and the theme stopped updating, and the settings pane went
    read-only besides -- `set` loads before it writes, so the one screen that
    could have corrected the value would not open either. The value arrives from
    a hand edit, a restored backup, or a release that narrowed a range, and none
    of those are something to hand back to the user as a text-editor errand.

    So every key is coerced to what the product ships for it -- FALLBACK_DEFAULTS,
    which is preferences.defaults.toml -- and each substitution is reported on
    stderr, which is the journal under the units that render at session start.
    The coerced value reaches preferences.toml on the next save, so a bad value
    is corrected once rather than carried forever. wallpaper_fit, corner_radius
    and the locale already worked this way; the rest of the schema now does too.

    `sink`, when given, takes the notes instead of stderr. `garage doctor` has to
    count the coercions to report them, and reading its own stderr back is not
    something a process can do honestly -- it would also swallow the journal line
    every other caller depends on.

    Every branch this used to be written out as is now one entry in
    PREFERENCE_SCHEMA: the kind and its constraints say what a usable value is,
    `renames` carries a withdrawn spelling across silently, `also` holds the one
    condition that needs a second key, and `normalise` restates a value instead
    of checking it. The reason each constraint is what it is went into the table
    with it. Nothing here knows the name of any preference, which is the point --
    a key added to the table is validated by having been added.
    """
    notes: list[str] = []

    def keep(section: str, key: str, default: object, valid: bool) -> None:
        """Leave a usable value alone; put the shipped default over anything else."""
        if valid:
            return
        notes.append(f"{section}.{key} {config[section].get(key)!r} is not valid, "
                     f"using {default!r}")
        config[section][key] = default

    # Ahead of the pass, so a key whose section is missing entirely is coerced
    # rather than raising, and so `set` has somewhere to write.
    for section in VALIDATED_SECTIONS:
        config.setdefault(section, {})

    for dotted, entry in PREFERENCE_SCHEMA.items():
        kind = entry["kind"]
        if kind == "bookkeeping":
            continue
        section, key = dotted.split(".", 1)
        values = config[section]
        renames = entry.get("renames")
        # Withdrawn spellings, before the check and without a note: the same
        # choice under the name it had when it was made. Only a string can be a
        # spelling, and the isinstance is load-bearing rather than defensive: a
        # hand-edited file can carry a TOML array here, and an unhashable value
        # must reach the kind check that has always been the thing to refuse it.
        if renames and isinstance(values.get(key), str) and values[key] in renames:
            values[key] = renames[values[key]]
        normalise = entry.get("normalise")
        if normalise is not None:
            values[key] = normalise(values.get(key))
            continue
        value = values.get(key)
        valid = PREFERENCE_KINDS[kind](entry, value)
        also = entry.get("also")
        if valid and also is not None:
            valid = also(config, value)
        keep(section, key, entry["default"], valid)

    # Last rather than beside the keys that replaced them, because it is the one
    # step whose order cannot matter: no check above reads a withdrawn key, and
    # nothing below it does either.
    for section, withdrawn in WITHDRAWN_KEYS.items():
        for name in withdrawn:
            config[section].pop(name, None)

    # stderr rather than the snapshot: the pane has one channel for this, .error,
    # and it means "the command did nothing" -- putting a coercion there would
    # report a working desktop as a broken one. Nothing in the QML reads a
    # warnings field, so there is nothing to fill in, and the journal is where
    # the render units' output is looked for anyway.
    report_preference_notes(notes, sink)
    return config


# The two characters that end a Lua "..." literal early, plus the whitespace
# that Lua's lexer treats as a line break inside one. Everything else printable
# is safe to pass through verbatim.
LUA_ESCAPES = {
    "\\": "\\\\",
    '"': '\\"',
    "\n": "\\n",
    "\r": "\\r",
    "\t": "\\t",
}


def lua_string(value: str) -> str:
    """Quote a Python string as a Lua string literal.

    Not json.dumps: JSON and Lua only look alike. JSON's default \\uXXXX escape
    for non-ASCII is a syntax error in Lua, which spells the same thing
    \\u{XXXX}, and Lua rejects a raw newline inside a quoted literal where JSON
    never has one to reject. Non-ASCII is emitted as UTF-8 rather than escaped:
    the fragment is written UTF-8 and Lua takes string literals as bytes, so the
    two are the same string and the generated file stays readable.
    """
    out = ['"']
    for char in value:
        escape = LUA_ESCAPES.get(char)
        if escape is not None:
            out.append(escape)
        elif char < " " or char == "\x7f":
            # Braced so it cannot run into a following digit the way Lua's
            # decimal \\ddd escape can.
            out.append("\\u{%x}" % ord(char))
        else:
            out.append(char)
    out.append('"')
    return "".join(out)


def glass_options(config: dict) -> dict[str, str]:
    """The Kinetik Glass options the glass_* preferences drive, as Lua literals.

    Shared by the generated fragment and the live eval so the two cannot drift.
    The rest of the plugin's options are theme-derived, not slider-derived, so
    they stay in render_preferences() where the palette is resolved.
    """
    glass = config["appearance"]
    mode = str(glass["glass_mode"])
    # Frosted is not a separate code path: a bevel steepness of zero leaves the
    # surface flat, so the lateral shift is zero and the same shader produces
    # plain blur. Off leaves the plugin disabled, so eligible surfaces keep
    # Hyprland's own blur instead.
    # Only the bend is zeroed. Edge clarity and the rim light are computed
    # independently of the refraction vector in the shader, so they still read
    # correctly on a flat surface and give Frosted its own tunables rather than
    # leaving three sliders that silently do nothing.
    frosted = mode == "frosted"
    level = GLASS_BLUR_LEVELS[str(glass["glass_blur"])]
    return {
        "enabled": str(mode != "off").lower(),
        "edge_width": str(int(glass["glass_edge_width"])),
        "refraction": f'{0.0 if frosted else float(glass["glass_refraction"]):g}',
        "edge_clarity": f'{float(glass["glass_clarity"]):g}',
        "highlight_opacity": f'{float(glass["glass_highlight"]):g}',
        "blur_passes": str(level["passes"]),
        "blur_downscale": f'{level["downscale"]:g}',
    }


def material_decoration(config: dict) -> dict[str, str]:
    """The core decoration options the material drives, as Lua literals.

    Hyprland's own blur and the window opacity are separate code paths from the
    plugin, so disabling the plugin left both running: Off still blurred and
    still sat 4% see-through, which is the opposite of solid. They are driven
    from here instead. Fullscreen stays opaque either way -- there is nothing
    behind it worth showing through.
    """
    glass = config["appearance"]
    level = GLASS_BLUR_LEVELS[str(glass["glass_blur"])]
    solid = str(glass["glass_mode"]) == "off"
    opacity = 1.0 if solid else 1.0 - float(glass["glass_transparency"])
    return {
        "active_opacity": f"{opacity:g}",
        "inactive_opacity": f"{opacity:g}",
        "fullscreen_opacity": "1.0",
        "blur": (f'{{enabled = {str(not solid).lower()}, '
                 f'size = {level["size"]}, passes = {level["hypr_passes"]}}}'),
    }


def border_general(config: dict) -> str:
    """The general options the border size drives, as a Lua table body.

    The colour comes with the size rather than being a setting of its own:
    decorations.lua paints both borders fully transparent, so a size on its own
    would silently shrink the window and draw nothing. Theme-resolved, because
    the dark pair is invisible on a light desktop.
    """
    active, inactive = BORDER_COLORS[resolve_theme(config)]
    return (f'border_size = {int(config["appearance"]["border_size"])}, '
            f'col = {{active_border = "{active}", inactive_border = "{inactive}"}}')


def motion_lua(config: dict) -> str:
    """The animation statements the motion preferences drive.

    Shared by the generated fragment and the live eval so the two cannot drift,
    the same way glass_options() is.

    Reduce Motion switches animations off outright instead of shortening them.
    Only movement is left animated here -- a workspace slide, a layer slide --
    and a shorter slide is still a slide, which is the thing the setting exists
    to remove. Shortening is what the speed control already does, and Hyprland
    has one atomic switch for the rest, so nothing can end up half animated.
    """
    appearance = config["appearance"]
    enabled = not bool(appearance["reduce_motion"])
    # Hyprland's speed is a duration in deciseconds, so a faster desktop is a
    # smaller number: the multiplier divides the baseline rather than scaling it.
    factor = float(appearance["animation_speed"])
    lines = [f"hl.config({{animations = {{enabled = {str(enabled).lower()}}}}})"]
    # Emitted even while Reduce Motion is on: animations:enabled already covers
    # every leaf, and keeping the speeds current means switching it back off
    # restores the desktop without a second push.
    for leaf, base in ANIMATION_LEAVES.items():
        fields = [f"leaf = {lua_string(leaf)}", "enabled = true",
                  f'speed = {float(base["speed"]) / factor:g}',
                  f'bezier = {lua_string(base["bezier"])}']
        if "style" in base:
            fields.append(f'style = {lua_string(base["style"])}')
        lines.append("hl.animation({ %s })" % ", ".join(fields))
    return "\n".join(lines) + "\n"


def lua_pairs(options: dict[str, str], separator: str = ", ") -> str:
    return separator.join(f"{key} = {value}" for key, value in options.items())


def corner_rounding(config: dict) -> int:
    """The rounding in px every rounded surface on the desktop is sized from.

    Windows and layer surfaces are separate code paths: a window takes
    Hyprland's own decoration:rounding, Kinetik Glass rounds the layers it
    decorates from its plugin options, hyprexpo its overview tiles, and the
    shell draws its own silhouettes in QML. All of them have to be handed this
    one number or the corners visibly disagree.
    """
    return CORNER_RADII[str(config["appearance"]["corner_radius"])]


def render_preferences(config: dict) -> None:
    GENERATED.mkdir(parents=True, exist_ok=True)
    # Published here as well as from apply_glass so the marker exists before the
    # shell first reads it, the same way the corner radius is handled.
    write_marker(MATERIAL_FILE, str(config["appearance"]["glass_mode"]) + "\n")
    inputs = config["input"]
    lua = f'''-- Generated by garage. Edit preferences.toml instead.
hl.config({{
    input = {{
        sensitivity = {float(inputs["pointer_sensitivity"]):g},
        accel_profile = {lua_string(inputs["accel_profile"])},
        natural_scroll = {str(bool(inputs["natural_scroll"])).lower()},
        kb_layout = {lua_string(inputs["keyboard_layout"])},
        repeat_rate = {int(inputs["repeat_rate"])},
        repeat_delay = {int(inputs["repeat_delay"])},
        touchpad = {{
            tap_to_click = {str(bool(inputs["touchpad_tap_to_click"])).lower()},
            natural_scroll = {str(bool(inputs["touchpad_natural_scroll"])).lower()},
            disable_while_typing = {str(bool(inputs["touchpad_disable_while_typing"])).lower()},
        }},
    }},
}})
'''

    # Loaded after config/decorations.lua, so these win over the static defaults
    # there. Guarded because setting plugin keywords for a plugin that failed to
    # load is a config error.
    # Theme-dependent decoration. The glass values matter here as much as the
    # colours: the rings are a white inner highlight over a dark outer border,
    # which inverts on a light desktop, and a near-black tint would darken it.
    scheme = resolve_theme(config)
    rounding = corner_rounding(config)
    group_active, group_inactive = BORDER_COLORS[scheme]
    if scheme == "light":
        # Reference light surfaces are near-opaque: a flat #f6f6f6 body with only
        # a hint of the desktop at the edges. Translucency at 0.5 over a saturated
        # wallpaper gives a milky coloured wash instead, and it wrecks text
        # contrast. The refraction still reads on the bevel, which is where the
        # material belongs on light.
        tint, tint_opacity = "rgba(ffffffff)", 0.20
        saturation = 0.5
        frame_highlight, frame_border = 0.10, 0.05
        dispersion = 0.0
        shadow, shadow_inactive = "rgba(00000026)", "rgba(00000014)"
        group_locked = "rgba(8e8e93ff)"
        dim_strength = 0.08
    else:
        # Mirrors the light material so the two themes behave identically: same
        # tint strength, same desaturation, same frame weights, no dispersion.
        # Only the tint colour and the shadow differ, which is the part that is
        # genuinely theme-specific.
        tint, tint_opacity = "rgba(1c1c1eff)", 0.20
        saturation = 0.5
        frame_highlight, frame_border = 0.10, 0.05
        dispersion = 0.0
        shadow, shadow_inactive = "rgba(00000066)", "rgba(00000040)"
        group_locked = "rgba(888888ff)"
        dim_strength = 0.08

    lua += f'''
hl.config({{
    general = {{ {border_general(config)} }},
    group = {{
        col = {{
            border_active = "{group_active}",
            border_inactive = "{group_inactive}",
            border_locked_active = "{group_locked}",
            border_locked_inactive = "{group_inactive}",
        }},
        groupbar = {{
            col = {{
                active = "{group_active}",
                inactive = "{group_inactive}",
                locked_active = "{group_locked}",
                locked_inactive = "{group_inactive}",
            }},
        }},
    }},
    decoration = {{
        dim_strength = {dim_strength:g},
        rounding = {rounding},
        rounding_power = {CORNER_POWER:g},
        {lua_pairs(material_decoration(config), ",\n        ")},
        shadow = {{
            color = "{shadow}",
            color_inactive = "{shadow_inactive}",
        }},
    }},
}})
'''

    # Emitted straight from glass_options() rather than key by key: spelling the
    # names out here once let a new option reach the live eval and miss the
    # fragment, so it survived until the next reload and no further.
    options = lua_pairs(glass_options(config), ",\n                ")
    lua += f'''
if GLASS_AVAILABLE then
    hl.config({{
        plugin = {{
            kinetik_glass = {{
                {options},
                layer_rounding = {rounding},
                corner_power = {CORNER_POWER:g},
                tint = "{tint}",
                tint_opacity = {tint_opacity:g},
                frame_highlight_opacity = {frame_highlight:g},
                frame_border_opacity = {frame_border:g},
                dispersion = {dispersion:g},
                saturation = {saturation:g},
            }},
        }},
    }})
end

if HYPREXPO_AVAILABLE then
    hl.config({{
        plugin = {{
            hyprexpo = {{
                tile_rounding = {rounding},
                tile_rounding_power = {CORNER_POWER:g},
            }},
        }},
    }})
end
'''
    lua += "\n" + motion_lua(config)
    write_lua(HYPRLAND_FRAGMENT, lua)
    render_idle(config)


def render_idle(config: dict) -> None:
    """Write hypridle.conf from the lock preferences, and nothing else.

    Its own function because it is its own entry point: `garage render-idle` is
    hypridle.service's ExecStartPre, and hypridle reads exactly this one file --
    the generated config names no include and sources nothing, so there is
    nothing else for that unit to need. Narrow on purpose. It used to run the
    full render there, which meant restarting hypridle to pick up a new lock
    timeout also re-themed every toolkit, reloaded the compositor and pushed
    gsettings, from inside the `set lock.*` that asked for the restart.

    Nothing here takes PREFERENCES_LOCK, and nothing here may ever be made to.
    `set lock.*` holds that lock across a *synchronous* `systemctl restart
    hypridle.service`, whose ExecStartPre re-enters this binary and runs this
    function: waiting on the lock here would deadlock the setting against
    itself.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    lock = config["lock"]
    listeners: list[str] = []
    if int(lock["lock_timeout"]) > 0:
        listeners.append(f'''listener {{
    timeout = {int(lock["lock_timeout"])}
    on-timeout = loginctl lock-session
}}''')
    if int(lock["display_off_timeout"]) > 0:
        listeners.append(f'''listener {{
    timeout = {int(lock["display_off_timeout"])}
    on-timeout = hyprctl dispatch dpms off
    on-resume = hyprctl dispatch dpms on
}}''')
    if int(lock["suspend_timeout"]) > 0:
        listeners.append(f'''listener {{
    timeout = {int(lock["suspend_timeout"])}
    on-timeout = systemctl suspend
}}''')
    idle = '''# Generated by garage. Edit preferences.toml instead.
general {
    lock_cmd = pidof hyprlock || ~/.config/hypr/scripts/garage-lock-session
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch dpms on
}

''' + "\n\n".join(listeners) + "\n"
    atomic_write(HYPRIDLE_CONFIG, idle)


def render_accent(config: dict) -> None:
    """Publish the accent for the shell to read. The file half of apply_accent."""
    write_marker(ACCENT_FILE, str(config["appearance"]["accent_color"]) + "\n")


def push_accent(config: dict) -> None:
    """Push the accent into GNOME's interface settings. The world half."""
    accent = str(config["appearance"]["accent_color"])
    schema = run(["gsettings", "range", "org.gnome.desktop.interface", "accent-color"])
    if schema.returncode == 0 and f"'{accent}'" in schema.stdout:
        run(["gsettings", "set", "org.gnome.desktop.interface", "accent-color", accent])


def apply_accent(config: dict) -> None:
    render_accent(config)
    push_accent(config)


def load_display_config() -> dict:
    raw = load_toml(DISPLAYS_PATH)
    displays = raw.get("display", [])
    if not isinstance(displays, list):
        raise SettingsError("displays.toml: display must be an array of tables")
    return {"primary": str(raw.get("primary", "")), "displays": displays}


def mirror_targets(displays: list[dict], *, strict: bool = False) -> dict[str, str]:
    """The source each display mirrors, for the mirrors Hyprland will honour.

    Hyprland's setMirror refuses to mirror the display itself or another mirror,
    and a disabled output has nothing to copy. It logs and ignores the rule in
    those cases, so the layout on screen would quietly stop matching the one
    that was saved.

    Strict is for the apply path, which has to reject those combinations rather
    than emit them. render_displays() stays lenient because it also runs at
    session start from a possibly hand-edited displays.toml, and refusing the
    whole fragment there would drop every monitor rule, not just the bad one.
    """
    enabled = {str(item.get("output", "")): str(item.get("mirror") or "")
               for item in displays if item.get("enabled", True)}
    targets: dict[str, str] = {}
    for output, source in enabled.items():
        if not source:
            continue
        problem = ("cannot mirror itself" if source == output
                   else f"cannot mirror {source}: that display is turned off"
                   if source not in enabled
                   else f"cannot mirror {source}: that display is itself a mirror"
                   if enabled[source] else "")
        if not problem:
            targets[output] = source
        elif strict:
            raise SettingsError(f"{output} {problem}")
    return targets


def render_displays(layout: dict) -> None:
    GENERATED.mkdir(parents=True, exist_ok=True)
    primary = str(layout.get("primary", ""))
    displays = layout.get("displays", [])
    mirrors = mirror_targets(displays)
    lines = ["-- Generated by garage. Edit displays.toml instead."]
    if primary:
        lines.append(f"PRIMARY_MONITOR = {lua_string(primary)}")
    # Sources ahead of the mirrors that name them. Hyprland collects every rule
    # and applies them once the config has parsed -- verified by generating the
    # mirror line first, which mirrored just the same -- so this is for whoever
    # reads the fragment, not for the compositor.
    for item in sorted(displays, key=lambda entry: str(entry.get("output", "")) in mirrors):
        output = lua_string(str(item.get("output", "")))
        if not item.get("enabled", True):
            lines.append(f"hl.monitor({{ output = {output}, disabled = true }})")
            continue
        mode = lua_string(str(item.get("mode", "preferred")))
        scale = lua_string(f'{float(item.get("scale", 1)):g}')
        transform = int(item.get("transform", 0))
        # A mirror has no place of its own: Hyprland drops it out of the monitor
        # layout and pins it onto its source, so a position would only be a
        # stale coordinate fighting that. The one it keeps in displays.toml is
        # where it goes back to when the mirror is turned off.
        source = mirrors.get(str(item.get("output", "")), "")
        placement = (f"mirror = {lua_string(source)}" if source else
                     "position = " + lua_string(f'{int(item.get("x", 0))}x{int(item.get("y", 0))}'))
        # Clamped rather than validated: Hyprland only accepts -1..3 and rejects
        # the whole rule otherwise, and this also runs at session start from a
        # possibly hand-edited displays.toml, where refusing one monitor's vrr
        # would take every monitor rule down with it. -1 inherits misc:vrr.
        vrr = max(-1, min(3, int(item.get("vrr", -1))))
        lines.append(
            "hl.monitor({ output = %s, mode = %s, %s, scale = %s, transform = %d, vrr = %d })"
            % (output, mode, placement, scale, transform, vrr)
        )
    write_lua(DISPLAY_FRAGMENT, "\n".join(lines) + "\n")


def parse_workspace_counts(value: object) -> dict[str, int]:
    """The per-output workspace counts encoded in workspaces.counts.

    Lenient in the same way the locale coercion is: this is the one preference a
    human is at all likely to hand-edit, and one bad entry must not make the file
    unloadable and the whole UI read-only with no way to correct it from inside.
    An entry that does not parse is dropped; a count outside the range is clamped
    into it rather than dropped, because the output it names is still wanted.
    """
    counts: dict[str, int] = {}
    for entry in str(value or "").split(","):
        output, separator, size = entry.partition("=")
        output, size = output.strip(), size.strip()
        if not separator or not output or not size.isdigit():
            continue
        counts[output] = max(1, min(WORKSPACE_COUNT_MAX, int(size)))
    return counts


def format_workspace_counts(counts: dict[str, int]) -> str:
    return ",".join(f"{output}={size}" for output, size in counts.items())


def workspace_outputs() -> list[str]:
    """The displays that own a workspace range, in allocation order.

    The saved layout leads, not the live monitor list. DisplayPort drops the
    connector when a display sleeps, so `hyprctl monitors` stops reporting it --
    and deriving the plan from that would renumber every range and strand the
    windows on the ranges that disappeared, every time a screen powered down.
    displays.toml records which displays the user configured, which is what the
    plan should follow; a disabled or mirrored one still owns nothing.

    Pinning a range to a display that is momentarily absent is the milder
    failure: Hyprland parks those workspaces on another output and hands them
    back on reconnect, windows intact.

    Live monitors are folded in on top so a display the saved layout has never
    seen still gets a range, and are the sole source if the layout cannot be
    read at all.

    The primary comes first and the rest sort by connector name, which is stable
    across sessions and needs nothing remembered to reproduce. Not by position:
    dragging a display around in the Displays pane would otherwise renumber every
    workspace on the desktop.
    """
    names: list[str] = []
    try:
        saved = load_display_config()
    except SettingsError:
        saved = None
    if saved:
        mirrors = mirror_targets(saved["displays"])
        names = [str(item.get("output", "")) for item in saved["displays"]
                 if item.get("enabled", True) and str(item.get("output", "")) not in mirrors]
    # A monitor the saved layout predates. Appending rather than replacing keeps
    # the existing ranges stable when something new is plugged in.
    for name in monitor_names():
        if name not in names:
            names.append(name)
    primary = ""
    try:
        primary = load_display_config()["primary"]
    except SettingsError:
        pass
    primary = primary or os.environ.get("HYPR_PRIMARY_MONITOR", "")
    ordered = sorted(name for name in names if name)
    if primary in ordered:
        ordered.remove(primary)
        ordered.insert(0, primary)
    return ordered


def load_workspace_blocks() -> dict[str, int]:
    """The block each display has already been given, by connector.

    Lenient in the same way parse_workspace_counts() is, and for a stronger
    reason: an unreadable entry here would otherwise take the workspace plan --
    and with it the number keys -- down with it. A bad entry is dropped, and the
    display it named is simply given a block again.
    """
    stored = load_toml(WORKSPACE_BLOCKS_PATH).get("block", {})
    if not isinstance(stored, dict):
        return {}
    return {str(output): int(index) for output, index in stored.items()
            if isinstance(index, int) and not isinstance(index, bool) and index >= 0}


def save_workspace_blocks(blocks: dict[str, int]) -> None:
    lines = ["# Generated by garage. Which block of workspace ids each",
             "# display owns; a display keeps its block for as long as this file says so.",
             "[block]"]
    lines += [f"{toml_value(output)} = {index}"
              for output, index in sorted(blocks.items(), key=lambda item: item[1])]
    atomic_write(WORKSPACE_BLOCKS_PATH, "\n".join(lines) + "\n")


def workspace_blocks(outputs: list[str]) -> dict[str, int]:
    """The block index each display owns, remembered rather than recomputed.

    Deriving it from a display's position in the ordering would leave the bug one
    step away: unplugging the second of three displays would slide the third down
    a block and take its windows with it -- the same renumbering, triggered by a
    cable rather than by a count. So a display keeps its block for as long as this
    file remembers it, and one seen for the first time takes the lowest block
    nothing else holds. Adding a display therefore never disturbs an existing one.

    Nothing is ever reclaimed. A display unplugged in the morning and plugged back
    in at night finds its workspaces where it left them, which is worth more than
    keeping the numbers small -- and reclaiming would eventually hand a returning
    display's block to a newcomer, which is precisely the collision being avoided.

    Keyed by connector, as the counts and the workspace rules already are. Moving
    a display to another port renames it, and it then starts again with a block of
    its own; displays.toml carries a description that would survive that, but one
    identity for a display beats a second one only this file would understand.
    """
    blocks = load_workspace_blocks()
    taken = set(blocks.values())
    fresh = [output for output in outputs if output not in blocks]
    for output in fresh:
        index = 0
        while index in taken:
            index += 1
        blocks[output] = index
        taken.add(index)
    if fresh:
        save_workspace_blocks(blocks)
    return blocks


def per_display_groups(config: dict) -> list[dict]:
    """Which workspace IDs each attached display owns.

    Every display owns a block of WORKSPACE_BLOCK ids -- 1-10, 11-20, 21-30 --
    and its count decides how many slots at the front of that block are
    persistent. So 8/4/4 is 1-8, 11-14, 21-24, and lowering the first display to
    6 is 1-6 with the other two untouched. The block is as wide as the count may
    ever be, which is what makes it a fixed allocation rather than a reservation
    that could run out: a display cannot ask for an eleventh workspace, because
    there is no eleventh number key to reach it with.

    Packing the ranges instead, each display starting where the previous one
    stopped, made every id downstream of every count before it. Hyprland ids are
    global and a window lives on the id, so renumbering a range dragged its
    windows onto another monitor: changing one display's count visibly rearranged
    the whole desktop. Gaps in the numbering cost nothing next to that -- no key
    and no navigation path addresses a global id, and an id in a gap is simply a
    workspace that does not exist.
    """
    workspaces = config["workspaces"]
    counts = parse_workspace_counts(workspaces["counts"])
    default = int(workspaces["default_count"])
    outputs = workspace_outputs()
    blocks = workspace_blocks(outputs)
    return [{"monitor": output,
             "first": blocks[output] * WORKSPACE_BLOCK + 1,
             "count": counts.get(output, default)}
            for output in outputs]


def workspace_plan(config: dict) -> dict:
    if str(config["workspaces"]["mode"]) == "shared":
        # One unpinned group. Its monitor is empty, which is what tells the Lua
        # side to leave `monitor` off the rule and to address workspaces by id.
        return {"mode": "shared",
                "groups": [{"monitor": "", "first": 1,
                            "count": int(config["workspaces"]["shared_count"])}]}
    return {"mode": "per-display", "groups": per_display_groups(config)}


def render_workspaces(config: dict) -> None:
    """Publish the plan for config.variables to read.

    Not loaded from hyprland.lua's override block like the other two fragments:
    config.binds is required before that block runs and has to build its
    per-slot binds from the same plan the workspace rules use, so config.variables
    -- which is required before binds -- picks it up instead.
    """
    plan = workspace_plan(config)
    if not plan["groups"]:
        # Nothing detected and nothing saved. Leaving the fragment behind would
        # pin workspaces to connectors that may no longer exist; removing it
        # falls back to the plan tracked in variables.lua, which always has one.
        WORKSPACES_FRAGMENT.unlink(missing_ok=True)
        return
    lines = ["-- Generated by garage. Edit preferences.toml instead.",
             "WORKSPACE_PLAN = {",
             f"    mode = {lua_string(plan['mode'])},",
             "    groups = {"]
    for group in plan["groups"]:
        lines.append("        { monitor = %s, first = %d, count = %d },"
                     % (lua_string(group["monitor"]), group["first"], group["count"]))
    lines += ["    },", "}"]
    write_lua(WORKSPACES_FRAGMENT, "\n".join(lines) + "\n")


def render_bar_workspaces(config: dict) -> None:
    """Publish the bar's left side, with or without the workspace indicator.

    A fragment of its own rather than more of waybar-clock.jsonc: that one is
    written by render_region on a region change and this one by a workspaces
    change, and sharing a file would make each writer responsible for
    reproducing the other's content or silently drop it.

    Only modules-left is published. `persistent-workspaces` used to be spelled
    out in config.jsonc, monitor by monitor, as a second copy of the workspace
    plan; waybar 0.15 already loads persistent workspaces from Hyprland's own
    workspace rules -- which this generates -- so the copy is gone rather than
    generated, and the bar follows a count change with nothing to keep in step.

    Written unconditionally, even with no plan at all: config.jsonc no longer
    names modules-left, so an absent fragment is an empty left side rather than
    a wrong one.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    modules = list(WAYBAR_MODULES_LEFT)
    if config["workspaces"]["indicator"]:
        modules.append(WAYBAR_WORKSPACE_MODULE)
    atomic_write(WAYBAR_WORKSPACES,
                 json.dumps({"modules-left": modules}, indent=2) + "\n")


def reload_bar() -> None:
    # waybar's default SIGUSR2 action is a full reload, which re-reads the
    # config and every file it includes. The bar is already signalled this way
    # on a theme change, so this is the route it already survives.
    run(["pkill", "-USR2", "-x", "waybar"])


def block_of(workspace: int) -> int:
    """Which display's block an id falls in.

    The whole point of fixed blocks: the id alone says who owns it, with no
    reference to where the workspace happens to be sitting. That matters while a
    display sleeps -- DisplayPort drops the connector and Hyprland parks its
    workspaces on another output -- and asking the compositor would answer with
    whichever screen is holding them.
    """
    return (workspace - 1) // WORKSPACE_BLOCK


def surviving_slots(plan: dict) -> tuple[set[int], dict[int, int]]:
    """The ids the plan keeps, and where each block's strays are sent.

    One reader for both because they are the same question asked twice: what a
    display still owns, and which of those a window goes to when the slot it was
    on is gone. The last slot, not the first: it is the end of the row that
    shrinks, so that is where the arrangement was interrupted.
    """
    keep = {group["first"] + offset
            for group in plan["groups"] for offset in range(group["count"])}
    last = {block_of(group["first"]): group["first"] + group["count"] - 1
            for group in plan["groups"]}
    return keep, last


def windows_by_workspace() -> list[tuple[str, int]]:
    """Every ordinary window as (address, workspace id).

    Special workspaces carry negative ids and belong to no block, so the
    scratchpad is dropped here rather than guarded against at each caller: no
    count change may disturb it.
    """
    placed: list[tuple[str, int]] = []
    for client in json_command(["hyprctl", "clients", "-j"], []) or []:
        if not isinstance(client, dict):
            continue
        workspace = client.get("workspace", {})
        if not isinstance(workspace, dict) or int(workspace.get("id", 0)) <= 0:
            continue
        address = str(client.get("address", ""))
        if address:
            placed.append((address, int(workspace["id"])))
    return placed


def move_window(address: str, workspace: int) -> None:
    # follow = false is movetoworkspacesilent: these are salvage moves, not the
    # user asking to go somewhere, so the focus stays where they left it.
    run(["hyprctl", "eval", "hl.dispatch(hl.dsp.window.move({ workspace = %s, "
         "follow = false, window = %s }))"
         % (lua_string(str(workspace)), lua_string(f"address:{address}"))])


def installed_workspace_groups() -> list[dict]:
    """The groups the fragment now on disk hands out.

    Read back rather than recomputed, because it is the only record of the plan
    the compositor is still running -- which is to say, of the ids the windows
    are currently sitting on. Scraped with a pattern rather than executed: this
    is generated Lua being read by the process that writes it, and running it
    would be a second language in the loop for three integers.

    Anything unreadable comes back empty, which makes the remap below a no-op. A
    plan that cannot be compared is one nothing should be moved on.
    """
    try:
        text = WORKSPACES_FRAGMENT.read_text(encoding="utf-8")
    except OSError:
        return []
    if 'mode = "per-display"' not in text:
        # Shared pins nothing, so there is no display-owned id to map from.
        return []
    return [{"monitor": monitor, "first": int(first), "count": int(count)}
            for monitor, first, count in INSTALLED_GROUP.findall(text)]


def remap_workspaces(plan: dict) -> dict[int, int]:
    """Carry a display's windows across when its block of ids moves.

    A block is fixed against the counts but not against the ordering it is
    indexed by, so it does move on the rare occasions that ordering changes: a
    display added to or dropped from the saved layout, and once when the
    allocation itself changed from packed ranges to fixed blocks. Without this
    the ids under a window would be handed to another display and the window
    would travel with them -- the very thing blocks exist to stop.

    Slot by slot within the one display, so the arrangement survives intact: its
    nth workspace stays its nth. Every slot the old plan allocated is mapped,
    including ones past the new count, because a stale id left inside another
    display's new block would be reaped to that display; sending it into its own
    block first is what keeps the reap below honest.

    Addressed by window rather than by workspace because the old and new blocks
    overlap. Moving workspace by workspace would sweep the windows just moved
    into one along with the ones that were already there.

    Returns the mapping so the focus can be made to follow it too.
    """
    if plan["mode"] != "per-display":
        return {}
    previous = {group["monitor"]: group for group in installed_workspace_groups()}
    moves: dict[int, int] = {}
    for group in plan["groups"]:
        was = previous.get(group["monitor"])
        if was is None or was["first"] == group["first"]:
            continue
        for offset in range(was["count"]):
            moves[was["first"] + offset] = group["first"] + offset
    if moves:
        for address, workspace in windows_by_workspace():
            target = moves.get(workspace)
            if target is not None:
                move_window(address, target)
    return moves


def reap_stranded_windows(plan: dict) -> None:
    """Rehome windows left on a workspace the new plan no longer keeps.

    Hyprland does not destroy a workspace that still has windows, so lowering a
    count leaves the surplus ones alive but off the number keys and out of the
    monitor's cycle only once they are empty. Rather than leave that to be
    discovered later, each window on one is moved to the last slot its own
    display still keeps.

    Which display that is comes from the id's block, not from the compositor.
    Reading it back from `hyprctl workspaces` was wrong in exactly one case, and
    it is a case this machine hits: while a display sleeps its workspaces are
    parked on another output, so a count change made during the nap reported the
    sleeping display's windows as belonging to whichever screen was holding them
    and moved them there for good.

    Runs before the reload that installs the new rules. Afterwards the surplus
    workspaces are empty, which is the one state Hyprland does clean up.

    Shared mode is a no-op, which is the right answer for it: nothing is pinned,
    so a window outside the pool is on no display's surplus. Its workspace keeps
    existing because it has windows in it, and the adjacent workspace binds still
    reach it -- only the number keys stop at the pool.
    """
    if plan["mode"] != "per-display":
        return
    keep, last = surviving_slots(plan)
    if not keep:
        return
    for address, workspace in windows_by_workspace():
        if workspace in keep:
            continue
        target = last.get(block_of(workspace))
        # An id in no display's block belongs to no display, and any target for
        # it would be a guess at somebody else's monitor.
        if target is not None:
            move_window(address, target)


def active_workspaces() -> dict[str, int]:
    """What each display is showing, by connector."""
    showing: dict[str, int] = {}
    for monitor in json_command(["hyprctl", "monitors", "-j"], []) or []:
        if not isinstance(monitor, dict):
            continue
        active = monitor.get("activeWorkspace", {})
        current = int(active.get("id", 0)) if isinstance(active, dict) else 0
        if current > 0:
            showing[str(monitor.get("name", ""))] = current
    return showing


def restore_active_workspaces(plan: dict, moves: dict[int, int],
                              showing: dict[str, int]) -> None:
    """Put every display back on the workspace it was showing.

    Changing a count should not change what is on screen, and three things
    conspire to change it anyway. A dropped slot leaves a display on a workspace
    that is about to stop existing -- Hyprland collects an emptied workspace
    unless it is the one on screen, so it lingers with no rule, no number key and
    none of its windows. A remapped slot takes its windows to a new id and leaves
    the display on the old, empty one. And when the reload hands an id to another
    display, Hyprland re-homes that whole workspace, leaving the display it left
    with no active workspace at all and free to pick whichever of its own it likes.

    So each display is sent back to what it was showing, translated through the
    same remap its windows took, and falling back to the last slot it kept -- where
    the reap sent them -- when that workspace is gone for good.

    Runs after the reload, when every surviving slot exists on its own display
    again; switching to one beforehand could create it on the wrong screen. The
    target is chosen per monitor rather than from the id's block, because a
    display can only be showing a workspace while it is awake, so the connector it
    reports is unambiguous -- and unlike the block, it is still right for an id
    that predates the current allocation. Switching a workspace also focuses the
    monitor it is pinned to, so the display that had the focus is given it back.
    """
    if plan["mode"] != "per-display":
        return
    keep, _ = surviving_slots(plan)
    if not keep:
        return
    last = {group["monitor"]: group["first"] + group["count"] - 1
            for group in plan["groups"]}
    focused, targets = "", []
    for monitor in json_command(["hyprctl", "monitors", "-j"], []) or []:
        if not isinstance(monitor, dict):
            continue
        name = str(monitor.get("name", ""))
        if monitor.get("focused"):
            focused = name
        active = monitor.get("activeWorkspace", {})
        current = int(active.get("id", 0)) if isinstance(active, dict) else 0
        # A display that arrived while this was running was showing nothing to
        # restore, so whatever it is on now is what it wanted.
        previous = showing.get(name, current)
        target = moves.get(previous, previous)
        if target not in keep:
            target = last.get(name)
        if target is not None and target != current:
            targets.append(target)
    for target in targets:
        run(["hyprctl", "eval",
             "hl.dispatch(hl.dsp.focus({ workspace = %s }))" % lua_string(str(target))])
    if targets and focused:
        run(["hyprctl", "eval",
             "hl.dispatch(hl.dsp.focus({ monitor = %s }))" % lua_string(focused)])


def parse_combination(value: object) -> tuple[list[str], str]:
    """Split a Hyprland bind string into its modifiers and its key.

    Splitting on "+" is safe because the key that character stands for is spelled
    "plus" in every keysym table; a bare one is an empty part, which is refused.
    """
    if not isinstance(value, str) or not value.strip():
        raise SettingsError("A shortcut needs a key")
    parts = [part.strip() for part in value.split("+")]
    if any(not part for part in parts):
        raise SettingsError(f"{value.strip()} is not a shortcut Hyprland understands")
    modifiers: list[str] = []
    for part in parts[:-1]:
        name = KEY_MODIFIER_ALIASES.get(part.upper(), part.upper())
        if name not in KEY_MODIFIERS:
            raise SettingsError(f"{part} is not a modifier key")
        if name not in modifiers:
            modifiers.append(name)
    if not KEY_NAME.fullmatch(parts[-1]):
        raise SettingsError(f"{parts[-1]} is not a key name Hyprland understands")
    return modifiers, parts[-1]


def canonical_key(key: object) -> str:
    """A key half spelled the way the pane's own list spells it.

    Case is the writer's taste here exactly as it is for the modifiers: the
    compositor matches keysyms case-insensitively, so "a" and "A" are one key and
    storing whichever arrived left the Keyboard pane showing one shortcut two
    ways. Not str.upper(), which would invent "MINUS" and "PAGE_UP" -- the
    spelling adopted is KEY_CHOICES', looked up case-insensitively, and a key the
    list does not offer keeps the spelling it came with.
    """
    text = str(key)
    return KEY_CANONICAL.get(text.lower(), text)


def canonical_combination(value: object) -> str:
    modifiers, key = parse_combination(value)
    return " + ".join([name for name in KEY_MODIFIER_ORDER if name in modifiers]
                      + [canonical_key(key)])


def combination_id(value: object) -> str:
    """The id a bind is known by: its default combination, normalised.

    Must agree exactly with bind_id() in config/binds.lua, which is the side that
    hands the ids out. It is also what hl.unbind matches on.
    """
    return re.sub(r"\s+", "", str(value)).lower()


def combination_signature(value: object) -> tuple[frozenset, str]:
    """What the compositor actually matches on, for telling two binds apart.

    Order and case are the writer's taste, not the compositor's: modifiers reach
    Hyprland as a mask. So SUPER+SHIFT+A and shift + super + a are one shortcut,
    and a set holding both would fire both handlers off a single press.
    """
    modifiers, key = parse_combination(value)
    return frozenset(modifiers), key.lower()


def require_bindable(value: object) -> str:
    """A combination the user may take over, canonically spelled."""
    modifiers, key = parse_combination(value)
    # Against the canonical spelling, not the one that arrived: what is stored
    # and handed to the compositor is the canonical form, so checking anything
    # else would refuse "f5" while allowing the "F5" it normalises to.
    if not modifiers and not KEY_STANDALONE.fullmatch(canonical_key(key)):
        raise SettingsError(
            f"{key} on its own would be swallowed everywhere; add SUPER, CONTROL, ALT or SHIFT")
    return canonical_combination(value)


def custom_keybind(payload: dict, identifier: str = "") -> dict:
    """One user-defined shortcut, checked and normalised.

    The command is never inspected beyond its length and its characters. It is a
    shell command line, which is the whole feature -- hl.dsp.exec_cmd hands it to
    /bin/sh -- and it reaches the compositor as data, so there is nothing here it
    could break out of.
    """
    keys = require_bindable(payload.get("keys"))
    command = str(payload.get("command") or "").strip()
    description = str(payload.get("description") or "").strip()
    if not command:
        raise SettingsError("A custom shortcut needs a command to run")
    for name, text in (("keys", keys), ("description", description), ("command", command)):
        if len(text) > KEYBIND_LIMITS[name]:
            raise SettingsError(f"The {name} is longer than {KEYBIND_LIMITS[name]} characters")
        if KEYBIND_CONTROL.search(text):
            raise SettingsError(f"The {name} contains a control character")
    return {"id": str(identifier) or uuid.uuid4().hex[:12], "keys": keys,
            "description": description, "command": command}


def load_keybindings() -> dict:
    """The user's shortcut changes, with anything unusable dropped.

    Lenient in the same way parse_workspace_counts() is. This file is small and
    obvious enough that someone will edit it by hand, and one bad line must not
    make it unloadable -- the empty document is the tracked default set, so the
    worst case is a shortcut quietly going back to where binds.lua puts it,
    never a desktop that will not start.
    """
    try:
        raw = load_toml(KEYBINDINGS_PATH)
    except SettingsError:
        raw = {}
    overrides: dict[str, str] = {}
    stored = raw.get("overrides")
    for identifier, keys in (stored.items() if isinstance(stored, dict) else []):
        try:
            overrides[combination_id(identifier)] = require_bindable(keys)
        except SettingsError:
            continue
    # An override naming a shortcut that does not exist, or one binds.lua keeps
    # for itself, is dropped here rather than refused later. Left in, it would
    # fail the guard on every subsequent change and leave the pane unable to
    # correct the very file that was blocking it.
    #
    # Only against a catalog that proves itself whole, because this document is
    # what keybind_action() renders back over keybindings.toml: a key missing
    # here is a rebind deleted from the file. A truncated catalog reads as a
    # complete short one, so filtering against an unproven catalog turned a
    # Hyprland reload racing a rebind into permanent, silent data loss. Anything
    # the reader cannot vouch for -- missing, empty, torn, or published by a
    # binds.lua older than the witness -- is treated the way a missing catalog
    # already was: read it, list it, change it, but never conclude from it that
    # one of the user's shortcuts has stopped existing.
    #
    # What that costs is a refusal instead of a deletion. With an unverified
    # catalog the overrides reach guard_keybinds() unfiltered, so one naming a
    # bind the fragment does not carry makes the *current* change fail -- with
    # "the shortcut list is still being published", which is what it is -- until
    # the catalog is republished. A change that did not happen is recoverable; the
    # rebinds it would have eaten were not.
    catalog, verified = read_keybind_catalog()
    if catalog and verified:
        known = {entry["id"] for entry in catalog}
        # Reported, unlike the protected ids the filter also drops: an override on
        # a rescue bind is a hand edit the guard would refuse anyway, while an id
        # the published set does not carry at all is a shortcut this release
        # removed or renamed -- the one case where the user loses something they
        # chose from the pane, and so the one worth a line in the journal.
        absent = sorted(set(overrides) - known)
        if absent:
            print(f"garage: keybindings.toml: dropping {len(absent)} override(s) on "
                  f"shortcut(s) config/binds.lua no longer publishes: "
                  f"{', '.join(absent)}", file=sys.stderr)
        movable = known - {entry["id"] for entry in catalog if entry["protected"]}
        overrides = {identifier: keys for identifier, keys in overrides.items()
                     if identifier in movable}
    custom: list[dict] = []
    for item in raw.get("custom", []) if isinstance(raw.get("custom"), list) else []:
        try:
            custom.append(custom_keybind(item, str(item.get("id", ""))))
        except (SettingsError, AttributeError):
            continue
    return {"overrides": overrides, "custom": custom[:CUSTOM_KEYBIND_MAX]}


def keybindings_toml(document: dict) -> str:
    lines = ["# Keyboard shortcuts changed in System Preferences. Every shortcut not",
             "# named here keeps the combination config/binds.lua gives it.",
             "",
             "[overrides]"]
    # Quoted keys: an id is a combination with the spacing taken out, so it
    # carries a "+" and is never a bare TOML key.
    for identifier, keys in sorted(document["overrides"].items()):
        lines.append(f"{toml_value(identifier)} = {toml_value(keys)}")
    for item in document["custom"]:
        lines += ["", "[[custom]]"]
        for key in ("id", "keys", "description", "command"):
            lines.append(f"{key} = {toml_value(item[key])}")
    return "\n".join(lines) + "\n"


def read_keybind_catalog() -> tuple[list[dict], bool]:
    """The published bind set, and whether it can be proved whole.

    Read rather than derived. `hyprctl binds -j` reports where a bind ended up
    and an opaque Lua registry index, never the combination the file wanted --
    and the two differ in exactly the case there is something to show. Parsing
    binds.lua from here would be a second, worse Lua interpreter that would have
    to know what the workspace loop expands to.

    The second half of the pair is the whole point of this function existing.
    Every line of this file is self-describing, so a truncated catalog reads back
    as a complete but shorter one and nothing in the entries marks it as a
    fragment -- which is how a reader that filtered the user's overrides against
    it came to delete the ones it simply had not seen yet. So config/binds.lua
    writes a witness last, "#end<TAB>N" with N the number of rows, and this
    returns False unless the file ends with that line and N is the number of rows
    actually parsed. Fail-closed: any tear, any short count, any missing witness
    is unverified, and the callers below may then read the catalog but never act
    on something being absent from it.

    False does not mean broken. A session still running the copy of binds.lua
    that shipped before the witness existed publishes a perfectly good catalog
    with no last line, and it must keep working -- listing shortcuts, changing
    them, everything except concluding that a bind the catalog does not mention
    has ceased to exist.
    """
    try:
        lines = KEYBINDS_CATALOG.read_text(encoding="utf-8").splitlines()
    except OSError:
        return [], False
    catalog = []
    for line in lines:
        fields = line.split("\t")
        if len(fields) == 5 and fields[0]:
            catalog.append({"id": fields[0], "group": fields[1], "keys": fields[2],
                            "protected": fields[3] == "1", "description": fields[4]})
    witness = next((line for line in reversed(lines) if line.strip()), "")
    return catalog, witness == f"{KEYBIND_CATALOG_SENTINEL}\t{len(catalog)}"


def keybind_catalog() -> list[dict]:
    """The default bind set alone, for everything that only has to display it."""
    return read_keybind_catalog()[0]


def resolve_keybinds(catalog: list[dict], document: dict) -> list[dict]:
    """The whole bind set config/binds.lua would register from this document."""
    resolved = []
    for entry in catalog:
        keys = entry["keys"] if entry["protected"] else document["overrides"].get(
            entry["id"], entry["keys"])
        resolved.append({"id": entry["id"], "group": entry["group"], "keys": keys,
                         "defaultKeys": entry["keys"], "protected": entry["protected"],
                         "description": entry["description"],
                         "modified": keys != entry["keys"], "custom": False})
    for item in document["custom"]:
        resolved.append({"id": item["id"], "group": "Custom", "keys": item["keys"],
                         "defaultKeys": "", "protected": False,
                         "description": item["description"] or item["command"],
                         "modified": False, "custom": True})
    return resolved


def guard_keybinds(catalog: list[dict], document: dict, verified: bool = True) -> None:
    """Refuse a shortcut set that could not be undone from the desktop itself.

    Before installing, not after. Hyprland's own emergency binds only appear
    once the bind count reaches zero, which cannot happen while binds.lua
    registers a hundred of them, so a set that merely lost its terminal would go
    entirely uncaught. The rescue binds are already structurally safe -- bind()
    never consults an override for them -- and this is the second lock on the
    same door, positioned so the pane can say why rather than the user finding
    out by pressing the key.

    `verified` changes what an unknown id is *called*, never whether it is
    refused. Against a catalog that cannot be proved whole -- see
    read_keybind_catalog() -- load_keybindings() no longer filters, so an override
    the fragment simply has not reached arrives here and stops the change. Saying
    "there is no shortcut called super+s" about a shortcut the user can see in the
    pane sends them to edit a file that is already correct; the truth is that the
    list is mid-publication.
    """
    if not catalog:
        raise SettingsError(
            "The shortcut list has not been published yet. Reload Hyprland and try again.")
    rescue = [entry for entry in catalog if entry["protected"]]
    if not rescue:
        raise SettingsError(
            "config/binds.lua declares no rescue shortcut, so there would be no way back "
            "to a terminal. Refusing to change the shortcuts.")
    known = {entry["id"]: entry for entry in catalog}
    for identifier in document["overrides"]:
        entry = known.get(identifier)
        if entry is None:
            if not verified:
                raise SettingsError(
                    "The shortcut list is still being published. Try again in a moment.")
            raise SettingsError(f"There is no shortcut called {identifier}")
        if entry["protected"]:
            raise SettingsError(f'"{entry["description"]}" cannot be changed')
    # Every match fires: addKeybind appends and the dispatch path runs all of
    # them, so two binds on one combination is not "the later one wins", it is
    # both actions on every press.
    claimed: dict[tuple, str] = {}
    for entry in resolve_keybinds(catalog, document):
        signature = combination_signature(entry["keys"])
        if signature in claimed:
            raise SettingsError(
                f'{entry["keys"]} is already used by "{claimed[signature]}"')
        claimed[signature] = entry["description"]
    for entry in rescue:
        if claimed.get(combination_signature(entry["keys"])) != entry["description"]:
            raise SettingsError(
                f'{entry["keys"]} must keep opening "{entry["description"]}"')


def render_keybinds(document: dict) -> None:
    """Publish the shortcut set for config/binds.lua to read.

    A data file, and that is the point rather than a detail. The command a
    custom shortcut runs is text the user typed, and generating a Lua
    `bind("...")` line from it makes the field a place to write Lua: a command
    ending `")) ;` closes the call and everything after it is config. Here the
    command is a JSON string that binds.lua reads with a reader that can only
    ever return strings, so there is no route from the field to the chunk.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    atomic_write(KEYBINDS_DATA, json.dumps({
        "overrides": document["overrides"],
        "custom": [{key: item[key] for key in ("keys", "description", "command")}
                   for item in document["custom"]],
    }, ensure_ascii=False, indent=2) + "\n")


def reload_keybinds() -> None:
    """Reload, then prove the desktop still has keys.

    Nothing else would notice. An empty bind set is the one state Hyprland
    rescues itself from, and it is unreachable here, so a set that came out
    wrong would simply be a desktop where a key does nothing. If the count does
    come back zero the overrides are thrown away -- which is exactly the tracked
    default set -- and the reload repeated, before the error is reported.
    """
    result = run(["hyprctl", "reload"])
    if result.returncode != 0:
        raise SettingsError(result.stderr.strip() or "Unable to reload the shortcuts")
    live = json_command(["hyprctl", "binds", "-j"], None)
    if isinstance(live, list) and not live:
        atomic_write(KEYBINDS_DATA, json.dumps({"overrides": {}, "custom": []}) + "\n")
        run(["hyprctl", "reload"])
        raise SettingsError("That left the desktop with no shortcuts at all. "
                            "The defaults have been put back.")


def keybind_action(operation: str, payload: object) -> None:
    """Apply one change to the shortcut set.

    Under the preferences lock, like `set`: this is another whole-file
    read-modify-write, and the pane can fire a rebind while a slider elsewhere
    is still landing.
    """
    values = payload if isinstance(payload, dict) else {}
    PREFERENCES_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with PREFERENCES_LOCK.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        document = load_keybindings()
        catalog, verified = read_keybind_catalog()
        known = {entry["id"]: entry for entry in catalog}
        if operation == "rebind":
            identifier = combination_id(values.get("id", ""))
            entry = known.get(identifier)
            if entry is None:
                raise SettingsError("There is no shortcut with that name")
            keys = require_bindable(values.get("keys"))
            # Back where it started is a removal, not an override that happens to
            # agree: keeping it would leave the pane showing the shortcut as
            # changed, and pin it if the default ever moved.
            if combination_id(keys) == identifier:
                document["overrides"].pop(identifier, None)
            else:
                document["overrides"][identifier] = keys
        elif operation == "reset":
            document["overrides"].pop(combination_id(values.get("id", "")), None)
        elif operation == "reset-all":
            document["overrides"] = {}
        elif operation == "add":
            if len(document["custom"]) >= CUSTOM_KEYBIND_MAX:
                raise SettingsError(f"There is room for {CUSTOM_KEYBIND_MAX} custom shortcuts")
            document["custom"].append(custom_keybind(values))
        elif operation == "update":
            identifier = str(values.get("id", ""))
            index = next((position for position, item in enumerate(document["custom"])
                          if item["id"] == identifier), -1)
            if index < 0:
                raise SettingsError("There is no custom shortcut with that name")
            document["custom"][index] = custom_keybind(values, identifier)
        elif operation == "remove":
            identifier = str(values.get("id", ""))
            document["custom"] = [item for item in document["custom"]
                                  if item["id"] != identifier]
        else:
            raise SettingsError(f"Unknown shortcut action: {operation}")
        guard_keybinds(catalog, document, verified)
        atomic_write(KEYBINDINGS_PATH, keybindings_toml(document))
        render_keybinds(document)
        reload_keybinds()


def keybindings_snapshot(document: dict) -> dict:
    """The shortcut list the pane draws, grouped the way binds.lua is written."""
    catalog = keybind_catalog()
    groups: list[dict] = []
    by_title: dict[str, dict] = {}
    for entry in resolve_keybinds(catalog, document):
        if entry["custom"]:
            continue
        group = by_title.get(entry["group"])
        if group is None:
            group = {"title": entry["group"], "binds": []}
            by_title[entry["group"]] = group
            groups.append(group)
        group["binds"].append(entry)
    return {
        "available": bool(catalog),
        "groups": groups,
        "custom": copy.deepcopy(document["custom"]),
        "modifiers": ["SUPER", "CONTROL", "ALT", "SHIFT"],
        "keys": KEY_CHOICES,
    }


def render_all(config: dict) -> None:
    """Write every generated fragment from the stored configuration.

    Pure, and that is the contract rather than a happy accident: this writes
    files and signals nothing. No gsettings, no service restart, no pkill, no
    `hyprctl eval` or `reload`. Everything that moves the running desktop lives
    on the apply side -- push_accent(), push_corner_radius(), push_theme(),
    apply_wallpaper(), apply_night_shift() -- and apply_preferences() is where
    the two halves are put back together.

    It used to apply as well, which made every caller an applier whether it
    wanted to be or not: hypridle.service's ExecStartPre ran `garage render`, so
    restarting the locker to pick up a new lock timeout re-themed every toolkit,
    pushed gsettings and reloaded the compositor -- and at session start it did
    all of that a second time, once from that unit and once from the `garage
    apply` in autostart.lua.

    `hyprctl monitors` still runs from render_workspaces(), through
    workspace_outputs(). That is a question, not an instruction: the plan cannot
    be written without knowing which displays exist. Nothing here answers back.
    """
    render_preferences(config)
    render_keybinds(load_keybindings())
    render_general(config)
    render_region(config)
    render_workspaces(config)
    render_bar_workspaces(config)
    render_accent(config)
    render_corner_radius(config)
    render_theme(config)
    render_wallpaper(config)
    layout = load_display_config()
    if layout["displays"]:
        render_displays(layout)
    else:
        DISPLAY_FRAGMENT.unlink(missing_ok=True)


def set_nested(config: dict, dotted: str, value: object) -> None:
    parts = dotted.split(".")
    if len(parts) != 2 or parts[0] not in FALLBACK_DEFAULTS or parts[1] not in FALLBACK_DEFAULTS[parts[0]]:
        raise SettingsError(f"Unknown preference: {dotted}")
    config.setdefault(parts[0], {})[parts[1]] = value


def current_wallpaper() -> str:
    try:
        return str(CURRENT_WALLPAPER.resolve(strict=True))
    except OSError:
        return ""


def monitor_names() -> list[str]:
    monitors = json_command(["hyprctl", "monitors", "-j"], [])
    if not isinstance(monitors, list):
        return []
    return [str(item.get("name", "")) for item in monitors
            if isinstance(item, dict) and item.get("name")]


def solid_wallpaper(color: str) -> Path:
    """Render a flat PNG of one colour and return its path.

    hyprpaper has no colour mode, so a colour has to reach it as an image. The
    file is named after the colour and reused: re-picking a swatch then costs no
    magick run, and every colour keeps a distinct path, which is what hyprpaper's
    path-keyed cache needs to notice a change.

    Sized to the largest monitor so the image never has to be scaled up, and
    written outside the stow tree because ~/.local/share is not a symlink farm.
    """
    path = WALLPAPER_DIR / f'solid-{color.lstrip("#").lower()}.png'
    if path.is_file():
        return path
    sizes = [(int(item.get("width", 0)), int(item.get("height", 0)))
             for item in json_command(["hyprctl", "monitors", "-j"], []) or []
             if isinstance(item, dict)]
    sizes = [size for size in sizes if size[0] > 0 and size[1] > 0] or [(1920, 1080)]
    geometry = f'{max(width for width, _ in sizes)}x{max(height for _, height in sizes)}'
    WALLPAPER_DIR.mkdir(parents=True, exist_ok=True)
    result = run(["magick", "-size", geometry, f"xc:{color}", str(path)], timeout=15)
    if result.returncode != 0 or not path.is_file():
        raise SettingsError(result.stderr.strip() or f"Unable to render {color}")
    return path


def render_wallpaper(config: dict) -> bool:
    """Write the generated hyprpaper config, reporting whether it changed.

    hyprpaper 0.8.4 reads fit_mode from its config file and only at startup: its
    IPC exposes wallpaper and listactive alone, there is no reload request and no
    signal handler. A changed file is therefore exactly the set of cases that
    need the service restarted, which is why this returns a flag instead of
    restarting anything itself.

    The path stays the `current` symlink because that is what a fresh session
    boots from; live path changes go over IPC in apply_wallpaper().
    """
    appearance = config["appearance"]
    # A colour has no composition to preserve and its PNG is cut for the largest
    # monitor, so contain or fit would letterbox it on the smaller ones. Cover
    # fills every display whatever their aspect ratios are.
    fit = ("cover" if appearance[f"wallpaper_{resolve_theme(config)}_source"] == "color"
           else str(appearance["wallpaper_fit"]))
    text = f'''# Generated by garage. Edit preferences.toml instead.
splash = false
ipc = true

wallpaper {{
    monitor =
    path = {CURRENT_WALLPAPER}
    fit_mode = {fit}
}}
'''
    GENERATED.mkdir(parents=True, exist_ok=True)
    try:
        if HYPRPAPER_CONFIG.read_text(encoding="utf-8") == text:
            return False
    except OSError:
        pass
    atomic_write(HYPRPAPER_CONFIG, text)
    return True


def wallpaper_target(config: dict, scheme: str) -> Path | None:
    """The image file one appearance's wallpaper resolves to, or None.

    A colour is an image too: hyprpaper has no colour mode, so the swatch is
    rendered to a PNG named after it.

    An appearance that has never been given a picture falls back to whatever
    `current` already points at, which keeps the desktop it has rather than
    blanking it. None is the case where there is nothing to fall back to either
    -- a first session before any wallpaper has been chosen.
    """
    appearance = config["appearance"]
    if appearance[f"wallpaper_{scheme}_source"] == "color":
        return solid_wallpaper(str(appearance[f"wallpaper_{scheme}_color"]))
    wallpaper = str(appearance.get(f"wallpaper_{scheme}") or "") or current_wallpaper()
    if not wallpaper:
        return None
    path = Path(wallpaper).expanduser()
    if not path.is_file():
        raise SettingsError(f"Wallpaper does not exist: {path}")
    # -L, or file reports inode/symlink and every wallpaper is rejected: the
    # shipped set lives in the dotfiles repo and reaches ~/Wallpaper as stow
    # symlinks, which is the normal case rather than the exotic one.
    mime = run(["file", "--brief", "--mime-type", "-L", str(path)]).stdout.strip()
    if not mime.startswith("image/"):
        raise SettingsError(f"Wallpaper is not an image: {path}")
    return path


def apply_wallpaper(config: dict, *, config_changed: bool | None = None) -> None:
    """Put the resolved wallpaper on screen.

    `config_changed` is for the one caller that has already rendered
    hyprpaper.conf itself -- apply_preferences(), where render_all() writes it --
    and so has taken the changed/unchanged answer this would otherwise compute.
    None means "render it now and see", which is every other caller.
    """
    path = wallpaper_target(config, resolve_theme(config))
    if path is None:
        return

    CURRENT_WALLPAPER.parent.mkdir(parents=True, exist_ok=True)
    temporary = CURRENT_WALLPAPER.with_name(".current.tmp")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(path)
    os.replace(temporary, CURRENT_WALLPAPER)

    moved = render_wallpaper(config) if config_changed is None else config_changed
    if moved:
        run(["systemctl", "--user", "restart", "hyprpaper.service"])
        return

    # A restart blanks every monitor for as long as hyprpaper takes to come back,
    # so a picture that changed but kept its fit goes over IPC instead. The
    # resolved target matters: hyprpaper keys its cache on the string it was
    # handed, so re-issuing the `current` symlink is a no-op even once the link
    # points somewhere else.
    target = str(path.resolve())
    results = [run(["hyprctl", "hyprpaper", "wallpaper", f"{monitor},{target}"])
               for monitor in monitor_names()]
    if not results or any(result.returncode != 0 for result in results):
        # hyprpaper is not up, or refused the image. Starting it fresh is the
        # only remaining way to get the wallpaper on screen.
        run(["systemctl", "--user", "restart", "hyprpaper.service"])


def minutes(value: str) -> int:
    hour, minute = map(int, value.split(":"))
    return hour * 60 + minute


def night_shift_active(config: dict) -> bool:
    appearance = config["appearance"]
    if not appearance["night_shift_enabled"]:
        return False
    now = time.localtime()
    current = now.tm_hour * 60 + now.tm_min
    start = minutes(appearance["night_shift_start"])
    end = minutes(appearance["night_shift_end"])
    return start <= current < end if start < end else current >= start or current < end


def resolve_theme(config: dict) -> str:
    """Which palette is in effect right now: "light" or "dark".

    Auto reads as a light window between the two times, wrapping midnight the
    same way the night shift schedule does.
    """
    appearance = config["appearance"]
    mode = str(appearance["theme_mode"])
    if mode in {"light", "dark"}:
        return mode

    now = time.localtime()
    current = now.tm_hour * 60 + now.tm_min
    light = minutes(appearance["theme_light_at"])
    dark = minutes(appearance["theme_dark_at"])
    if light == dark:
        return "dark"
    daytime = light <= current < dark if light < dark else current >= light or current < dark
    return "light" if daytime else "dark"


def applied_scheme() -> str:
    """The palette the desktop was last moved onto, or "" if it never has.

    SCHEME_FILE is written by push_theme() and nothing else -- in particular not
    by render_theme(), which writes the toolkit files -- so it is by definition
    the scheme currently live rather than the scheme last generated. That is what
    makes it usable as the change gate: a render that wrote the files without
    pushing them must still leave this saying what is on screen, or `theme-sync`
    and `set appearance.theme_*` would both skip the apply that was still owed.
    """
    try:
        return SCHEME_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def render_toolkits(scheme: str, *, root: Path | None = None) -> None:
    look = THEME_TOOLKITS[scheme]
    # The material still supplies the surface, but the terminal carries some body
    # of its own so text has something to sit on. Near-opaque would hide the
    # glass entirely, which is the trade to avoid.
    term_opacity = 0.5
    base = root or CONFIG_HOME

    def write(relative: str, text: str) -> None:
        # In place, not atomically: waybar and kitty watch these paths, and a
        # rename leaves their inotify watch pointing at the replaced inode. All
        # of these are small enough that a torn write is not a real risk.
        write_marker(base / relative, text)

    shared = f'''gtk-font-name=IBM Plex Sans 11
gtk-icon-theme-name={look["icons"]}
gtk-cursor-theme-name=macOS
gtk-cursor-theme-size=24
gtk-application-prefer-dark-theme={look["prefer_dark"]}
'''
    write("gtk-3.0/settings.ini", f'''# Generated by garage.
[Settings]
gtk-theme-name={look["gtk"]}
{shared}gtk-toolbar-style=GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=0
gtk-menu-images=0
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=0
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
''')
    write("gtk-4.0/settings.ini", f'''# Generated by garage.
[Settings]
{shared}''')

    # gtk.css itself has to be generated: the palette it imports is the thing
    # that changes, and GTK offers no way to redirect an @import at runtime.
    palette = f'apple-{scheme}.css'
    write("gtk-3.0/gtk.css", f'''/* Generated by garage. */
@import url("{palette}");
@import url("thunar.css");
''')
    # GTK4 carries both schemes in one file behind a prefers-color-scheme query,
    # so running apps follow the portal instead of freezing the palette they
    # launched with. GTK3 has no media queries, so it still imports per scheme.
    write("gtk-4.0/gtk.css", f'''/* Generated by garage. */
@import url("apple.css");
@import url("nautilus.css");
''')

    # XSettings is what re-themes GTK3 and XWayland apps without restarting them.
    write("xsettingsd/xsettingsd.conf", f'''Net/ThemeName "{look["gtk"]}"
Gtk/FontName "IBM Plex Sans 11"
Net/IconThemeName "{look["icons"]}"
Gtk/CursorThemeName "macOS"
Net/EnableEventSounds 1
EnableInputFeedbackSounds 0
Xft/Antialias 1
Xft/Hinting 1
Xft/HintStyle "hintslight"
Xft/RGBA "rgb"
''')

    write("swaync/style.css", f'''/* Generated by garage. */
@import url("swaync-{scheme}.css");
@import url("swaync-base.css");
''')

    write("rofi/config.rasi", f'''/* Generated by garage. */
configuration {{
    modes: "drun";
    show-icons: true;
    icon-theme: "Adwaita";
    display-drun: "";
    drun-display-format: "{{name}}";
    matching: "fuzzy";
    sort: true;
    click-to-exit: true;
    steal-focus: true;
}}

@theme "apple-{scheme}"
''')

    # Waybar uses Hyprland's native layer blur, with a light or dark translucent
    # tint selected from the resolved theme.
    bar_fg = "#ffffff" if scheme == "dark" else "#000000"
    bar_shadow = "0 1px 2px rgba(0, 0, 0, 0.45)" if scheme == "dark" else "none"
    bar_bg = "rgba(28, 28, 30, 0.42)" if scheme == "dark" else "rgba(245, 245, 247, 0.42)"
    bar_edge = "rgba(0, 0, 0, 0.30)" if scheme == "dark" else "rgba(0, 0, 0, 0.12)"
    bar_sheen = "rgba(255, 255, 255, 0.07)" if scheme == "dark" else "rgba(255, 255, 255, 0.60)"
    solid = "rgba(44, 44, 46, 0.90)" if scheme == "dark" else "rgba(255, 255, 255, 0.95)"
    solid_fg = "#f5f5f7" if scheme == "dark" else "#1c1c1e"
    dot = "255, 255, 255" if bar_fg == "#ffffff" else "28, 28, 30"
    write("waybar/style.css", f'''/* Generated by garage. */
@define-color bar_bg {bar_bg};
@define-color bar_edge {bar_edge};
@define-color bar_sheen {bar_sheen};
@define-color bar_fg {bar_fg};
@define-color menu_fg {bar_fg};
@define-color module_fg {bar_fg};
@define-color module_fg_hover {bar_fg};
@define-color module_fg_muted alpha({bar_fg}, 0.55);
@define-color dot_idle rgba({dot}, 0.45);
@define-color dot_hover rgba({dot}, 0.65);
@define-color dot_active rgba({dot}, 0.95);
@define-color urgent rgba(255, 69, 58, 0.95);
@define-color tooltip_bg {solid};
@define-color tooltip_fg {solid_fg};

@import "waybar-base.css";

/* The resolved theme chooses the foreground over Hyprland's frosted glass. */
window#waybar * {{
  text-shadow: {bar_shadow};
}}

tooltip, tooltip * {{
  text-shadow: none;
}}
''')

    write("swayosd/style.css", f'''/* Generated by garage. */
@import "swayosd-{scheme}.css";
''')

    # kitty paints its own background over the glass, so the terminal stays dark
    # until this changes no matter what the compositor does.
    kitty = {
        "dark": dict(bg="#1c1c1e", fg="#d1d1d6", cursor="#f5f5f7", cursor_text="#1c1c1e",
                     sel_bg="#0a84ff", sel_fg="#ffffff", url="#64aaff",
                     active_border="#0a84ff", inactive_border="#3a3a3c",
                     tab_afg="#f5f5f7", tab_abg="#3a3a3c",
                     tab_ifg="#8e8e93", tab_ibg="#1c1c1e"),
        "light": dict(bg="#ffffff", fg="#1c1c1e", cursor="#1c1c1e", cursor_text="#ffffff",
                      sel_bg="#007aff", sel_fg="#ffffff", url="#0060df",
                      active_border="#007aff", inactive_border="#c7c7cc",
                      tab_afg="#1c1c1e", tab_abg="#d1d1d6",
                      tab_ifg="#6c6c70", tab_ibg="#f2f2f7"),
    }[scheme]
    write("kitty/theme.conf", f'''# Generated by garage.
# Fully transparent: the glass underlay supplies the surface.
background_opacity          {term_opacity:g}
background                  {kitty["bg"]}
foreground                  {kitty["fg"]}
cursor                      {kitty["cursor"]}
cursor_text_color           {kitty["cursor_text"]}
selection_background        {kitty["sel_bg"]}
selection_foreground        {kitty["sel_fg"]}
url_color                   {kitty["url"]}
active_border_color         {kitty["active_border"]}
inactive_border_color       {kitty["inactive_border"]}
active_tab_foreground       {kitty["tab_afg"]}
active_tab_background       {kitty["tab_abg"]}
inactive_tab_foreground     {kitty["tab_ifg"]}
inactive_tab_background     {kitty["tab_ibg"]}
''')

    # btop reads a named theme file once at startup, so the file's contents are
    # swapped rather than the config's color_theme -- that keeps btop.conf stowed.
    btop = {
        "dark": dict(fg="#d1d1d6", dim="#8e8e93", hi="#0a84ff", sel_bg="#2c2c2e",
                     box="#3a3a3c", div="#48484a", meter="#2c2c2e"),
        "light": dict(fg="#1c1c1e", dim="#6c6c70", hi="#007aff", sel_bg="#d1d1d6",
                      box="#b0b0b5", div="#c7c7cc", meter="#e5e5ea"),
    }[scheme]
    write("btop/themes/vanta.theme", f'''# Generated by garage.
# An empty main_bg keeps the terminal's own background, which is the glass.
theme[main_bg]=""
theme[main_fg]="{btop["fg"]}"
theme[title]="{btop["fg"]}"
theme[hi_fg]="{btop["hi"]}"
theme[selected_bg]="{btop["sel_bg"]}"
theme[selected_fg]="{btop["fg"]}"
theme[inactive_fg]="{btop["dim"]}"
theme[graph_text]="{btop["dim"]}"
theme[meter_bg]="{btop["meter"]}"
theme[proc_misc]="{btop["hi"]}"
theme[cpu_box]="{btop["box"]}"
theme[mem_box]="{btop["box"]}"
theme[net_box]="{btop["box"]}"
theme[proc_box]="{btop["box"]}"
theme[div_line]="{btop["div"]}"
theme[temp_start]="#32d74b"
theme[temp_mid]="#ffd60a"
theme[temp_end]="#ff453a"
theme[cpu_start]="#32d74b"
theme[cpu_mid]="#ffd60a"
theme[cpu_end]="#ff453a"
theme[free_start]="{btop["dim"]}"
theme[free_mid]=""
theme[free_end]="{btop["fg"]}"
theme[cached_start]="#5ac8fa"
theme[cached_mid]=""
theme[cached_end]="{btop["hi"]}"
theme[available_start]="#ffd60a"
theme[available_mid]=""
theme[available_end]="#ff9f0a"
theme[used_start]="#32d74b"
theme[used_mid]="#ffd60a"
theme[used_end]="#ff453a"
theme[download_start]="#5ac8fa"
theme[download_mid]=""
theme[download_end]="{btop["hi"]}"
theme[upload_start]="#ff9f0a"
theme[upload_mid]=""
theme[upload_end]="#ff453a"
theme[process_start]="{btop["hi"]}"
theme[process_mid]=""
theme[process_end]="#af52de"
''')

    write("micro/settings.json", json.dumps(
        {"colorscheme": "catppuccin-latte" if scheme == "light" else "catppuccin-macchiato"},
        indent=4) + "\n")

    lock = {
        "dark": dict(outer="rgba(ffffff26)", inner="rgba(1c1c1ed9)", font="rgb(f5f5f7)",
                     placeholder="8e8e93", check="rgb(0a84ff)"),
        "light": dict(outer="rgba(00000026)", inner="rgba(f2f2f7d9)", font="rgb(1c1c1e)",
                      placeholder="6c6c70", check="rgb(007aff)"),
    }[scheme]
    GENERATED.mkdir(parents=True, exist_ok=True)
    atomic_write(GENERATED / "hyprlock-theme.conf", f'''# Generated by garage.
$outer_color = {lock["outer"]}
$inner_color = {lock["inner"]}
$font_color = {lock["font"]}
$placeholder_hex = {lock["placeholder"]}
$check_color = {lock["check"]}
''')

    write("qt6ct/qt6ct.conf", f'''[Appearance]
color_scheme_path={HOME}/.config/qt6ct/colors/{look["qt_colors"]}
custom_palette=true
icon_theme={look["icons"]}
standard_dialogs=gtk3
style=Fusion

[Fonts]
fixed="CaskaydiaMono Nerd Font Mono,10,-1,5,50,0,0,0,0,0"
general="IBM Plex Sans,10,-1,5,50,0,0,0,0,0"
''')


def render_search_engine(config: dict) -> None:
    """Publish the resolved search URL template.

    The launcher reads a resolved template, so it never has to know the engine
    list or how a custom entry is stored. This is the whole of what a search
    change needs: it touches no palette, so it must not drag in apply_theme.

    A render, not an apply, and named for it: the launcher opens the marker on
    every press and the shell watches it, so writing the file *is* the change
    landing. There is no world half to pair this with.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    engine = str(config["appearance"]["search_engine"])
    template = (str(config["appearance"].get("search_custom_url") or "")
                if engine == "custom" else SEARCH_ENGINES[engine])
    write_marker(SEARCH_FILE, (template or SEARCH_ENGINES["google"]) + "\n")


def application_dirs() -> list[Path]:
    data_dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    home = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
    return [home / "applications"] + [Path(item) / "applications"
                                      for item in data_dirs.split(":") if item]


def desktop_file(desktop_id: str) -> Path | None:
    """Where a desktop id resolves in XDG lookup order, or None if nowhere."""
    for directory in application_dirs():
        candidate = directory / desktop_id
        if candidate.is_file():
            return candidate
    return None


def desktop_fields(desktop_id: str) -> dict[str, str]:
    """The [Desktop Entry] keys of a desktop file.

    Read by hand rather than with configparser: an Exec value carries % and ;
    that configparser's interpolation fights, and a desktop file legitimately
    repeats a key in localised forms that would raise there.
    """
    path = desktop_file(desktop_id)
    if path is None:
        return {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return {}
    fields: dict[str, str] = {}
    section = ""
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            section = stripped
        elif section == "[Desktop Entry]" and "=" in stripped and not stripped.startswith("#"):
            key, value = stripped.split("=", 1)
            fields.setdefault(key.strip(), value.strip())
    return fields


def mime_handlers(mimetype: str) -> tuple[str, list[str]]:
    """The current default and every registered application for a mimetype.

    gio rather than the mimeinfo caches directly: it resolves the whole XDG
    lookup -- desktop-prefixed lists, config dirs, then data dirs -- exactly as
    the application that will open the file does. Run under C so the section
    headers this parses by cannot be translated out from under it.
    """
    result = run(["env", "LC_ALL=C", "gio", "mime", mimetype])
    default, registered, listing = "", [], False
    for line in result.stdout.splitlines():
        if line.startswith("\t"):
            if listing:
                registered.append(line.strip())
        elif line.startswith("Default application for"):
            # "No default applications for ..." misses this on purpose: it is
            # the answer for a mimetype nothing has claimed.
            default = line.rsplit(": ", 1)[-1].strip()
        else:
            listing = line.startswith("Registered applications")
    return default, registered


def role_applications(types: tuple[str, ...]) -> tuple[str, list[str]]:
    """A role's current handler and the applications that can take it over.

    A candidate has to register for every type the role owns, because selecting
    it writes every one of them. The union would offer a text editor as the web
    browser -- editors claim text/html, which the browser role also owns -- and
    then hand it the https scheme it cannot open.

    Deduplicated by display name: one application can ship two desktop files --
    Chrome installs both com.google.Chrome.desktop and google-chrome.desktop --
    and a combo offering "Google Chrome" twice gives no way to tell them apart.
    The entry already in force keeps its name, so the list always contains it.
    """
    current = ""
    by_name: dict[str, str] = {}
    for index, mimetype in enumerate(types):
        default, registered = mime_handlers(mimetype)
        if index == 0:
            current = default
        offered: dict[str, str] = {}
        for desktop_id in registered:
            fields = desktop_fields(desktop_id)
            name = fields.get("Name")
            # NoDisplay is the application saying it is not something to pick:
            # kitty's URL handler registers for inode/directory but is no file
            # manager, and nothing that hides from the menus belongs in a combo.
            if not name or fields.get("NoDisplay", "").lower() == "true":
                continue
            if name not in offered or desktop_id == current:
                offered[name] = desktop_id
        by_name = offered if index == 0 else {
            name: desktop_id for name, desktop_id in by_name.items() if name in offered}
    candidates = [desktop_id for _, desktop_id in sorted(by_name.items())]
    if current and current not in candidates:
        # The handler in force can be a desktop id that hides itself: Chrome
        # ships com.google.Chrome.desktop as a NoDisplay alias of the entry the
        # menus show. Report the visible entry standing for the same
        # application, and only offer the id itself when nothing does -- a
        # default the pane cannot show is one it would silently replace on the
        # next selection.
        replacement = by_name.get(desktop_fields(current).get("Name", ""))
        if replacement:
            current = replacement
        elif desktop_file(current):
            candidates.insert(0, current)
    return current, candidates


def terminal_candidates() -> list[str]:
    """Every installed terminal emulator, by desktop id.

    There is no mimetype for "a terminal", so the freedesktop category is the
    only registry there is. NoDisplay entries are skipped: kitty ships a second
    one that exists only to open URLs, and it is not a terminal to launch.
    """
    ids = {path.name for directory in application_dirs() if directory.is_dir()
           for path in directory.glob("*.desktop")}
    by_name: dict[str, str] = {}
    for desktop_id in sorted(ids):
        fields = desktop_fields(desktop_id)
        if ("TerminalEmulator" in fields.get("Categories", "")
                and fields.get("NoDisplay", "").lower() != "true"):
            by_name.setdefault(fields.get("Name", desktop_id), desktop_id)
    return [desktop_id for _, desktop_id in sorted(by_name.items())]


def resolve_terminal(config: dict) -> str:
    """The terminal in force: the chosen one for as long as it is installed."""
    candidates = terminal_candidates()
    chosen = str(config.get("general", {}).get("terminal", ""))
    return chosen if chosen in candidates else (candidates[0] if candidates else "")


def terminal_command(config: dict) -> str:
    return EXEC_FIELD_CODES.sub("", desktop_fields(resolve_terminal(config)).get("Exec", ""))


def browser_command() -> str:
    """The default browser as a command that opens with no arguments.

    $BROWSER is xdg-open, which is right for anything handing it a URL and
    useless as a bare keybinding -- it exits having been given nothing to open.
    So the bind gets the browser's own Exec instead, resolved from whatever is
    currently registered rather than stored a second time.
    """
    desktop_id, _ = role_applications(DEFAULT_APP_ROLES["browser"])
    if not desktop_id:
        return ""
    return EXEC_FIELD_CODES.sub("", desktop_fields(desktop_id).get("Exec", "")).strip()


def write_mime_defaults(assignments: dict[str, str]) -> None:
    """Point mimetypes at a desktop id in the desktop-prefixed mimeapps list.

    Only [Default Applications] is kept: this file is written here and read by
    the spec's lookup, and an association or a removal belongs in the tracked
    mimeapps.list that it overrides rather than in generated output.
    """
    entries: dict[str, str] = {}
    section = ""
    try:
        lines = MIMEAPPS_OVERRIDE.read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            section = stripped
        elif section == "[Default Applications]" and "=" in stripped and not stripped.startswith("#"):
            key, value = stripped.split("=", 1)
            entries[key.strip()] = value.strip()
    entries.update(assignments)
    atomic_write(MIMEAPPS_OVERRIDE,
                 "# Generated by garage. Overrides mimeapps.list.\n"
                 "[Default Applications]\n"
                 + "".join(f"{key}={value}\n" for key, value in sorted(entries.items()) if value))


def set_default_app(role: str, desktop_id: str) -> None:
    if role not in DEFAULT_APP_ROLES:
        raise SettingsError(f"Unknown default application: {role}")
    if not desktop_file(desktop_id):
        raise SettingsError(f"{desktop_id} is not installed")
    write_mime_defaults({mimetype: desktop_id for mimetype in DEFAULT_APP_ROLES[role]})
    if role == "browser":
        write_marker(BROWSER_FILE, browser_command() + "\n")
        run(["hyprctl", "reload"])


def render_general(config: dict) -> None:
    """Publish what the keybindings read, as markers rather than preferences.

    Both are read on a keypress: the launcher wrapper runs on every SUPER+Space,
    and Hyprland parses binds.lua with no way to shell out to this helper. A
    marker costs an open and a read; parsing TOML in Python would be felt.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    write_marker(LAUNCHER_FILE,
                 ("builtin" if config["general"]["builtin_launcher"] else "external") + "\n")
    write_marker(TERMINAL_FILE, terminal_command(config) + "\n")
    write_marker(BROWSER_FILE, browser_command() + "\n")


def apply_terminal(config: dict) -> None:
    render_general(config)
    # uwsm starts applications as systemd user units, so this is what makes
    # $TERMINAL true for anything launched after the change.
    run(["systemctl", "--user", "set-environment", f"TERMINAL={terminal_command(config)}"])
    # binds.lua reads the marker while the config is parsed, not per keypress.
    run(["hyprctl", "reload"])


def installed_locales() -> list[str]:
    """The locales glibc will actually accept, from locale -a.

    Not a table of the world's languages: only what locale-gen has built is
    usable, and offering the rest would be offering settings that silently do
    nothing. C and POSIX are dropped -- they are not languages, and picking one
    as your desktop language is never what was meant.

    Spelled the way localectl and LANG already spell it. locale -a reports the
    codeset without its dash, so en_US.utf8 and the en_US.UTF-8 in /etc/locale.conf
    are one locale under two names, and a combo box would show it twice.
    """
    names = set()
    for line in run(["locale", "-a"]).stdout.splitlines():
        name = line.strip()
        if "_" not in name:
            continue
        base, _, codeset = name.partition(".")
        if codeset.lower().replace("-", "") == "utf8":
            name = f"{base}.UTF-8"
        names.add(name)
    return sorted(names)


def system_locale() -> str:
    """LANG as the system sets it, which is the value an empty override means.

    Read from the file rather than asked of localectl: the systemd shipped here
    has no `localectl show`, only a status page meant for people, and
    /etc/locale.conf is the file localectl would be reading out anyway.
    """
    try:
        text = Path("/etc/locale.conf").read_text(encoding="utf-8")
    except OSError:
        return ""
    for line in text.splitlines():
        if line.startswith("LANG="):
            return line[len("LANG="):].strip().strip('"')
    return ""


def session_locale() -> str:
    """LANG in the systemd user manager, which is what the next app inherits."""
    for line in run(["systemctl", "--user", "show-environment"]).stdout.splitlines():
        if line.startswith("LANG="):
            return line[len("LANG="):]
    return ""


def clock_format(config: dict) -> str:
    """The bar clock's strftime string, date part then time part."""
    region = config["region"]
    return (DATE_FORMATS[region["date_format"]] + "  "
            + TIME_FORMATS[region["time_format"]])


def render_region(config: dict) -> None:
    """Publish the locale override and the bar's clock, as generated fragments.

    Both belong in files this cannot write: ~/.config/uwsm/env and waybar's
    config.jsonc are stow symlinks into the dotfiles repo, and rewriting either
    on a settings change would edit a tracked file. So each one reaches in from
    its own side instead -- the env file sources locale.env, config.jsonc
    includes waybar-clock.jsonc -- and only the generated halves move.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    region = config["region"]
    header = "# Generated by garage. Sourced from ~/.config/uwsm/env.\n"
    # No export at all for the empty override, rather than exporting the system
    # value: the point of "" is that the session is left to resolve LANG the way
    # it would with this file absent.
    atomic_write(LOCALE_ENV, header + (
        f"export LANG={shlex.quote(region['locale'])}\n" if region["locale"] else ""))

    clock: dict[str, object] = {"format": "{:" + clock_format(config) + "}",
                                "calendar": {"iso8601": FIRST_WEEKDAYS[region["first_day_of_week"]]}}
    # The one part of the choice the bar can honour before the next login: its
    # clock formats through a std::locale it is handed, not through the LANG the
    # process was started with, so the weekday and month names move immediately.
    if region["locale"]:
        clock["locale"] = region["locale"]
    atomic_write(WAYBAR_CLOCK, json.dumps({"clock": clock}, indent=2) + "\n")


def apply_locale(config: dict) -> None:
    """Push the chosen locale as far into the running session as it reaches.

    Not far. LANG is read once, at startup, by the C library, and nothing
    re-reads it, so no running program can be moved to another locale. What can
    be moved is what has yet to start: uwsm runs applications as systemd user
    units, so seeding the user manager's environment -- and the D-Bus activation
    environment beside it, for services started that way -- means anything
    opened from here on comes up in the new locale. The shell, the bar and every
    open window keep the old one until the next login, which is what the pane
    says in as many words.
    """
    target = config["region"]["locale"] or system_locale()
    if target:
        run(["systemctl", "--user", "set-environment", f"LANG={target}"])
    else:
        run(["systemctl", "--user", "unset-environment", "LANG"])
    # Best effort: dbus-update-activation-environment is not a hard dependency
    # of the setting, and the systemd half above is the one that matters here.
    if target and shutil.which("dbus-update-activation-environment"):
        run(["dbus-update-activation-environment", "--systemd", f"LANG={target}"])


def apply_region(config: dict) -> None:
    render_region(config)
    reload_bar()


def apply_bar_workspaces(config: dict) -> None:
    """Publish the bar's module list and signal the bar to re-read it.

    The same shape as apply_region() above, and paired the same way with its own
    renderer, because reload_bar() takes no configuration of its own and a route
    step is always handed one. The compositor is deliberately untouched: the
    workspaces, their rules and their keys do not depend on whether the bar
    lists them.
    """
    render_bar_workspaces(config)
    reload_bar()


def render_theme(config: dict) -> None:
    """Write every file the resolved palette decides. Pure: nothing is signalled.

    Only generated paths are written. Everything under ~/.config that this
    checkout tracks is a stow symlink into the dotfiles repo, so writing there
    would edit tracked files and leave the working tree dirty on every switch.

    SCHEME_FILE is deliberately *not* written here. It is the witness the change
    gate reads -- applied_scheme() -- so it has to mean "this palette is live on
    the desktop", not "these files have been written". Writing it from a pure
    render would make `theme-sync` and `set appearance.theme_*` skip the apply
    that was still owed.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    scheme = resolve_theme(config)
    render_search_engine(config)
    # The bar's widgets draw their own SVG text, which no stylesheet reaches.
    # Publish the resolved theme foreground so they match Waybar's CSS.
    write_marker(BAR_FG_FILE, ("#ffffff" if scheme == "dark" else "#000000") + "\n")
    render_toolkits(scheme)


def push_theme(config: dict) -> None:
    """Move the running desktop onto the palette render_theme() just wrote.

    The world half, and the one that publishes SCHEME_FILE: from here on
    applied_scheme() answers with this scheme, which is true because everything
    below has been told about it.
    """
    scheme = resolve_theme(config)
    look = THEME_TOOLKITS[scheme]

    # Quickshell watches this file, so its own UI repaints with no restart.
    write_marker(SCHEME_FILE, scheme + "\n")

    # The desktop picture belongs to the appearance, so it moves with the
    # palette. Hooked here because this is the one site every switch goes
    # through: a manual change, session start, and the five-minute theme timer.
    #
    # Gated on what `current` already resolves to, not on applied_scheme(): the
    # marker was overwritten a line ago and can no longer say what was on
    # screen. Ungated, the timer would re-issue the wallpaper -- and restart
    # hyprpaper whenever the fit moved with it -- every five minutes.
    try:
        target = wallpaper_target(config, scheme)
    except SettingsError:
        # A missing or unreadable picture is not a reason to abandon the rest of
        # the palette; the pane reports it the next time the setting is touched.
        target = None
    if target is not None and str(target.resolve()) != current_wallpaper():
        apply_wallpaper(config)

    # GTK4 and libadwaita follow the portal setting live.
    run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", look["scheme"]])
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", look["gtk"]])
    run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", look["icons"]])

    # GTK3 and XWayland apps re-theme when xsettingsd rereads its config.
    run(["systemctl", "--user", "reload-or-restart", "xsettingsd.service"])

    # swaync reloads its stylesheet in place.
    run(["swaync-client", "-rs"])

    # waybar rereads its stylesheet on SIGUSR2, kitty its whole config on SIGUSR1.
    run(["pkill", "-USR2", "-x", "waybar"])
    run(["pkill", "-USR1", "-x", "kitty"])
    run(["systemctl", "--user", "try-restart", "swayosd.service"])


def apply_theme(config: dict) -> None:
    """Write the resolved palette everywhere, then move the desktop onto it."""
    render_theme(config)
    push_theme(config)


def eval_config(body: str) -> subprocess.CompletedProcess[str]:
    """Set live Hyprland options from a Lua table body, without a reload.

    Hyprland 0.56 parses its config with Lua, and hyprctl keyword refuses to
    work there ("keyword can't work with non-legacy parsers. Use eval."), so the
    only way to reach a live option is eval. That is enough on its own: options
    are dereferenced per frame and cached nowhere, so no reload is needed for a
    new value to be picked up. render_preferences() has already written the
    fragment, which is what makes the value survive a real reload or a restart.

    eval sets values but damages nothing -- it does not emit config.reloaded,
    which is the only event the glass plugin repaints on -- so a second call
    writes decoration:blur:size back to its own value. A core option set
    dynamically schedules the refresh it declares, and blur's forces a full
    frame on every monitor without re-running a single monitor, window or layer
    rule. Writing it back to itself keeps the nudge free of any visible side
    effect. It has to be its own hl.config: a second `decoration` key in the
    same table constructor is a plain Lua overwrite, and the options it was
    meant to accompany would be dropped without any error.
    """
    code = (f"hl.config({{{body}}}) "
            'hl.config({decoration = {blur = {size = hl.get_config("decoration:blur:size")}}})')
    return run(["hyprctl", "eval", code])


def apply_glass(config: dict) -> None:
    """Push the whole window material straight into the running compositor."""
    # The shell's own surfaces are client-side alpha, which decoration opacity
    # multiplies but cannot lift. Off draws no glass behind them either, so
    # without this the session menu and the panels would have no background at
    # all. Quickshell watches this marker and paints itself solid instead.
    GENERATED.mkdir(parents=True, exist_ok=True)
    write_marker(MATERIAL_FILE, str(config["appearance"]["glass_mode"]) + "\n")
    result = eval_config(
        f"decoration = {{{lua_pairs(material_decoration(config))}}}, "
        f"plugin = {{kinetik_glass = {{{lua_pairs(glass_options(config))}}}}}")
    if result.returncode == 0:
        return
    # Most likely the plugin failed to load, in which case the fragment's own
    # GLASS_AVAILABLE guard is the thing that has to decide. Fall back to
    # the reload this used to do rather than refusing the setting outright.
    fallback = run(["hyprctl", "reload"])
    if fallback.returncode != 0:
        raise SettingsError(result.stdout.strip() or result.stderr.strip()
                            or "Unable to apply glass settings")


def render_corner_radius(config: dict) -> None:
    """Publish the corner radius for the shell to read. The file half."""
    # Quickshell watches this marker, so its surfaces re-round with no restart.
    write_marker(CORNER_RADIUS_FILE, f"{corner_rounding(config)}\n")


def push_corner_radius(config: dict) -> None:
    """Push the corner radius into the running compositor. The world half.

    Not fatal when it fails: this also runs from apply_preferences() at session
    start, where the compositor may not be up yet, and the generated fragment
    carries the same values into the next reload regardless.
    """
    rounding = corner_rounding(config)
    if eval_config(
        f"decoration = {{rounding = {rounding}, rounding_power = {CORNER_POWER:g}}}, "
        f"plugin = {{kinetik_glass = {{layer_rounding = {rounding}, corner_power = {CORNER_POWER:g}}}, "
        f"hyprexpo = {{tile_rounding = {rounding}, tile_rounding_power = {CORNER_POWER:g}}}}}"
    ).returncode != 0:
        # A plugin that never loaded takes the whole eval down with it, so the
        # guarded fragment is the only thing that can apply this correctly.
        run(["hyprctl", "reload"])


def apply_corner_radius(config: dict) -> None:
    render_corner_radius(config)
    push_corner_radius(config)


def apply_border(config: dict) -> None:
    """Push the window border straight into the running compositor."""
    if eval_config(f"general = {{{border_general(config)}}}").returncode != 0:
        run(["hyprctl", "reload"])


def apply_motion(config: dict) -> None:
    """Push the motion settings straight into the running compositor.

    Not eval_config(): that wraps a single hl.config table, and the per-leaf
    speeds are top-level hl.animation() calls. It also needs none of the blur
    write-back eval_config appends -- that nudge exists to make the glass plugin
    repaint, and nothing here touches the plugin.
    """
    if run(["hyprctl", "eval", motion_lua(config)]).returncode != 0:
        run(["hyprctl", "reload"])


def apply_night_shift(config: dict) -> None:
    if night_shift_active(config):
        run(["hyprctl", "hyprsunset", "temperature", str(int(config["appearance"]["night_shift_temperature"]))])
    else:
        run(["hyprctl", "hyprsunset", "identity"])


def apply_preferences(config: dict, *, restart_idle: bool = True) -> None:
    """Render everything, then move the whole running session onto it.

    The session-start path, from autostart.lua, and the only command that is
    supposed to touch every subsystem at once. `render` is the pure half of this.
    """
    # First, so that on a machine which has never had a saved layout the
    # workspace plan and the display fragment are both rendered from one -- the
    # same one, describing the monitors actually attached. On the apply side
    # because it is the only part of a render that needs a live compositor to
    # answer, and because session start is the moment it exists for.
    initialize_display_config()
    # Ahead of render_all(), which writes the same file: the restart below is
    # owed exactly when hyprpaper.conf moved, and only the first writer can see
    # that it did. hyprpaper reads fit_mode once, at startup, and exposes no
    # reload.
    paper_moved = render_wallpaper(config)
    render_all(config)
    push_accent(config)
    push_corner_radius(config)
    push_theme(config)
    run(["hyprctl", "reload"])
    apply_wallpaper(config, config_changed=paper_moved)
    apply_night_shift(config)
    if restart_idle:
        run(["systemctl", "--user", "restart", "hypridle.service"])


def run_or_raise(config: dict, command: list[str], message: str) -> None:
    """A route step that signals the session and refuses to fail quietly.

    `config` is unused: every step in PREFERENCE_ROUTES is called with it, so the
    route table can stay data rather than becoming a table of closures.
    """
    result = run(command)
    if result.returncode != 0:
        raise SettingsError(result.stderr.strip() or message)


def apply_live_wallpaper(config: dict, scheme: str) -> None:
    """Dress the desktop only if the appearance this key belongs to is on screen.

    Dressing the light appearance from a dark session must not change what is
    behind the pane. wallpaper_fit belongs to neither half, so its route is
    apply_wallpaper() directly and it always lands.
    """
    if resolve_theme(config) == scheme:
        apply_wallpaper(config)


def apply_theme_if_scheme_moved(config: dict) -> None:
    """Re-theme the session, but only when the palette actually moves.

    Rewriting a dozen toolkit configs and reloading Hyprland is only worth it
    then. Nothing downstream reads the mode or the schedule --
    render_preferences() picks its decoration colours from the resolved scheme too
    -- so an unchanged scheme means every output would be byte-identical. That
    also covers switching to auto at night when dark is already live; the
    garage-theme.timer re-checks the schedule every five minutes anyway.
    """
    if resolve_theme(config) != applied_scheme():
        apply_theme(config)
        render_preferences(config)
        run_or_raise(config, ["hyprctl", "reload"], "Unable to reload theme")


def apply_workspace_plan(config: dict) -> None:
    """Move the session onto a new workspace plan without losing any windows."""
    # Salvage first, reload second: the windows have to be moved while the
    # workspaces they are on are still the ones the compositor knows about, and
    # while render_workspaces has not yet overwritten the only record of the plan
    # they were placed under. Remap before reap, so a window is inside its own
    # display's block before anything asks which block it is in.
    plan = workspace_plan(config)
    showing = active_workspaces()
    moves = remap_workspaces(plan)
    reap_stranded_windows(plan)
    render_workspaces(config)
    # A full reload, not an eval: workspace rules are collected as the config is
    # parsed, and the binds are registered by the same pass. Both have to come
    # back together or the keys would address a layout that no longer exists.
    run_or_raise(config, ["hyprctl", "reload"], "Unable to reload workspaces")
    # Last, because it needs the surviving slots to be back on their own displays
    # before it sends anyone to one.
    restore_active_workspaces(plan, moves, showing)


def apply_changed_preference(config: dict, dotted: str) -> None:
    """Move the running session onto one changed key, and nothing else.

    The dispatch is PREFERENCE_SCHEMA's `route` field, walked through
    PREFERENCE_ROUTES: this used to be a second copy of the schema written as a
    ladder of string prefixes -- `key.startswith("glass_")` and the rest -- which
    is what let a new key be added, saved, and then silently never applied,
    because the ladder's final `else` was the only thing that would have said so.
    """
    section, key = dotted.split(".", 1)
    entry = PREFERENCE_SCHEMA.get(dotted)
    route = entry.get("route") if entry is not None else None
    if route is None:
        route = SECTION_ROUTES.get(section)
    if route is None:
        # appearance and general name the key, because both have always been able
        # to: every one of their keys routes somewhere of its own.
        if section in {"appearance", "general"}:
            raise SettingsError(f"Unsupported {section} preference: {key}")
        raise SettingsError(f"Unsupported preference section: {section}")
    for step in PREFERENCE_ROUTES[route]:
        name, *arguments = (step,) if isinstance(step, str) else step
        globals()[name](config, *arguments)


def json_command(command: list[str], fallback: object) -> object:
    result = run(command)
    if result.returncode != 0:
        return fallback
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return fallback


def display_snapshot() -> list[dict]:
    # "all", not the default list: Hyprland pulls a mirrored output out of its
    # monitor layout entirely (it loses its wl_output too, so grim cannot see it
    # either), and a disabled one never appears there. Both would vanish from
    # the pane with no control left to turn them back on.
    monitors = json_command(["hyprctl", "monitors", "all", "-j"], [])
    monitors = monitors if isinstance(monitors, list) else []
    # hyprctl reports mirrorOf as the source's *id*, rendered as a string, and
    # the literal "none" when the display stands on its own. Resolving it
    # through the id map is what turns that back into an output name; "none"
    # simply misses, which is also the answer for a display that mirrors
    # nothing. Do not test mirrorOf for truthiness -- id 0 is a real monitor.
    by_id = {str(monitor.get("id")): str(monitor.get("name", "")) for monitor in monitors
             if isinstance(monitor, dict)}
    try:
        saved = load_display_config()
    except SettingsError:
        saved = {"primary": "", "displays": []}
    saved_by_output = {item.get("output"): item for item in saved["displays"]}
    primary = saved.get("primary") or os.environ.get("HYPR_PRIMARY_MONITOR", "")
    result = []
    for monitor in monitors:
        current_mode = f'{int(monitor.get("width", 0))}x{int(monitor.get("height", 0))}@{float(monitor.get("refreshRate", 60)):g}'
        configured = saved_by_output.get(monitor.get("name"), {})
        mirror = by_id.get(str(monitor.get("mirrorOf", "none")), "")
        # A mirror is reported at its source's position, so the spot it holds in
        # the arrangement only survives in displays.toml. Keep handing that one
        # back or turning the mirror off would drop the display on top of the
        # very output it was copying.
        placed = configured if mirror else monitor
        result.append({
            "output": monitor.get("name", ""),
            "description": monitor.get("description", monitor.get("name", "Display")),
            "make": monitor.get("make", ""),
            "model": monitor.get("model", ""),
            "serial": monitor.get("serial", ""),
            "enabled": not monitor.get("disabled", False),
            "width": monitor.get("width", 0),
            "height": monitor.get("height", 0),
            "refresh": monitor.get("refreshRate", 60),
            "mode": configured.get("mode", current_mode),
            "mirror": mirror,
            "x": placed.get("x", 0),
            "y": placed.get("y", 0),
            "scale": monitor.get("scale", 1),
            "transform": monitor.get("transform", 0),
            # From displays.toml, not from the monitor: hyprctl's vrr field is
            # the output's live adaptive-sync state, not the mode that was asked
            # for -- it stays false for a fullscreen-only mode with nothing
            # fullscreen, and on a panel whose CRTC cannot do VRR at all. The
            # mode itself only survives in the file. -1 means follow misc:vrr.
            "vrr": int(configured.get("vrr", -1)),
            "modes": monitor.get("availableModes", []),
            "focused": monitor.get("focused", False),
            "primary": monitor.get("name") == primary,
        })
    if result and not any(item["primary"] for item in result):
        primary_index = next((index for index, item in enumerate(result) if item["focused"]), 0)
        result[primary_index]["primary"] = True
    return result


def workspaces_snapshot(config: dict, displays: list[dict]) -> dict:
    """The allocation the pane draws, for the displays now attached.

    Resolved here rather than in QML so the pane and the generated fragment
    cannot disagree about which display owns which ids: there is one allocator,
    and this is a read of it. The per-display groups are reported even in shared
    mode, so the pane can show what switching back would give.
    """
    labels = {str(item["output"]): str(item.get("model") or item["output"])
              for item in displays}
    return {
        "max": WORKSPACE_COUNT_MAX,
        "displays": [{
            "output": group["monitor"],
            "label": labels.get(group["monitor"], group["monitor"]),
            "count": group["count"],
            "first": group["first"],
            "last": group["first"] + group["count"] - 1,
        } for group in per_display_groups(config)],
    }


def audio_snapshot() -> dict:
    info = json_command(["pactl", "-f", "json", "info"], {})
    sinks = json_command(["pactl", "-f", "json", "list", "sinks"], [])
    sources = json_command(["pactl", "-f", "json", "list", "sources"], [])

    def simplify(items: object, default_name: str) -> list[dict]:
        simplified = []
        for item in items if isinstance(items, list) else []:
            volumes = item.get("volume", {})
            first = next(iter(volumes.values()), {}) if isinstance(volumes, dict) else {}
            percent = str(first.get("value_percent", "0%")).rstrip("%")
            simplified.append({
                "name": item.get("name", ""),
                "description": item.get("description", item.get("name", "Device")),
                "default": item.get("name") == default_name,
                "mute": bool(item.get("mute", False)),
                "volume": float(percent or 0) / 100,
            })
        return simplified

    return {
        "outputs": simplify(sinks, str(info.get("default_sink_name", ""))),
        "inputs": simplify(sources, str(info.get("default_source_name", ""))),
    }


def notification_snapshot() -> dict:
    result = run(["swaync-client", "-D"])
    text = result.stdout.strip().lower()
    return {"available": result.returncode == 0, "dnd": text in {"true", "1", "enabled", "on"}}


def input_snapshot() -> dict:
    devices = json_command(["hyprctl", "devices", "-j"], {})
    return {"hasTouchpad": bool(devices.get("touch", [])) or any(
        "touchpad" in str(item.get("name", "")).lower()
        for item in devices.get("mice", []) if isinstance(item, dict)
    )} if isinstance(devices, dict) else {"hasTouchpad": False}


def default_apps_snapshot(config: dict) -> dict:
    """The handler in force and the candidates, for every role the pane offers.

    Read live rather than stored: the mime defaults belong to mimeapps.list, and
    a second copy in preferences.toml would be nothing but a copy to drift. The
    terminal is the exception -- nothing on the system records one -- so it is a
    real preference, resolved here against what is actually installed.
    """
    apps = {}
    for role, types in DEFAULT_APP_ROLES.items():
        current, candidates = role_applications(types)
        apps[role] = {"current": current, "candidates": candidates}
    apps["terminal"] = {"current": resolve_terminal(config), "candidates": terminal_candidates()}
    return apps


def timedate_value(name: str) -> str:
    result = run(["timedatectl", "show", f"--property={name}", "--value"])
    return result.stdout.strip() if result.returncode == 0 else ""


def datetime_snapshot() -> dict:
    zones = run(["timedatectl", "list-timezones"])
    timezone = timedate_value("Timezone")
    if not timezone:
        try:
            localtime = Path("/etc/localtime").resolve()
            timezone = str(localtime).split("/zoneinfo/", 1)[1]
        except (OSError, IndexError):
            timezone = time.tzname[0]
    return {
        "timezone": timezone,
        "ntp": timedate_value("NTP").lower() == "yes",
        "synchronized": timedate_value("NTPSynchronized").lower() == "yes",
        "timezones": zones.stdout.splitlines() if zones.returncode == 0
            else sorted(available_timezones()),
    }


def region_snapshot() -> dict:
    """What the pane needs to tell the truth about a locale change.

    Three LANGs, because they genuinely differ after a change: the system one
    this override sits on top of, the one the user manager will hand the next
    application, and the one this process was started with -- which, since the
    helper is a child of the shell, is the locale the running session is in.
    """
    return {
        "locales": installed_locales(),
        "system": system_locale(),
        "session": session_locale(),
        "active": os.environ.get("LANG", ""),
    }


def make_snapshot() -> dict:
    error = ""
    try:
        preferences = load_preferences()
    except SettingsError as exc:
        preferences = copy.deepcopy(FALLBACK_DEFAULTS)
        error = str(exc)
    # preferences is reported exactly as stored. It used to have the wallpaper
    # replaced with the resolved `current` symlink, which meant the pane was
    # shown a path nothing had ever written -- after picking a solid colour it
    # read back .../solid-1c1c1e.png as though that were the chosen picture.
    displays = display_snapshot()
    return {
        "preferences": preferences,
        "defaultApps": default_apps_snapshot(preferences),
        "displays": displays,
        "workspaces": workspaces_snapshot(preferences, displays),
        "keybindings": keybindings_snapshot(load_keybindings()),
        "audio": audio_snapshot(),
        "notifications": notification_snapshot(),
        "dateTime": datetime_snapshot(),
        "region": region_snapshot(),
        "inputCapabilities": input_snapshot(),
        "capabilities": {name: shutil.which(name) is not None for name in (
            "hyprctl", "hyprpaper", "hyprsunset", "pactl", "swaync-client", "hypridle"
        )},
        "error": error,
    }


def normalize_display_layout(layout: dict) -> dict:
    normalized = copy.deepcopy(layout)
    displays = normalized.get("displays", [])
    # The origin belongs to the outputs that actually occupy the desktop. A
    # mirror only carries a parked coordinate for when it is turned off again,
    # and anchoring on that would slide every real display away from 0,0.
    mirrors = mirror_targets(displays)
    placed = [item for item in displays
              if item.get("enabled", True) and str(item.get("output", "")) not in mirrors]
    if not placed:
        return normalized
    minimum_x = min(float(item.get("x", 0)) for item in placed)
    minimum_y = min(float(item.get("y", 0)) for item in placed)
    for item in normalized.get("displays", []):
        item["x"] = round(float(item.get("x", 0)) - minimum_x)
        item["y"] = round(float(item.get("y", 0)) - minimum_y)
    return normalized


def apply_display_layout(layout: dict) -> None:
    displays = layout.get("displays", [])
    if not displays or not any(item.get("enabled", True) for item in displays):
        raise SettingsError("At least one display must remain enabled")
    # A mirror is not part of the arrangement: Hyprland stacks it exactly on its
    # source, which reads as a total overlap here, and it touches no edge of its
    # own. Only the outputs that hold their own place are checked -- and they are
    # checked against each other exactly as strictly as before.
    mirrors = mirror_targets(displays, strict=True)
    placed = [item for item in displays
              if item.get("enabled", True) and str(item.get("output", "")) not in mirrors]
    if not placed:
        raise SettingsError("At least one display must show the desktop rather than mirror another")
    rectangles: list[tuple[dict, tuple[float, float, float, float]]] = []
    for first in placed:
        first_width = float(first.get("width", 1)) / float(first.get("scale", 1))
        first_height = float(first.get("height", 1)) / float(first.get("scale", 1))
        first_rect = (float(first.get("x", 0)), float(first.get("y", 0)),
                      float(first.get("x", 0)) + first_width,
                      float(first.get("y", 0)) + first_height)
        rectangles.append((first, first_rect))
    adjacency: list[set[int]] = [set() for _ in rectangles]
    for index, (first, first_rect) in enumerate(rectangles):
        for second_index, (second, second_rect) in enumerate(rectangles[index + 1:], index + 1):
            overlaps = (first_rect[0] < second_rect[2] - 0.5
                        and first_rect[2] > second_rect[0] + 0.5
                        and first_rect[1] < second_rect[3] - 0.5
                        and first_rect[3] > second_rect[1] + 0.5)
            if overlaps:
                raise SettingsError(
                    f'{first.get("output")} overlaps {second.get("output")}; '
                    "drag their edges apart before applying")
            vertical_overlap = min(first_rect[3], second_rect[3]) > max(first_rect[1], second_rect[1])
            horizontal_overlap = min(first_rect[2], second_rect[2]) > max(first_rect[0], second_rect[0])
            touches = ((abs(first_rect[2] - second_rect[0]) < 0.5
                        or abs(second_rect[2] - first_rect[0]) < 0.5) and vertical_overlap)
            touches = touches or ((abs(first_rect[3] - second_rect[1]) < 0.5
                                  or abs(second_rect[3] - first_rect[1]) < 0.5) and horizontal_overlap)
            if touches:
                adjacency[index].add(second_index)
                adjacency[second_index].add(index)
    connected = {0}
    pending = [0]
    while pending:
        current = pending.pop()
        for neighbour in adjacency[current] - connected:
            connected.add(neighbour)
            pending.append(neighbour)
    if len(connected) != len(rectangles):
        raise SettingsError("Display layout contains gaps; connect every monitor edge-to-edge")
    render_displays(layout)
    result = run(["hyprctl", "reload"])
    if result.returncode != 0:
        raise SettingsError(result.stderr.strip() or "Unable to reload the display layout")


def layout_toml(layout: dict) -> str:
    lines = [f'primary = {toml_value(str(layout.get("primary", "")))}', ""]
    for item in layout.get("displays", []):
        lines.append("[[display]]")
        for key in ("output", "description", "enabled", "mode", "x", "y", "scale",
                    "transform", "vrr"):
            if key in item:
                lines.append(f"{key} = {toml_value(item[key])}")
        # Written only when set. Extending is the default and every display
        # carries the key, so the loop above would leave a dead mirror = "" in
        # each entry -- but leaving it out of the loop entirely is what would
        # silently drop the mirror on the way to disk.
        if item.get("mirror"):
            lines.append(f'mirror = {toml_value(str(item["mirror"]))}')
        lines.append("")
    return "\n".join(lines)


def initialize_display_config() -> None:
    """Record the machine's own display arrangement, once, on the first render.

    The tracked config names no connector: config.monitors ships a single
    catch-all rule and every named monitor rule reaches Hyprland through the
    generated fragment, which is rendered from displays.toml. Nothing writes that
    file but a confirmed layout from the Displays pane, though, so until this the
    machine of an owner who never opened the pane stayed on the catch-all for
    good -- preferred mode, auto position, scale 1 -- and workspace_outputs() had
    no saved layout to lead with, which is what loses a sleeping display its
    block.

    So the first render seeds it from what Hyprland currently reports, which is
    the arrangement the catch-all rule produced: a faithful description of this
    machine, and the baseline the user then edits. Normalized and serialized
    through the same two helpers the pane's own save path uses, so both write the
    same file.

    Never an overwrite -- the file belongs to the user from the moment it exists.
    And silent when there is nothing to record: `garage render` also runs where no
    compositor is answering, and a missing hyprctl or an empty monitor list is a
    render with no displays to snapshot rather than a failure.
    """
    if DISPLAYS_PATH.exists():
        return
    displays = display_snapshot()
    if not displays:
        return
    # Under the lock display_finish() writes displays.toml with, and re-checked
    # inside it: session start runs this while the pane is coming up, and a
    # layout confirmed in between must not be replaced by a snapshot of the
    # arrangement it was confirmed away from.
    DISPLAY_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with DISPLAY_LOCK.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if DISPLAYS_PATH.exists():
            return
        # display_snapshot() always marks one display primary -- the focused one
        # when nothing has been chosen yet -- so this only misses if the list is
        # empty, which is already handled above.
        primary = next((item["output"] for item in displays if item["primary"]), "")
        layout = normalize_display_layout({"primary": primary, "displays": displays})
        atomic_write(DISPLAYS_PATH, layout_toml(layout))


def display_test(payload: dict) -> str:
    token = uuid.uuid4().hex
    payload = normalize_display_layout(payload)
    previous_displays = display_snapshot()
    previous_primary = next((item["output"] for item in previous_displays if item["primary"]), "")
    previous = {"displays": previous_displays, "primary": previous_primary}
    pending = {"token": token, "previous": previous, "candidate": payload, "expires": time.time() + 15}
    atomic_write(PENDING_DISPLAY, json.dumps(pending))
    apply_display_layout(payload)
    subprocess.Popen(
        [str(Path(__file__).resolve()), "_display-watchdog", token],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return token


def display_finish(token: str, confirm: bool) -> None:
    DISPLAY_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with DISPLAY_LOCK.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if not PENDING_DISPLAY.exists():
            return
        pending = json.loads(PENDING_DISPLAY.read_text(encoding="utf-8"))
        if pending.get("token") != token:
            raise SettingsError("Display confirmation token expired")
        if confirm:
            atomic_write(DISPLAYS_PATH, layout_toml(pending["candidate"]))
            render_displays(pending["candidate"])
            apply_display_layout(pending["candidate"])
        else:
            apply_display_layout(pending["previous"])
        PENDING_DISPLAY.unlink(missing_ok=True)


def action(name: str, value: object | None) -> None:
    if name == "audio.output.volume":
        run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", str(float(value))], check=True)
    elif name == "audio.input.volume":
        run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SOURCE@", str(float(value))], check=True)
    elif name == "audio.output.mute":
        run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if value else "0"], check=True)
    elif name == "audio.input.mute":
        run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "1" if value else "0"], check=True)
    elif name == "audio.output.default":
        run(["pactl", "set-default-sink", str(value)], check=True)
    elif name == "audio.input.default":
        run(["pactl", "set-default-source", str(value)], check=True)
    elif name == "notifications.dnd":
        run(["swaync-client", "-dn" if value else "-df"], check=True)
    elif name == "notifications.clear":
        run(["swaync-client", "-C"], check=True)
    elif name == "glass.reset":
        # Under PREFERENCES_LOCK, exactly like `set`: this is another whole-file
        # read-modify-write, and the pane can fire it while a slider elsewhere in
        # the same pane is still writing. Unserialised, the loser's copy predates
        # the winner's keys and the last writer restores them. Safe to *block* on
        # the lock here -- unlike the load path, which only ever tries it, see
        # compact_preferences_file() -- because nothing below restarts a service
        # whose ExecStartPre re-enters this binary.
        PREFERENCES_LOCK.parent.mkdir(parents=True, exist_ok=True)
        with PREFERENCES_LOCK.open("a+", encoding="utf-8") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            config = load_preferences()
            defaults = shipped_defaults()
            # Every material preference is a glass_ key, so this needs no list of
            # its own to keep in step with the schema.
            for key, fallback in defaults["appearance"].items():
                if key.startswith("glass_"):
                    config["appearance"][key] = fallback
            validate_preferences(config)
            save_preferences(config)
            render_preferences(config)
            # The same live push a single slider takes, rather than the full
            # reload this used to do: apply_glass now covers the core decoration
            # options too, and falls back to a reload itself if the eval cannot
            # land. Inside the lock for the same reason `set` applies inside it:
            # a stale apply landing last would leave the desktop disagreeing
            # with the file.
            apply_glass(config)
    elif name.startswith("keybind."):
        keybind_action(name.split(".", 1)[1], value)
    elif name.startswith("defaults."):
        set_default_app(name.split(".", 1)[1], str(value))
    elif name == "lock.now":
        run(["loginctl", "lock-session"], check=True)
    elif name == "datetime.ntp":
        subprocess.Popen(
            ["timedatectl", "set-ntp", "true" if value else "false"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    elif name == "datetime.timezone":
        timezone = str(value)
        available = run(["timedatectl", "list-timezones"])
        if timezone not in available.stdout.splitlines():
            raise SettingsError("Unknown timezone")
        subprocess.Popen(
            ["timedatectl", "set-timezone", timezone],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    else:
        raise SettingsError(f"Unknown action: {name}")


# ---------------------------------------------------------------------------
# Lifecycle: `garage doctor` and `garage update`
#
# Plumbing, deliberately unlike everything above it. Every other command answers
# the QML client and prints one JSON object; these two answer a person at a
# terminal and print lines, so nothing here reaches make_snapshot() and nothing
# here goes through response(). main() dispatches them before the JSON path for
# that reason.
# ---------------------------------------------------------------------------

# The support floor. Hyprland's config language and option names move between
# releases, and the tracked hyprland.lua is written against this one; below it
# the desktop fails in ways that read as Garage bugs rather than as an old
# compositor. Compared numerically -- see version_parts() -- because the day
# 0.56.10 ships, a string comparison puts it below 0.56.9.
MINIMUM_HYPRLAND = "0.56.0"

# Named because losing one of these is a broken desktop rather than a missing
# extra: the shell, the bar, the terminal, the idle and wallpaper daemons, the
# linker that puts the configuration in place, and the two theme assets that
# every toolkit config names by string. The full package set lives in
# bootstrap.sh and is not duplicated here -- `garage update` re-runs that list
# through pacman anyway, which is a better check than repeating it.
DOCTOR_PACKAGES = ("quickshell", "waybar", "hypridle", "hyprpaper", "kitty",
                   "fish", "stow", "ttf-ibm-plex", "adw-gtk-theme")

# fc-list family names, not package names: a font can be installed and still not
# be found by fontconfig, and every toolkit config asks for these two by family.
DOCTOR_FONTS = ("IBM Plex Sans", "IBM Plex Mono")

# The per-user units this checkout owns, plus the three it extends with a
# drop-in, each with whether a live session should show it running.
# garage-plugins-check.service is Type=oneshot: it runs at login, says its piece
# and exits, so "inactive" is its healthy steady state and only "enabled"
# means anything. The .service halves of the two timers are the same story.
DOCTOR_UNITS = (
    ("waybar.service", True),
    ("hypridle.service", True),
    ("hyprpaper.service", True),
    ("garage-shell.service", True),
    ("garage-theme.timer", True),
    ("garage-night-shift.timer", True),
    ("garage-plugins-check.service", False),
)

# Where garage-rebuild-plugins deploys, and the two stable symlinks hyprland.lua
# loads. Duplicated from that script rather than parsed out of it: they are a
# published layout that the pacman hook also hardcodes, not a private detail.
PLUGIN_ROOT = Path("/usr/lib/kinetik/plugins")
PLUGIN_NAMES = ("kinetik-glass", "hyprexpo")

# Where a stow link from this checkout can legitimately be. Everything under
# desktop/ lands in one of these four, so a dangling repo-pointing link cannot
# be anywhere else -- and scoping the sweep this tightly is what keeps it from
# ever considering the many links elsewhere in $HOME that dangle on purpose
# (Chrome's SingletonLock, Discord's IPC sockets, editor session files).
SCAN_ROOTS = (CONFIG_HOME, HOME / ".local/bin", HOME / ".local/share", HOME / "Wallpaper")


def tilde(path: Path) -> str:
    """A path as the user would type it, for report lines."""
    try:
        return f"~/{path.relative_to(HOME)}"
    except ValueError:
        return str(path)


def version_parts(text: str) -> tuple[int, ...]:
    """The first three integers in a version string, for numeric comparison."""
    numbers = [int(part) for part in re.findall(r"\d+", text)[:3]]
    return tuple(numbers + [0] * (3 - len(numbers)))


def link_hop(path: Path) -> Path | None:
    """Where a symlink points after exactly one hop, absolute, unresolved.

    The same rule bootstrap.sh's link_hop() follows, and for the same reason:
    full resolution is wrong for judging a stow link, because a tracked file may
    itself be a symlink and resolving it lands outside the checkout. None when
    the path is not a symlink.
    """
    try:
        target = os.readlink(path)
    except OSError:
        return None
    if not os.path.isabs(target):
        target = os.path.join(os.path.dirname(str(path)), target)
    return Path(os.path.normpath(target))


def points_into(path: Path, tree: Path) -> bool:
    """True when a symlink is one of ours in this checkout.

    Lexically first, then through full resolution, so it holds whether or not
    the checkout's own path contains symlinked components.
    """
    hop = link_hop(path)
    if hop is not None and hop.is_relative_to(tree):
        return True
    return Path(os.path.realpath(path)).is_relative_to(tree)


def checkout_root() -> Path:
    """The dotfiles checkout this script is part of.

    __file__ is reached through the stow link at ~/.local/bin/garage, so
    resolving it and walking up out of desktop/.local/bin names the checkout the
    running session is actually linked to -- which is the only definition that
    lets `update` restow the same tree it just pulled.
    """
    root = Path(__file__).resolve().parents[3]
    if not (root / "desktop/.stow-local-ignore").is_file():
        raise SettingsError(f"{Path(__file__).resolve()} is not inside a Garage checkout")
    return root


def stow_ignores(root: Path) -> list[re.Pattern[str]]:
    """The path-anchored patterns from desktop/.stow-local-ignore.

    Only those: the rest of that file repeats stow's name-based defaults, which
    managed_paths() applies by name. Anchored patterns are what excludes the
    toolkit configs garage rewrites at runtime, and a manifest that included
    them would report every theme switch as a broken link.
    """
    patterns = []
    for line in (root / "desktop/.stow-local-ignore").read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line.startswith("^/"):
            try:
                patterns.append(re.compile(line))
            except re.error:
                continue
    return patterns


def managed_paths(root: Path) -> list[str]:
    """Everything stow will place, as paths relative to $HOME.

    The Python side of bootstrap.sh's managed_paths() plus stow_ignores(): with
    --no-folding every leaf becomes its own symlink, so the managed set is
    exactly this file list.
    """
    tree = root / "desktop"
    patterns = stow_ignores(root)
    paths: list[str] = []
    for parent, directories, files in os.walk(tree):
        here = Path(parent)
        # A symlinked directory is a leaf stow would place as one link, not a
        # directory to descend into. .git is never inside desktop/, and is
        # skipped for the same reason bootstrap skips it.
        leaves = [name for name in directories if (here / name).is_symlink()]
        # An ignored directory prunes its whole subtree, matching stow: the
        # pattern names the directory, so nothing under it is ever placed.
        directories[:] = [name for name in directories
                          if name not in leaves and name != ".git"
                          and not any(pattern.search(
                              f"/{(here / name).relative_to(tree)}")
                              for pattern in patterns)]
        for name in files + leaves:
            relative = str((here / name).relative_to(tree))
            if name in {".stow-local-ignore", ".gitignore"} or name.endswith("~"):
                continue
            if any(pattern.search(f"/{relative}") for pattern in patterns):
                continue
            paths.append(relative)
    return sorted(paths)


def stow_state(root: Path) -> dict:
    """How each managed path currently resolves from $HOME.

    Five outcomes, because they have five different answers:

      linked  -- a symlink into this checkout that resolves. The healthy case.
      other   -- a stow link at the right relative path inside a *different*
                 checkout. The desktop works; it is just being served from
                 somewhere else, which is what a moved or duplicated clone looks
                 like, and what a restow corrects.
      broken  -- a link into this checkout whose target is gone, or a link to
                 something else entirely.
      plain   -- a real file sitting where a link belongs; bootstrap backs it up.
      missing -- nothing there at all, which is what a file added to the
                 checkout since the last stow looks like.
    """
    tree = root / "desktop"
    state: dict = {"linked": 0, "other": [], "broken": [], "plain": [],
                   "missing": [], "others": set(), "total": 0}
    for relative in managed_paths(root):
        state["total"] += 1
        target = HOME / relative
        if target.is_symlink():
            if points_into(target, tree):
                if target.exists():
                    state["linked"] += 1
                else:
                    state["broken"].append(relative)
                continue
            hop = link_hop(target)
            suffix = f"/desktop/{relative}"
            if hop is not None and str(hop).endswith(suffix) and target.exists():
                state["other"].append(relative)
                state["others"].add(str(hop)[: -len(suffix)])
            else:
                state["broken"].append(relative)
        elif target.exists():
            state["plain"].append(relative)
        else:
            state["missing"].append(relative)
    return state


def dangling_repo_links(root: Path) -> list[Path]:
    """Symlinks into this checkout whose target no longer exists.

    The gap no restow can close, and the reason this function exists at all:
    bootstrap's pre-stow scan walks the paths the checkout manages *now*, so a
    file deleted from the repository between two versions is not in the set
    being scanned, and `stow --restow` only unlinks what the package still
    contains. The link is left behind pointing at nothing, and it will outlive
    every later update.

    Found from the other direction instead -- walk $HOME, keep the links that
    point into this checkout and no longer resolve -- which needs no record of
    what the previous version shipped.

    Two properties matter and are load-bearing:

      * The search is scoped to SCAN_ROOTS. $HOME is full of symlinks that
        dangle legitimately (Chrome's SingletonLock, Discord's IPC sockets), and
        a sweep that considered them would eventually delete one.
      * The target must resolve into *this* checkout. A dangling link into
        another Garage clone is that clone's business, and the restow re-points
        it anyway.

    os.walk does not follow symlinked directories, so a dangling directory link
    is reported rather than descended into.
    """
    tree = root / "desktop"
    found: list[Path] = []
    seen: set[Path] = set()
    for scan_root in SCAN_ROOTS:
        if not scan_root.is_dir():
            continue
        for parent, directories, files in os.walk(scan_root):
            here = Path(parent)
            for name in directories + files:
                path = here / name
                if path in seen or not path.is_symlink():
                    continue
                seen.add(path)
                # exists() follows the link: False on a symlink is precisely
                # "the target is not there".
                if path.exists():
                    continue
                if points_into(path, tree):
                    found.append(path)
    return sorted(found)


def hyprland_report() -> str:
    """`Hyprland --version` output, or "" when the binary is not installed.

    Read from the binary rather than from `hyprctl`, so it answers on a TTY with
    no compositor running -- which is where a `garage doctor` after a failed
    login is run.
    """
    probe = run(["Hyprland", "--version"], timeout=10)
    return probe.stdout if probe.returncode == 0 else ""


def hyprland_version(report: str) -> str:
    for pattern in (r"^Hyprland\s+v?(\d+\.\d+(?:\.\d+)?)", r"^Tag:\s*v?(\d+\.\d+(?:\.\d+)?)"):
        match = re.search(pattern, report, re.M)
        if match:
            return match.group(1)
    return ""


def hyprland_abi(report: str) -> str:
    match = re.search(r"^Version ABI string:\s*(\S+)", report, re.M)
    return match.group(1) if match else ""


def deployed_plugin_abi(name: str) -> str:
    """Which ABI directory a stable plugin symlink resolves into, or "".

    One hop only, like garage-rebuild-plugins' own deployed_abi(): the link is
    absolute and resolving further would follow the .so out of the tree.
    """
    hop = link_hop(PLUGIN_ROOT / f"{name}.so")
    if hop is None or hop.suffix != ".so" or hop.parent.parent != PLUGIN_ROOT:
        return ""
    return hop.parent.name


def plugin_state(report: str) -> dict:
    """The live ABI comparison garage-rebuild-plugins --check makes.

    Reimplemented here rather than shelled out to, which is a deliberate choice
    and not a duplication for its own sake. --check is built to be run
    unattended from a login unit: it exits 0 whether or not the plugins are
    stale (a red unit in the session is worse than a quiet one), and when they
    are stale it raises a sticky desktop notification. Neither behaviour belongs
    in a read-only health check or in update's skip decision -- one gives no
    answer to interpret, the other has a side effect on the user's screen. What
    it actually does is four readlinks and a string compare, all of which are
    read-only and none of which are worth a subprocess.

    "Never deployed here" is kept apart from "stale" for the reason that script
    documents: Glass's source is not published, so most machines have no plugins
    at all and are not behind on anything.
    """
    abi = hyprland_abi(report)
    deployed = {name: deployed_plugin_abi(name) for name in PLUGIN_NAMES}
    ever = any(PLUGIN_ROOT.glob("*/*.so"))
    stale = [name for name, where in deployed.items()
             if where != abi or not (PLUGIN_ROOT / f"{name}.so").exists()]
    return {"abi": abi, "deployed": deployed, "ever": ever,
            "stale": [] if not abi else stale}


def session_is_up() -> bool:
    """Whether a graphical session is running for this user.

    graphical-session.target rather than a hyprctl probe: hyprctl needs
    HYPRLAND_INSTANCE_SIGNATURE, which is exported into the session's own
    processes and is absent from an SSH login or a TTY shell on the same
    machine. Asking systemd is the question that does not depend on where the
    command was typed.
    """
    return run(["systemctl", "--user", "is-active",
                "graphical-session.target"]).stdout.strip() == "active"


# ---------------------------------------------------------------------------
# doctor
#
# A check is (label, probe), where probe() returns (status, detail, hint):
#
#   ok    -- healthy.
#   note  -- true, reported, and not a problem: a machine with no plugins
#            deployed, a home that has never rendered, a session that is not
#            running because this is a TTY. Exit status ignores these, because
#            a health check that fails on a TTY is a health check nobody runs.
#   fail  -- a real problem. The hint says what to do about it.
#
# The probes return their verdict rather than printing it so that Phase 5's
# `doctor --report` can serialize this same list.
# ---------------------------------------------------------------------------


def check_hyprland() -> tuple[str, str, str]:
    version = hyprland_version(hyprland_report())
    if not version:
        return ("fail", "Hyprland is not installed, or does not report a version",
                "sudo pacman -S --needed hyprland")
    if version_parts(version) < version_parts(MINIMUM_HYPRLAND):
        return ("fail", f"{version} is below the {MINIMUM_HYPRLAND} support floor",
                "sudo pacman -Syu hyprland")
    return "ok", f"{version} (floor {MINIMUM_HYPRLAND})", ""


def check_packages() -> tuple[str, str, str]:
    probe = run(["pacman", "-Q", *DOCTOR_PACKAGES], timeout=15)
    present = {line.split(" ", 1)[0] for line in probe.stdout.splitlines() if line}
    missing = [name for name in DOCTOR_PACKAGES if name not in present]
    if missing:
        return ("fail", f"not installed: {', '.join(missing)}",
                f"sudo pacman -S --needed {' '.join(missing)}")
    return "ok", f"all {len(DOCTOR_PACKAGES)} key packages installed", ""


def check_fonts() -> tuple[str, str, str]:
    if not shutil.which("fc-list"):
        return "note", "fontconfig is not installed, so nothing can be checked", ""
    probe = run(["fc-list", ":", "family"], timeout=15)
    families = {name.strip() for line in probe.stdout.splitlines()
                for name in line.split(",")}
    missing = [name for name in DOCTOR_FONTS if name not in families]
    if missing:
        return ("fail", f"fontconfig cannot find: {', '.join(missing)}",
                "sudo pacman -S --needed ttf-ibm-plex && fc-cache -f")
    return "ok", f"{', '.join(DOCTOR_FONTS)} present", ""


def check_stow(root: Path) -> tuple[str, str, str]:
    state = stow_state(root)
    problems = ([f"broken ~/{name}" for name in state["broken"]]
                + [f"not a link ~/{name}" for name in state["plain"]]
                + [f"missing ~/{name}" for name in state["missing"]])
    if problems:
        shown = ", ".join(problems[:10])
        if len(problems) > 10:
            shown += f", and {len(problems) - 10} more"
        return ("fail",
                f"{state['linked']}/{state['total']} paths link here; "
                f"{len(problems)} problem(s): {shown}",
                "garage update  (or ./bootstrap.sh, which backs up anything in the way)")
    if state["other"]:
        # Not a failure: the desktop is fully linked and working, just from
        # another clone of the same tree. Worth saying out loud, because
        # editing this checkout would then change nothing on screen.
        return ("note",
                f"{len(state['other'])}/{state['total']} paths link into another checkout "
                f"({', '.join(sorted(state['others']))}) rather than this one",
                "garage update  (restows from this checkout)")
    return "ok", f"{state['total']} managed paths resolve into this checkout", ""


def check_dangling(root: Path) -> tuple[str, str, str]:
    stale = dangling_repo_links(root)
    if not stale:
        return "ok", "no links point at files this checkout no longer has", ""
    shown = ", ".join(tilde(path) for path in stale[:10])
    if len(stale) > 10:
        shown += f", and {len(stale) - 10} more"
    return ("fail", f"{len(stale)} link(s) point at deleted files: {shown}",
            "garage update  (sweeps them; a restow cannot)")


def check_units() -> tuple[str, str, str]:
    session = session_is_up()
    disabled, stopped = [], []
    for unit, expect_active in DOCTOR_UNITS:
        if run(["systemctl", "--user", "is-enabled", unit]).stdout.strip() not in {
                "enabled", "enabled-runtime"}:
            disabled.append(unit)
            continue
        if session and expect_active and run(
                ["systemctl", "--user", "is-active", unit]).stdout.strip() != "active":
            stopped.append(unit)
    if disabled:
        return ("fail", f"not enabled: {', '.join(disabled)}",
                f"systemctl --user enable {' '.join(disabled)}")
    if stopped:
        return ("fail", f"enabled but not running: {', '.join(stopped)}",
                f"systemctl --user status {stopped[0]}")
    if not session:
        return ("note", f"all {len(DOCTOR_UNITS)} units enabled; "
                "no graphical session here, so nothing is expected to be running", "")
    return "ok", f"all {len(DOCTOR_UNITS)} units enabled and running", ""


def check_plugins() -> tuple[str, str, str]:
    state = plugin_state(hyprland_report())
    if not state["abi"]:
        return "note", "Hyprland reports no ABI string, so nothing can be compared", ""
    build = state["abi"].split("_")[0][:12]
    if not state["ever"]:
        return ("note", f"no plugins have ever been deployed here "
                f"(running build {build}); the desktop runs without them", "")
    if state["stale"]:
        return ("fail",
                f"{', '.join(state['stale'])} not built for the running build {build}",
                "~/.config/hypr/scripts/garage-rebuild-plugins")
    return "ok", f"{', '.join(PLUGIN_NAMES)} built for the running build {build}", ""


def check_fragments() -> tuple[str, str, str]:
    if not GENERATED.is_dir():
        return ("note", f"{tilde(GENERATED)} does not exist yet; "
                "nothing has rendered on this machine", "")
    fragments = sorted(GENERATED.glob("*.lua"))
    if not fragments:
        return "note", "no Lua fragments have been rendered yet", ""
    if not shutil.which("luac"):
        return "note", f"{len(fragments)} fragment(s) present; luac is not installed to check them", ""
    broken = [path.name for path in fragments
              if run(["luac", "-p", str(path)]).returncode != 0]
    if broken:
        return ("fail", f"will not parse: {', '.join(broken)}",
                "garage render  (rewrites every fragment from your preferences)")
    return "ok", f"{len(fragments)} Lua fragment(s) parse", ""


def check_preferences() -> tuple[str, str, str]:
    notes: list[str] = []
    try:
        load_preferences(sink=notes)
    except (SettingsError, OSError) as error:
        return ("fail", f"cannot be loaded: {error}",
                f"fix or move aside {tilde(PREFERENCES_PATH)}, then run garage render")
    if notes:
        shown = "; ".join(notes[:3])
        if len(notes) > 3:
            shown += f"; and {len(notes) - 3} more"
        # Not a failure by design: validate_preferences() puts the shipped
        # default over anything it cannot render and says so, and the corrected
        # value reaches the file on the next save. A note may also be a key this
        # build has no preference for, dropped from the file -- hence "note(s)"
        # rather than "value(s) coerced". Nothing is broken now either way.
        return "note", f"loads, with {len(notes)} note(s): {shown}", ""
    return "ok", "loads with every value in range", ""


def check_compositor() -> tuple[str, str, str]:
    probe = run(["hyprctl", "version"])
    if probe.returncode != 0:
        # Informational on purpose. `doctor` is most useful from a TTY after a
        # login that did not come up, and there is no compositor to reach from
        # there -- reporting that as a fault would make the report useless in
        # exactly the situation it exists for.
        return ("note", "no compositor answers here "
                "(a TTY or SSH shell has no HYPRLAND_INSTANCE_SIGNATURE)", "")
    return "ok", "hyprctl reaches the running compositor", ""


def doctor_checks(root: Path) -> list[tuple[str, object]]:
    return [
        ("hyprland", check_hyprland),
        ("packages", check_packages),
        ("fonts", check_fonts),
        ("stow links", lambda: check_stow(root)),
        ("dead links", lambda: check_dangling(root)),
        ("units", check_units),
        ("plugins", check_plugins),
        ("fragments", check_fragments),
        ("preferences", check_preferences),
        ("compositor", check_compositor),
    ]


def doctor(argv: list[str]) -> int:
    """Read-only health report. 0 when healthy, 1 when something is wrong."""
    if argv:
        raise SettingsError(f"Usage: garage doctor  (unexpected argument: {argv[0]})")
    root = checkout_root()
    print(f"Garage doctor\n  checkout  {root}\n  home      {HOME}\n")
    checks = doctor_checks(root)
    width = max(len(name) for name, _ in checks)
    failures = 0
    for name, probe in checks:
        status, detail, hint = probe()
        if status == "fail":
            failures += 1
        label = {"ok": "ok  ", "note": "note", "fail": "FAIL"}[status]
        print(f"  {label}  {name.ljust(width)}  {detail}")
        if status == "fail" and hint:
            print(f"        {' ' * width}  -> {hint}")
    if failures:
        print(f"\n{failures} problem(s) found.")
        return 1
    print("\nNo problems found.")
    return 0


# ---------------------------------------------------------------------------
# update
#
# Design: pull, sweep, then delegate to bootstrap.sh. Not a native Python
# reimplementation, and the choice is not close.
#
# What an update has to do on rolling Arch is make this machine match the
# checkout again: install packages the list has gained, enable units it has
# gained, write per-user files that are new, put every link back, and leave the
# user's own files alone. bootstrap.sh already does all of that, idempotently
# and by design -- the freshness gate short-circuits on an install it can see
# (garage_already_installed), packages go in with --needed, `systemctl enable`
# is bookkeeping, the generated files are written only when absent, and every
# mutating call goes through one run() chokepoint that --dry-run turns off. It
# is also the only path exercised by the clean-install rehearsal.
#
# A native implementation would have to duplicate the part that is genuinely
# hard: the pre-stow scan that classifies every managed path, moves real files
# into a timestamped backup and deletes links from a moved checkout. Without it,
# `stow --restow` aborts on the first tracked file that has become a real file
# and leaves a half-linked home. With it, two implementations of the same
# careful logic drift apart, and the one this file would carry is the one no
# rehearsal covers. The failure surface argument runs the same way: bootstrap
# fails loudly at a step boundary, and a second implementation doubles the
# number of places that can be wrong.
#
# What delegation costs, honestly:
#
#   * bootstrap prints for a TTY -- steps, warnings, a summary. Acceptable here
#     precisely because `garage update` is a TTY command too; its output is not
#     parsed by anything and the QML client never calls it.
#   * a re-run includes `sudo pacman -Syu`, so update asks for sudo and can
#     upgrade the whole system. That is not a wart to design around: installing
#     newly listed packages on Arch without a full upgrade first is a partial
#     upgrade, which is unsupported. It is stated up front instead.
#
# Two things update keeps for itself, because bootstrap cannot answer them:
#
#   1. The dead-link sweep (see dangling_repo_links), which needs to know what
#      the checkout no longer ships -- the one thing a scan of the current
#      manifest cannot see.
#   2. The plugin decision. bootstrap deploys unconditionally, which is right
#      for an install and wrong for an update: the deploy needs sudo and rebuilds
#      pointlessly when the ABI has not moved. update compares the running ABI
#      against what is deployed itself and passes GARAGE_SKIP_PLUGIN_DEPLOY=1 so
#      bootstrap does not do it twice.
# ---------------------------------------------------------------------------


def git_output(root: Path, *arguments: str, timeout: float = 30) -> tuple[int, str]:
    probe = run(["git", "-C", str(root), *arguments], timeout=timeout)
    return probe.returncode, probe.stdout.strip()


def pull_checkout(root: Path, dry_run: bool) -> tuple[list[str], list[str]]:
    """Fast-forward the checkout onto its upstream, and say what happened.

    Returns (report lines, problems). Separated from update() so it can be
    exercised against a scratch repository with a real upstream: every install
    today is local-only, so nothing on this machine can reach the branch below.

    Never raises, and treats every reason it cannot pull as a note rather than a
    failure. An update that refused to relink because a remote is missing or
    unreachable would be useless on the machines Garage actually runs on.
    """
    lines: list[str] = []
    problems: list[str] = []
    prefix = "[dry-run] " if dry_run else ""
    if not (root / ".git").exists():
        return ["not a git checkout, so there is nothing to pull."], problems
    code, upstream = git_output(root, "rev-parse", "--abbrev-ref",
                               "--symbolic-full-name", "@{upstream}")
    if code != 0 or not upstream:
        # The normal case today: Garage's repositories are local-only, so there
        # is no origin to pull from.
        return (["no upstream configured, skipping pull; continuing with the local tree."],
                problems)
    lines.append(f"upstream  {upstream}")
    # Allowed in a dry run: fetch writes only to .git's own object store and
    # remote refs, never to the working tree or to $HOME, and without it there is
    # no honest answer to "what would this pull in".
    if run(["git", "-C", str(root), "fetch", "--quiet"], timeout=120).returncode != 0:
        lines.append(f"could not fetch from {upstream.split('/')[0]}; "
                     "continuing with the local tree.")
        return lines, problems
    incoming = git_output(root, "log", "--oneline", f"HEAD..{upstream}")[1]
    if not incoming:
        lines.append(f"already up to date with {upstream}.")
        return lines, problems
    commits = incoming.splitlines()
    if dry_run:
        lines.append(f"{prefix}would fast-forward {len(commits)} commit(s):")
        lines += [f"      {line}" for line in commits[:20]]
        if len(commits) > 20:
            lines.append(f"      and {len(commits) - 20} more")
        return lines, problems
    if git_output(root, "status", "--porcelain")[1]:
        # The working tree belongs to whoever is editing it. A merge across local
        # changes is exactly the operation that loses work, so it is refused
        # rather than forced.
        lines.append(f"{len(commits)} commit(s) waiting, but the checkout has local changes;")
        lines.append("skipping the merge. Commit or stash them and re-run.")
        problems.append("pull skipped: the checkout has local changes")
        return lines, problems
    merged = run(["git", "-C", str(root), "merge", "--ff-only", upstream], timeout=60)
    if merged.returncode != 0:
        lines.append(f"could not fast-forward onto {upstream}:")
        lines.append(f"      {merged.stderr.strip() or merged.stdout.strip()}")
        problems.append(f"pull failed: cannot fast-forward onto {upstream}")
        return lines, problems
    head = git_output(root, "rev-parse", "--short", "HEAD")[1]
    lines.append(f"fast-forwarded {len(commits)} commit(s) to {head}.")
    return lines, problems


def update(argv: list[str]) -> int:
    dry_run = False
    for argument in argv:
        if argument == "--dry-run":
            dry_run = True
        else:
            raise SettingsError(f"Usage: garage update [--dry-run]  (unexpected: {argument})")

    def step(text: str) -> None:
        print(f"\n==> {text}")

    def info(text: str) -> None:
        print(f"    {'[dry-run] ' if dry_run else ''}{text}")

    def note(text: str) -> None:
        print(f"    {text}")

    root = checkout_root()
    problems: list[str] = []
    print(f"Garage update{' (dry run: nothing will be changed)' if dry_run else ''}")
    note(f"checkout  {root}")
    note(f"home      {HOME}")

    # ---- 1. the checkout itself -------------------------------------------
    step("Updating the checkout")
    before = git_output(root, "rev-parse", "HEAD")[1]
    lines, pull_problems = pull_checkout(root, dry_run)
    for line in lines:
        note(line)
    problems += pull_problems
    after = git_output(root, "rev-parse", "HEAD")[1]

    # ---- 2. links to files the update deleted ------------------------------
    step("Sweeping links to files this checkout no longer ships")
    stale = dangling_repo_links(root)
    if not stale:
        note("none found.")
    for path in stale:
        info(f"remove {tilde(path)} -> {os.readlink(path)}")
        if not dry_run:
            try:
                path.unlink()
            except OSError as error:
                note(f"could not remove {tilde(path)}: {error}")
                problems.append(f"could not remove {tilde(path)}")
    if stale and not dry_run:
        note(f"removed {len(stale)} dangling link(s).")

    # ---- 3. bootstrap ------------------------------------------------------
    step("Converging this machine on the checkout")
    script = root / "bootstrap.sh"
    if not script.is_file():
        raise SettingsError(f"{script} is missing; this checkout cannot converge itself")
    environment = os.environ.copy()
    # update owns the plugin decision; see the plugin step below.
    environment["GARAGE_SKIP_PLUGIN_DEPLOY"] = "1"
    if stow_state(root)["other"]:
        # Garage is demonstrably installed here, just from another clone, so the
        # freshness gate would refuse for the wrong reason: it looks for a link
        # into *this* checkout. Forcing is safe because the evidence of an
        # existing install is in hand; it is not forced when nothing is linked,
        # which is a first install and the gate's actual job.
        environment["GARAGE_FORCE"] = "1"
        note("this home is linked to another checkout; re-pointing it here.")
    command = [str(script)] + (["--dry-run"] if dry_run else [])
    note(f"running {' '.join(shlex.quote(part) for part in command)}")
    if not dry_run:
        note("it will ask for sudo: a re-run upgrades the system and installs any")
        note("package the list has gained since this machine was set up.")
    # Not through run(): this streams to the terminal, both because the output
    # is a progress report and because pacman's sudo prompt needs the tty. Our
    # own stdout is flushed first -- redirected to a file it is block-buffered,
    # and the child writes straight to the descriptor, so without this the whole
    # report lands after the bootstrap output it introduces.
    sys.stdout.flush()
    bootstrap = subprocess.run(command, cwd=str(root), env=environment, check=False)
    if bootstrap.returncode != 0:
        print(f"\ngarage update: bootstrap.sh exited {bootstrap.returncode}; "
              "stopping here rather than reloading a half-converged desktop.")
        return 1

    # ---- 4. migrations and the generated state -----------------------------
    step("Rendering the generated state")
    if dry_run:
        info("would load the preferences (running any schema migration) and render")
    else:
        # The load is the migration: migrate_preferences() is version-gated and
        # runs inside load_preferences(), so a pull that bumped the schema is
        # applied here. The corrected file itself is written on the next save,
        # which is the same contract every other command works under.
        preferences = load_preferences()
        render_all(preferences)
        # render_all() only writes files now. These three are what it used to
        # push from inside itself, and an update still owes them: the toolkit
        # configs it just rewrote are half a theme until the portal setting,
        # xsettingsd and the two signalled clients agree with them. The
        # compositor's own reload is step 6, which knows how to skip a TTY.
        push_accent(preferences)
        push_corner_radius(preferences)
        push_theme(preferences)
        note(f"rewrote the fragments under {tilde(GENERATED)}.")

    # ---- 5. plugins --------------------------------------------------------
    step("Checking the Hyprland plugin ABI")
    state = plugin_state(hyprland_report())
    pins_changed = False
    if before and after and before != after:
        pins_changed = bool(git_output(root, "diff", "--name-only", f"{before}..{after}",
                                       "--", "system/plugin-pins")[1])
    if not state["abi"]:
        note("Hyprland reports no ABI string; skipping.")
    elif not state["ever"]:
        note("no plugins have ever been deployed here; skipping.")
    elif not state["stale"] and not pins_changed:
        note(f"{', '.join(PLUGIN_NAMES)} are in step with the running build "
             f"{state['abi'].split('_')[0][:12]}; skipping the rebuild.")
    else:
        reason = ("a pin moved in this update" if pins_changed
                  else f"not built for the running build: {', '.join(state['stale'])}")
        note(f"redeploy needed ({reason}).")
        rebuild = HOME / ".config/hypr/scripts/garage-rebuild-plugins"
        if not rebuild.is_file():
            rebuild = root / "desktop/.config/hypr/scripts/garage-rebuild-plugins"
        info(f"run {rebuild}")
        if not dry_run:
            # Streamed and interactive for the same reasons as bootstrap: it
            # installs into /usr/lib and asks for sudo once.
            sys.stdout.flush()
            if subprocess.run([str(rebuild)], check=False).returncode != 0:
                note("the plugin rebuild failed; the desktop runs without them.")
                problems.append("plugin rebuild failed")

    # ---- 6. reload ---------------------------------------------------------
    step("Reloading Hyprland")
    if dry_run:
        info("would run hyprctl reload")
    elif run(["hyprctl", "version"]).returncode != 0:
        note("no compositor answers here; skipping the reload.")
        note("the new configuration is picked up at your next login.")
    elif run(["hyprctl", "reload"]).returncode != 0:
        note("hyprctl reload failed; the new configuration lands at your next login.")
        problems.append("hyprctl reload failed")
    else:
        note("reloaded.")

    print()
    if problems:
        print("Update finished with problems:")
        for problem in problems:
            print(f"  - {problem}")
        return 1
    print("Dry run complete. Nothing above was changed." if dry_run
          else "Update complete.")
    return 0


def response(data: object = None, error: str = "") -> None:
    print(json.dumps({"ok": not error, "data": data, "error": error}, separators=(",", ":")))


USAGE = """Usage: garage [COMMAND [ARGUMENTS]]

Human commands:
  doctor                  check this install and report what is wrong (exit 1 if any)
  update [--dry-run]      pull, sweep dead links, re-converge on the checkout, reload
  help                    print this

Settings backend (each prints one JSON object: {"ok","data","error"}):
  snapshot                the whole live state, and the default with no command
  render                  rewrite every generated fragment (files only, applies nothing)
  render-idle             rewrite hypridle.conf only (hypridle's ExecStartPre)
  render-bar              rewrite the bar's fragments only (waybar's ExecStartPre)
  render-wallpaper        rewrite hyprpaper.conf only (hyprpaper's ExecStartPre)
  apply                   render, then push everything into the running session
  set KEY JSON_VALUE      write one preference and apply just that change
  action NAME [JSON]      run a one-shot action (volume, dnd, keybind.*, defaults.*)
  display-test JSON       apply a display layout for 15s, pending confirmation
  display-confirm TOKEN   keep the layout under test
  display-revert TOKEN    put the previous layout back
  theme-sync              switch light/dark if the schedule says so (timer)
  night-shift-sync        re-evaluate the night shift window (timer)
"""

# The two commands that answer a person rather than the QML client, so their
# output is lines and their failures are stderr -- never the JSON envelope
# response() prints, which nothing at a terminal would want to read.
PLAIN_COMMANDS = {"doctor": doctor, "update": update}


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 else "snapshot"
    if command in {"help", "-h", "--help"}:
        print(USAGE, end="")
        return 0
    if command in PLAIN_COMMANDS:
        try:
            migrate_config_root()
            return PLAIN_COMMANDS[command](argv[2:])
        except (SettingsError, OSError, ValueError) as error:
            print(f"garage {command}: {error}", file=sys.stderr)
            return 1
    try:
        # Once per process, ahead of the dispatch rather than inside a loader:
        # `action keybind.rebind` and `display-test` reach keybindings.toml and
        # displays.toml without ever loading the preferences, and either one
        # arriving first would write a fresh file at the new path while the
        # user's own was still sitting at the old one.
        migrate_config_root()
        if command == "snapshot":
            response(make_snapshot())
        elif command == "render":
            # Files only. Every fragment is rewritten and nothing is signalled:
            # see render_all(). `apply` is the one that also moves the session.
            render_all(load_preferences())
            response(True)
        elif command == "render-idle":
            # hypridle's ExecStartPre. One file, which is all hypridle reads --
            # and all it may render, because `set lock.*` restarts that unit
            # synchronously while holding PREFERENCES_LOCK. See render_idle().
            render_idle(load_preferences())
            response(True)
        elif command == "render-bar":
            # waybar's modules-left now lives only in the generated fragment, so
            # the bar comes up with an empty left side if it starts before the
            # first render. Its unit runs this first; narrow rather than a full
            # render, which would rewrite a dozen toolkit configs the bar does
            # not read. Nothing is signalled: the unit starts the bar right
            # after, and it reads these on the way up.
            config = load_preferences()
            render_region(config)
            render_bar_workspaces(config)
            response(True)
        elif command == "render-wallpaper":
            # hyprpaper's ExecStartPre. Deliberately not "render": that rewrites
            # a dozen toolkit configs, which is wasteful to chain onto a second
            # unit at session start. Nothing is signalled here either -- the unit
            # starts hyprpaper next, which reads the file it just wrote.
            render_wallpaper(load_preferences())
            response(True)
        elif command == "apply":
            apply_preferences(load_preferences())
            response(True)
        elif command == "set":
            if len(argv) != 4:
                raise SettingsError("Usage: garage set KEY JSON_VALUE")
            # One process per wheel tick: the UI's sliders fire a set per notch,
            # so several of these run at once. Each reads the whole file and
            # rewrites it whole, and unserialised the last writer wins with a
            # copy that predates its neighbours' keys. Applying under the same
            # lock keeps the live state in step with the file rather than letting
            # a stale apply land last.
            PREFERENCES_LOCK.parent.mkdir(parents=True, exist_ok=True)
            with PREFERENCES_LOCK.open("a+", encoding="utf-8") as lock:
                fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
                config = load_preferences()
                set_nested(config, argv[2], json.loads(argv[3]))
                validate_preferences(config)
                save_preferences(config)
                apply_changed_preference(config, argv[2])
            response(config)
        elif command == "action":
            value = json.loads(argv[3]) if len(argv) > 3 else None
            action(argv[2], value)
            response(True)
        elif command == "display-test":
            response({"token": display_test(json.loads(argv[2]))})
        elif command == "display-confirm":
            display_finish(argv[2], True)
            response(True)
        elif command == "display-revert":
            display_finish(argv[2], False)
            response(True)
        elif command == "_display-watchdog":
            time.sleep(15)
            try:
                display_finish(argv[2], False)
            except (SettingsError, OSError, json.JSONDecodeError):
                pass
        elif command == "theme-sync":
            config = load_preferences()
            # Same gate as the manual theme_* path: an unchanged scheme means
            # every output would be byte-identical, so rewriting a dozen
            # toolkit configs and reloading Hyprland would only make the
            # desktop visibly flicker every five minutes for nothing.
            if resolve_theme(config) != applied_scheme():
                apply_theme(config)
                render_preferences(config)
                run(["hyprctl", "reload"])
            response(resolve_theme(config))
        elif command == "night-shift-sync":
            apply_night_shift(load_preferences())
            response(night_shift_active(load_preferences()))
        else:
            raise SettingsError(f"Unknown command: {command}")
        return 0
    except (SettingsError, OSError, ValueError, json.JSONDecodeError) as error:
        response(error=str(error))
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
