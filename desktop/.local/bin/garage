    # libinput's own range, and its own two profiles.
    "input.pointer_sensitivity": {
        "default": 0.0, "kind": "float", "minimum": -1, "maximum": 1,
        "route": "input",
    },
    "input.accel_profile": {
        "default": "flat", "kind": "enum", "members": {"flat", "adaptive"},
