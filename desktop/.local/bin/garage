style=Fusion

[Fonts]
fixed="CaskaydiaMono Nerd Font Mono,10,-1,5,50,0,0,0,0,0"
general="IBM Plex Sans,10,-1,5,50,0,0,0,0,0"
''')


def apply_search_engine(config: dict) -> None:
    """Publish the resolved search URL template.

    The launcher reads a resolved template, so it never has to know the engine
    list or how a custom entry is stored. This is the whole of what a search
    change needs: it touches no palette, so it must not drag in apply_theme.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    engine = str(config["appearance"]["search_engine"])
    template = (str(config["appearance"].get("search_custom_url") or "")
                if engine == "custom" else SEARCH_ENGINES[engine])
    write_marker(SEARCH_FILE, (template or SEARCH_ENGINES["google"]) + "\n")


def application_dirs() -> list[Path]:
    data_dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    home = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
    return [home / "applications"] + [Path(item) / "applications"
                                      for item in data_dirs.split(":") if item]


def desktop_file(desktop_id: str) -> Path | None:
    """Where a desktop id resolves in XDG lookup order, or None if nowhere."""
    for directory in application_dirs():
        candidate = directory / desktop_id
        if candidate.is_file():
            return candidate
    return None


def desktop_fields(desktop_id: str) -> dict[str, str]:
    """The [Desktop Entry] keys of a desktop file.

    Read by hand rather than with configparser: an Exec value carries % and ;
    that configparser's interpolation fights, and a desktop file legitimately
    repeats a key in localised forms that would raise there.
    """
    path = desktop_file(desktop_id)
    if path is None:
        return {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return {}
    fields: dict[str, str] = {}
    section = ""
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            section = stripped
        elif section == "[Desktop Entry]" and "=" in stripped and not stripped.startswith("#"):
            key, value = stripped.split("=", 1)
            fields.setdefault(key.strip(), value.strip())
    return fields


def mime_handlers(mimetype: str) -> tuple[str, list[str]]:
    """The current default and every registered application for a mimetype.

    gio rather than the mimeinfo caches directly: it resolves the whole XDG
    lookup -- desktop-prefixed lists, config dirs, then data dirs -- exactly as
    the application that will open the file does. Run under C so the section
    headers this parses by cannot be translated out from under it.
    """
    result = run(["env", "LC_ALL=C", "gio", "mime", mimetype])
    default, registered, listing = "", [], False
    for line in result.stdout.splitlines():
        if line.startswith("\t"):
            if listing:
                registered.append(line.strip())
        elif line.startswith("Default application for"):
            # "No default applications for ..." misses this on purpose: it is
            # the answer for a mimetype nothing has claimed.
            default = line.rsplit(": ", 1)[-1].strip()
        else:
            listing = line.startswith("Registered applications")
    return default, registered


def role_applications(types: tuple[str, ...]) -> tuple[str, list[str]]:
    """A role's current handler and the applications that can take it over.

    A candidate has to register for every type the role owns, because selecting
    it writes every one of them. The union would offer a text editor as the web
    browser -- editors claim text/html, which the browser role also owns -- and
    then hand it the https scheme it cannot open.

    Deduplicated by display name: one application can ship two desktop files --
    Chrome installs both com.google.Chrome.desktop and google-chrome.desktop --
    and a combo offering "Google Chrome" twice gives no way to tell them apart.
    The entry already in force keeps its name, so the list always contains it.
    """
    current = ""
    by_name: dict[str, str] = {}
    for index, mimetype in enumerate(types):
        default, registered = mime_handlers(mimetype)
        if index == 0:
            current = default
        offered: dict[str, str] = {}
        for desktop_id in registered:
            fields = desktop_fields(desktop_id)
            name = fields.get("Name")
            # NoDisplay is the application saying it is not something to pick:
            # kitty's URL handler registers for inode/directory but is no file
            # manager, and nothing that hides from the menus belongs in a combo.
            if not name or fields.get("NoDisplay", "").lower() == "true":
                continue
            if name not in offered or desktop_id == current:
                offered[name] = desktop_id
        by_name = offered if index == 0 else {
            name: desktop_id for name, desktop_id in by_name.items() if name in offered}
    candidates = [desktop_id for _, desktop_id in sorted(by_name.items())]
    if current and current not in candidates:
        # The handler in force can be a desktop id that hides itself: Chrome
        # ships com.google.Chrome.desktop as a NoDisplay alias of the entry the
        # menus show. Report the visible entry standing for the same
        # application, and only offer the id itself when nothing does -- a
        # default the pane cannot show is one it would silently replace on the
        # next selection.
        replacement = by_name.get(desktop_fields(current).get("Name", ""))
        if replacement:
            current = replacement
        elif desktop_file(current):
            candidates.insert(0, current)
    return current, candidates


def terminal_candidates() -> list[str]:
    """Every installed terminal emulator, by desktop id.

    There is no mimetype for "a terminal", so the freedesktop category is the
    only registry there is. NoDisplay entries are skipped: kitty ships a second
    one that exists only to open URLs, and it is not a terminal to launch.
    """
    ids = {path.name for directory in application_dirs() if directory.is_dir()
           for path in directory.glob("*.desktop")}
    by_name: dict[str, str] = {}
    for desktop_id in sorted(ids):
        fields = desktop_fields(desktop_id)
        if ("TerminalEmulator" in fields.get("Categories", "")
                and fields.get("NoDisplay", "").lower() != "true"):
            by_name.setdefault(fields.get("Name", desktop_id), desktop_id)
    return [desktop_id for _, desktop_id in sorted(by_name.items())]


def resolve_terminal(config: dict) -> str:
    """The terminal in force: the chosen one for as long as it is installed."""
    candidates = terminal_candidates()
    chosen = str(config.get("general", {}).get("terminal", ""))
    return chosen if chosen in candidates else (candidates[0] if candidates else "")


def terminal_command(config: dict) -> str:
    return EXEC_FIELD_CODES.sub("", desktop_fields(resolve_terminal(config)).get("Exec", ""))


def browser_command() -> str:
    """The default browser as a command that opens with no arguments.

    $BROWSER is xdg-open, which is right for anything handing it a URL and
    useless as a bare keybinding -- it exits having been given nothing to open.
    So the bind gets the browser's own Exec instead, resolved from whatever is
    currently registered rather than stored a second time.
    """
    desktop_id, _ = role_applications(DEFAULT_APP_ROLES["browser"])
    if not desktop_id:
        return ""
    return EXEC_FIELD_CODES.sub("", desktop_fields(desktop_id).get("Exec", "")).strip()


def write_mime_defaults(assignments: dict[str, str]) -> None:
    """Point mimetypes at a desktop id in the desktop-prefixed mimeapps list.

    Only [Default Applications] is kept: this file is written here and read by
    the spec's lookup, and an association or a removal belongs in the tracked
    mimeapps.list that it overrides rather than in generated output.
    """
    entries: dict[str, str] = {}
    section = ""
    try:
        lines = MIMEAPPS_OVERRIDE.read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            section = stripped
        elif section == "[Default Applications]" and "=" in stripped and not stripped.startswith("#"):
            key, value = stripped.split("=", 1)
            entries[key.strip()] = value.strip()
    entries.update(assignments)
    atomic_write(MIMEAPPS_OVERRIDE,
                 "# Generated by garage. Overrides mimeapps.list.\n"
                 "[Default Applications]\n"
                 + "".join(f"{key}={value}\n" for key, value in sorted(entries.items()) if value))


def set_default_app(role: str, desktop_id: str) -> None:
    if role not in DEFAULT_APP_ROLES:
        raise SettingsError(f"Unknown default application: {role}")
    if not desktop_file(desktop_id):
        raise SettingsError(f"{desktop_id} is not installed")
    write_mime_defaults({mimetype: desktop_id for mimetype in DEFAULT_APP_ROLES[role]})
    if role == "browser":
        write_marker(BROWSER_FILE, browser_command() + "\n")
        run(["hyprctl", "reload"])


def render_general(config: dict) -> None:
    """Publish what the keybindings read, as markers rather than preferences.

    Both are read on a keypress: the launcher wrapper runs on every SUPER+Space,
    and Hyprland parses binds.lua with no way to shell out to this helper. A
    marker costs an open and a read; parsing TOML in Python would be felt.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    write_marker(LAUNCHER_FILE,
                 ("builtin" if config["general"]["builtin_launcher"] else "external") + "\n")
    write_marker(TERMINAL_FILE, terminal_command(config) + "\n")
    write_marker(BROWSER_FILE, browser_command() + "\n")


def apply_terminal(config: dict) -> None:
    render_general(config)
    # uwsm starts applications as systemd user units, so this is what makes
    # $TERMINAL true for anything launched after the change.
    run(["systemctl", "--user", "set-environment", f"TERMINAL={terminal_command(config)}"])
    # binds.lua reads the marker while the config is parsed, not per keypress.
    run(["hyprctl", "reload"])


def installed_locales() -> list[str]:
    """The locales glibc will actually accept, from locale -a.

    Not a table of the world's languages: only what locale-gen has built is
    usable, and offering the rest would be offering settings that silently do
    nothing. C and POSIX are dropped -- they are not languages, and picking one
    as your desktop language is never what was meant.

    Spelled the way localectl and LANG already spell it. locale -a reports the
    codeset without its dash, so en_US.utf8 and the en_US.UTF-8 in /etc/locale.conf
    are one locale under two names, and a combo box would show it twice.
    """
    names = set()
    for line in run(["locale", "-a"]).stdout.splitlines():
        name = line.strip()
        if "_" not in name:
            continue
        base, _, codeset = name.partition(".")
        if codeset.lower().replace("-", "") == "utf8":
            name = f"{base}.UTF-8"
        names.add(name)
    return sorted(names)


def system_locale() -> str:
    """LANG as the system sets it, which is the value an empty override means.

    Read from the file rather than asked of localectl: the systemd shipped here
    has no `localectl show`, only a status page meant for people, and
    /etc/locale.conf is the file localectl would be reading out anyway.
    """
    try:
        text = Path("/etc/locale.conf").read_text(encoding="utf-8")
    except OSError:
        return ""
    for line in text.splitlines():
        if line.startswith("LANG="):
            return line[len("LANG="):].strip().strip('"')
    return ""


def session_locale() -> str:
    """LANG in the systemd user manager, which is what the next app inherits."""
    for line in run(["systemctl", "--user", "show-environment"]).stdout.splitlines():
        if line.startswith("LANG="):
            return line[len("LANG="):]
    return ""


def clock_format(config: dict) -> str:
    """The bar clock's strftime string, date part then time part."""
    region = config["region"]
    return (DATE_FORMATS[region["date_format"]] + "  "
            + TIME_FORMATS[region["time_format"]])


def render_region(config: dict) -> None:
    """Publish the locale override and the bar's clock, as generated fragments.

    Both belong in files this cannot write: ~/.config/uwsm/env and waybar's
    config.jsonc are stow symlinks into the dotfiles repo, and rewriting either
    on a settings change would edit a tracked file. So each one reaches in from
    its own side instead -- the env file sources locale.env, config.jsonc
    includes waybar-clock.jsonc -- and only the generated halves move.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    region = config["region"]
    header = "# Generated by garage. Sourced from ~/.config/uwsm/env.\n"
    # No export at all for the empty override, rather than exporting the system
    # value: the point of "" is that the session is left to resolve LANG the way
    # it would with this file absent.
    atomic_write(LOCALE_ENV, header + (
        f"export LANG={shlex.quote(region['locale'])}\n" if region["locale"] else ""))

    clock: dict[str, object] = {"format": "{:" + clock_format(config) + "}",
                                "calendar": {"iso8601": FIRST_WEEKDAYS[region["first_day_of_week"]]}}
    # The one part of the choice the bar can honour before the next login: its
    # clock formats through a std::locale it is handed, not through the LANG the
    # process was started with, so the weekday and month names move immediately.
    if region["locale"]:
        clock["locale"] = region["locale"]
    atomic_write(WAYBAR_CLOCK, json.dumps({"clock": clock}, indent=2) + "\n")


def apply_locale(config: dict) -> None:
    """Push the chosen locale as far into the running session as it reaches.

    Not far. LANG is read once, at startup, by the C library, and nothing
    re-reads it, so no running program can be moved to another locale. What can
    be moved is what has yet to start: uwsm runs applications as systemd user
    units, so seeding the user manager's environment -- and the D-Bus activation
    environment beside it, for services started that way -- means anything
    opened from here on comes up in the new locale. The shell, the bar and every
    open window keep the old one until the next login, which is what the pane
    says in as many words.
    """
    target = config["region"]["locale"] or system_locale()
    if target:
        run(["systemctl", "--user", "set-environment", f"LANG={target}"])
    else:
        run(["systemctl", "--user", "unset-environment", "LANG"])
    # Best effort: dbus-update-activation-environment is not a hard dependency
    # of the setting, and the systemd half above is the one that matters here.
    if target and shutil.which("dbus-update-activation-environment"):
        run(["dbus-update-activation-environment", "--systemd", f"LANG={target}"])


def apply_region(config: dict) -> None:
    render_region(config)
    reload_bar()


def apply_theme(config: dict) -> None:
    """Write the resolved palette everywhere and reload what can be reloaded.

    Only generated paths are written. Everything under ~/.config is a stow
    symlink into the dotfiles repo, so writing there would edit tracked files and
    leave the working tree dirty on every switch.
    """
    GENERATED.mkdir(parents=True, exist_ok=True)
    scheme = resolve_theme(config)
    look = THEME_TOOLKITS[scheme]

    # Quickshell watches this file, so its own UI repaints with no restart.
    write_marker(SCHEME_FILE, scheme + "\n")

    # The desktop picture belongs to the appearance, so it moves with the
    # palette. Hooked here because this is the one site every switch goes
    # through: a manual change, session start, and the five-minute theme timer.
    #
    # Gated on what `current` already resolves to, not on applied_scheme(): the
    # marker was overwritten a line ago and can no longer say what was on
    # screen. Ungated, the timer would re-issue the wallpaper -- and restart
    # hyprpaper whenever the fit moved with it -- every five minutes.
    try:
        target = wallpaper_target(config, scheme)
    except SettingsError:
        # A missing or unreadable picture is not a reason to abandon the rest of
        # the palette; the pane reports it the next time the setting is touched.
        target = None
    if target is not None and str(target.resolve()) != current_wallpaper():
        apply_wallpaper(config)

    apply_search_engine(config)

    # The bar's widgets draw their own SVG text, which no stylesheet reaches.
    # Publish the resolved theme foreground so they match Waybar's CSS.
    bar_fg = "#ffffff" if scheme == "dark" else "#000000"
    write_marker(BAR_FG_FILE, bar_fg + "\n")
    render_toolkits(scheme)

    # GTK4 and libadwaita follow the portal setting live.
    run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", look["scheme"]])
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", look["gtk"]])
    run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", look["icons"]])

    # GTK3 and XWayland apps re-theme when xsettingsd rereads its config.
    run(["systemctl", "--user", "reload-or-restart", "xsettingsd.service"])

    # swaync reloads its stylesheet in place.
    run(["swaync-client", "-rs"])

    # waybar rereads its stylesheet on SIGUSR2, kitty its whole config on SIGUSR1.
    run(["pkill", "-USR2", "-x", "waybar"])
    run(["pkill", "-USR1", "-x", "kitty"])
    run(["systemctl", "--user", "try-restart", "swayosd.service"])


def eval_config(body: str) -> subprocess.CompletedProcess[str]:
    """Set live Hyprland options from a Lua table body, without a reload.

    Hyprland 0.56 parses its config with Lua, and hyprctl keyword refuses to
    work there ("keyword can't work with non-legacy parsers. Use eval."), so the
    only way to reach a live option is eval. That is enough on its own: options
    are dereferenced per frame and cached nowhere, so no reload is needed for a
    new value to be picked up. render_preferences() has already written the
    fragment, which is what makes the value survive a real reload or a restart.

    eval sets values but damages nothing -- it does not emit config.reloaded,
    which is the only event the glass plugin repaints on -- so a second call
    writes decoration:blur:size back to its own value. A core option set
    dynamically schedules the refresh it declares, and blur's forces a full
    frame on every monitor without re-running a single monitor, window or layer
    rule. Writing it back to itself keeps the nudge free of any visible side
    effect. It has to be its own hl.config: a second `decoration` key in the
    same table constructor is a plain Lua overwrite, and the options it was
    meant to accompany would be dropped without any error.
    """
    code = (f"hl.config({{{body}}}) "
            'hl.config({decoration = {blur = {size = hl.get_config("decoration:blur:size")}}})')
    return run(["hyprctl", "eval", code])


def apply_glass(config: dict) -> None:
    """Push the whole window material straight into the running compositor."""
    # The shell's own surfaces are client-side alpha, which decoration opacity
    # multiplies but cannot lift. Off draws no glass behind them either, so
    # without this the session menu and the panels would have no background at
    # all. Quickshell watches this marker and paints itself solid instead.
    GENERATED.mkdir(parents=True, exist_ok=True)
    write_marker(MATERIAL_FILE, str(config["appearance"]["glass_mode"]) + "\n")
    result = eval_config(
        f"decoration = {{{lua_pairs(material_decoration(config))}}}, "
        f"plugin = {{kinetik_glass = {{{lua_pairs(glass_options(config))}}}}}")
    if result.returncode == 0:
        return
    # Most likely the plugin failed to load, in which case the fragment's own
    # GLASS_AVAILABLE guard is the thing that has to decide. Fall back to
    # the reload this used to do rather than refusing the setting outright.
    fallback = run(["hyprctl", "reload"])
    if fallback.returncode != 0:
        raise SettingsError(result.stdout.strip() or result.stderr.strip()
                            or "Unable to apply glass settings")


def apply_corner_radius(config: dict) -> None:
    """Publish the corner radius to the shell and the running compositor.

    Not fatal when either half fails: this also runs from render_all() at
    session start, where the compositor may not be up yet, and the generated
    fragment carries the same values into the next reload regardless.
    """
    rounding = corner_rounding(config)
    # Quickshell watches this marker, so its surfaces re-round with no restart.
    write_marker(CORNER_RADIUS_FILE, f"{rounding}\n")
    if eval_config(
        f"decoration = {{rounding = {rounding}, rounding_power = {CORNER_POWER:g}}}, "
        f"plugin = {{kinetik_glass = {{layer_rounding = {rounding}, corner_power = {CORNER_POWER:g}}}, "
        f"hyprexpo = {{tile_rounding = {rounding}, tile_rounding_power = {CORNER_POWER:g}}}}}"
    ).returncode != 0:
        # A plugin that never loaded takes the whole eval down with it, so the
        # guarded fragment is the only thing that can apply this correctly.
        run(["hyprctl", "reload"])


def apply_border(config: dict) -> None:
    """Push the window border straight into the running compositor."""
    if eval_config(f"general = {{{border_general(config)}}}").returncode != 0:
        run(["hyprctl", "reload"])


def apply_motion(config: dict) -> None:
    """Push the motion settings straight into the running compositor.

    Not eval_config(): that wraps a single hl.config table, and the per-leaf
    speeds are top-level hl.animation() calls. It also needs none of the blur
    write-back eval_config appends -- that nudge exists to make the glass plugin
    repaint, and nothing here touches the plugin.
    """
    if run(["hyprctl", "eval", motion_lua(config)]).returncode != 0:
        run(["hyprctl", "reload"])


def apply_night_shift(config: dict) -> None:
    if night_shift_active(config):
        run(["hyprctl", "hyprsunset", "temperature", str(int(config["appearance"]["night_shift_temperature"]))])
    else:
        run(["hyprctl", "hyprsunset", "identity"])


def apply_preferences(config: dict, *, restart_idle: bool = True) -> None:
    render_all(config)
    run(["hyprctl", "reload"])
    apply_wallpaper(config)
    apply_night_shift(config)
    if restart_idle:
        run(["systemctl", "--user", "restart", "hypridle.service"])


def apply_changed_preference(config: dict, dotted: str) -> None:
    section, key = dotted.split(".", 1)
    if section == "appearance":
        if key.startswith("wallpaper"):
            # No theme work: every palette output is derived from the resolved
            # scheme alone, including the bar foreground. Nothing reads the
            # image, so a new wallpaper cannot change what the theme would emit.
            #
            # Only the half that is on screen reaches the desktop -- dressing the
            # light appearance from a dark session must not change what is behind
            # the pane. wallpaper_fit belongs to neither half, so it always does.
            other = "light" if resolve_theme(config) == "dark" else "dark"
            if not key.startswith(f"wallpaper_{other}"):
                apply_wallpaper(config)
        elif key == "accent_color":
            apply_accent(config)
        elif key.startswith("search_"):
            apply_search_engine(config)
        elif key == "corner_radius":
            render_preferences(config)
            apply_corner_radius(config)
        elif key == "border_size":
            render_preferences(config)
            apply_border(config)
        elif key in {"reduce_motion", "animation_speed"}:
            render_preferences(config)
            apply_motion(config)
        elif key.startswith("theme_"):
            # Rewriting a dozen toolkit configs and reloading Hyprland is only
            # worth it when the palette actually moves. Nothing downstream reads
            # the mode or the schedule -- render_preferences() picks its
            # decoration colours from the resolved scheme too -- so an unchanged
            # scheme means every output would be byte-identical. That also
            # covers switching to auto at night when dark is already live; the
            # garage-theme.timer re-checks the schedule every five minutes anyway.
            if resolve_theme(config) != applied_scheme():
                apply_theme(config)
                render_preferences(config)
                result = run(["hyprctl", "reload"])
                if result.returncode != 0:
                    raise SettingsError(result.stderr.strip() or "Unable to reload theme")
        elif key.startswith("glass_"):
            render_preferences(config)
            apply_glass(config)
        elif key.startswith("night_shift_"):
            apply_night_shift(config)
        else:
            raise SettingsError(f"Unsupported appearance preference: {key}")
        return
    if section == "general":
        if key == "terminal":
            apply_terminal(config)
        elif key == "builtin_launcher":
            # Nothing to reload: the wrapper reads the marker on every press and
            # the shell watches it, so the switch takes effect as it is written.
            render_general(config)
        else:
            raise SettingsError(f"Unsupported general preference: {key}")
        return
    if section == "input":
        render_preferences(config)
        result = run(["hyprctl", "reload"])
        if result.returncode != 0:
            raise SettingsError(result.stderr.strip() or "Unable to reload input settings")
        return
    if section == "lock":
        render_preferences(config)
        result = run(["systemctl", "--user", "restart", "hypridle.service"])
        if result.returncode != 0:
            raise SettingsError(result.stderr.strip() or "Unable to reload idle settings")
        return
    if section == "region":
        if key == "locale":
            apply_locale(config)
        # Every region key reaches the bar clock -- the locale names its weekday
        # and month, the rest shape the format string -- so all four take the
        # same route out.
        apply_region(config)
        return
    if section == "workspaces":
        if key == "indicator":
            # Nothing in the compositor depends on this: it only decides whether
            # the bar lists the module, so the desktop is left alone.
            render_bar_workspaces(config)
            reload_bar()
            return
        # Salvage first, reload second: the windows have to be moved while the
        # workspaces they are on are still the ones the compositor knows about,
        # and while render_workspaces has not yet overwritten the only record of
        # the plan they were placed under. Remap before reap, so a window is
        # inside its own display's block before anything asks which block it is
        # in.
        plan = workspace_plan(config)
        showing = active_workspaces()
        moves = remap_workspaces(plan)
        reap_stranded_windows(plan)
        render_workspaces(config)
        # A full reload, not an eval: workspace rules are collected as the config
        # is parsed, and the binds are registered by the same pass. Both have to
        # come back together or the keys would address a layout that no longer
        # exists.
        result = run(["hyprctl", "reload"])
        if result.returncode != 0:
            raise SettingsError(result.stderr.strip() or "Unable to reload workspaces")
        # Last, because it needs the surviving slots to be back on their own
        # displays before it sends anyone to one.
        restore_active_workspaces(plan, moves, showing)
        return
    raise SettingsError(f"Unsupported preference section: {section}")


def json_command(command: list[str], fallback: object) -> object:
    result = run(command)
    if result.returncode != 0:
        return fallback
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return fallback


def display_snapshot() -> list[dict]:
    # "all", not the default list: Hyprland pulls a mirrored output out of its
    # monitor layout entirely (it loses its wl_output too, so grim cannot see it
    # either), and a disabled one never appears there. Both would vanish from
    # the pane with no control left to turn them back on.
    monitors = json_command(["hyprctl", "monitors", "all", "-j"], [])
    monitors = monitors if isinstance(monitors, list) else []
    # hyprctl reports mirrorOf as the source's *id*, rendered as a string, and
    # the literal "none" when the display stands on its own. Resolving it
    # through the id map is what turns that back into an output name; "none"
    # simply misses, which is also the answer for a display that mirrors
    # nothing. Do not test mirrorOf for truthiness -- id 0 is a real monitor.
    by_id = {str(monitor.get("id")): str(monitor.get("name", "")) for monitor in monitors
             if isinstance(monitor, dict)}
    try:
        saved = load_display_config()
    except SettingsError:
        saved = {"primary": "", "displays": []}
    saved_by_output = {item.get("output"): item for item in saved["displays"]}
    primary = saved.get("primary") or os.environ.get("HYPR_PRIMARY_MONITOR", "")
    result = []
    for monitor in monitors:
        current_mode = f'{int(monitor.get("width", 0))}x{int(monitor.get("height", 0))}@{float(monitor.get("refreshRate", 60)):g}'
        configured = saved_by_output.get(monitor.get("name"), {})
        mirror = by_id.get(str(monitor.get("mirrorOf", "none")), "")
        # A mirror is reported at its source's position, so the spot it holds in
        # the arrangement only survives in displays.toml. Keep handing that one
        # back or turning the mirror off would drop the display on top of the
        # very output it was copying.
        placed = configured if mirror else monitor
        result.append({
            "output": monitor.get("name", ""),
            "description": monitor.get("description", monitor.get("name", "Display")),
            "make": monitor.get("make", ""),
            "model": monitor.get("model", ""),
            "serial": monitor.get("serial", ""),
            "enabled": not monitor.get("disabled", False),
            "width": monitor.get("width", 0),
            "height": monitor.get("height", 0),
            "refresh": monitor.get("refreshRate", 60),
            "mode": configured.get("mode", current_mode),
            "mirror": mirror,
            "x": placed.get("x", 0),
            "y": placed.get("y", 0),
            "scale": monitor.get("scale", 1),
            "transform": monitor.get("transform", 0),
            # From displays.toml, not from the monitor: hyprctl's vrr field is
            # the output's live adaptive-sync state, not the mode that was asked
            # for -- it stays false for a fullscreen-only mode with nothing
            # fullscreen, and on a panel whose CRTC cannot do VRR at all. The
            # mode itself only survives in the file. -1 means follow misc:vrr.
            "vrr": int(configured.get("vrr", -1)),
            "modes": monitor.get("availableModes", []),
            "focused": monitor.get("focused", False),
            "primary": monitor.get("name") == primary,
        })
    if result and not any(item["primary"] for item in result):
        primary_index = next((index for index, item in enumerate(result) if item["focused"]), 0)
        result[primary_index]["primary"] = True
    return result


def workspaces_snapshot(config: dict, displays: list[dict]) -> dict:
    """The allocation the pane draws, for the displays now attached.

    Resolved here rather than in QML so the pane and the generated fragment
    cannot disagree about which display owns which ids: there is one allocator,
    and this is a read of it. The per-display groups are reported even in shared
    mode, so the pane can show what switching back would give.
    """
    labels = {str(item["output"]): str(item.get("model") or item["output"])
              for item in displays}
    return {
        "max": WORKSPACE_COUNT_MAX,
        "displays": [{
            "output": group["monitor"],
            "label": labels.get(group["monitor"], group["monitor"]),
            "count": group["count"],
            "first": group["first"],
            "last": group["first"] + group["count"] - 1,
        } for group in per_display_groups(config)],
    }


def audio_snapshot() -> dict:
    info = json_command(["pactl", "-f", "json", "info"], {})
    sinks = json_command(["pactl", "-f", "json", "list", "sinks"], [])
    sources = json_command(["pactl", "-f", "json", "list", "sources"], [])

    def simplify(items: object, default_name: str) -> list[dict]:
        simplified = []
        for item in items if isinstance(items, list) else []:
            volumes = item.get("volume", {})
            first = next(iter(volumes.values()), {}) if isinstance(volumes, dict) else {}
            percent = str(first.get("value_percent", "0%")).rstrip("%")
            simplified.append({
                "name": item.get("name", ""),
                "description": item.get("description", item.get("name", "Device")),
                "default": item.get("name") == default_name,
                "mute": bool(item.get("mute", False)),
                "volume": float(percent or 0) / 100,
            })
        return simplified

    return {
        "outputs": simplify(sinks, str(info.get("default_sink_name", ""))),
        "inputs": simplify(sources, str(info.get("default_source_name", ""))),
    }


def notification_snapshot() -> dict:
    result = run(["swaync-client", "-D"])
    text = result.stdout.strip().lower()
    return {"available": result.returncode == 0, "dnd": text in {"true", "1", "enabled", "on"}}


def input_snapshot() -> dict:
    devices = json_command(["hyprctl", "devices", "-j"], {})
    return {"hasTouchpad": bool(devices.get("touch", [])) or any(
        "touchpad" in str(item.get("name", "")).lower()
        for item in devices.get("mice", []) if isinstance(item, dict)
    )} if isinstance(devices, dict) else {"hasTouchpad": False}


def default_apps_snapshot(config: dict) -> dict:
    """The handler in force and the candidates, for every role the pane offers.

    Read live rather than stored: the mime defaults belong to mimeapps.list, and
    a second copy in preferences.toml would be nothing but a copy to drift. The
    terminal is the exception -- nothing on the system records one -- so it is a
    real preference, resolved here against what is actually installed.
    """
    apps = {}
    for role, types in DEFAULT_APP_ROLES.items():
        current, candidates = role_applications(types)
        apps[role] = {"current": current, "candidates": candidates}
    apps["terminal"] = {"current": resolve_terminal(config), "candidates": terminal_candidates()}
    return apps


def timedate_value(name: str) -> str:
    result = run(["timedatectl", "show", f"--property={name}", "--value"])
    return result.stdout.strip() if result.returncode == 0 else ""


def datetime_snapshot() -> dict:
    zones = run(["timedatectl", "list-timezones"])
    timezone = timedate_value("Timezone")
    if not timezone:
        try:
            localtime = Path("/etc/localtime").resolve()
            timezone = str(localtime).split("/zoneinfo/", 1)[1]
        except (OSError, IndexError):
            timezone = time.tzname[0]
    return {
        "timezone": timezone,
        "ntp": timedate_value("NTP").lower() == "yes",
        "synchronized": timedate_value("NTPSynchronized").lower() == "yes",
        "timezones": zones.stdout.splitlines() if zones.returncode == 0
            else sorted(available_timezones()),
    }


def region_snapshot() -> dict:
    """What the pane needs to tell the truth about a locale change.

    Three LANGs, because they genuinely differ after a change: the system one
    this override sits on top of, the one the user manager will hand the next
    application, and the one this process was started with -- which, since the
    helper is a child of the shell, is the locale the running session is in.
    """
    return {
        "locales": installed_locales(),
        "system": system_locale(),
        "session": session_locale(),
        "active": os.environ.get("LANG", ""),
    }


def make_snapshot() -> dict:
    error = ""
    try:
        preferences = load_preferences()
    except SettingsError as exc:
        preferences = copy.deepcopy(FALLBACK_DEFAULTS)
        error = str(exc)
    # preferences is reported exactly as stored. It used to have the wallpaper
    # replaced with the resolved `current` symlink, which meant the pane was
    # shown a path nothing had ever written -- after picking a solid colour it
    # read back .../solid-1c1c1e.png as though that were the chosen picture.
    displays = display_snapshot()
    return {
        "preferences": preferences,
        "defaultApps": default_apps_snapshot(preferences),
        "displays": displays,
        "workspaces": workspaces_snapshot(preferences, displays),
        "keybindings": keybindings_snapshot(load_keybindings()),
        "audio": audio_snapshot(),
        "notifications": notification_snapshot(),
        "dateTime": datetime_snapshot(),
        "region": region_snapshot(),
        "inputCapabilities": input_snapshot(),
        "capabilities": {name: shutil.which(name) is not None for name in (
            "hyprctl", "hyprpaper", "hyprsunset", "pactl", "swaync-client", "hypridle"
        )},
        "error": error,
    }


def normalize_display_layout(layout: dict) -> dict:
    normalized = copy.deepcopy(layout)
    displays = normalized.get("displays", [])
    # The origin belongs to the outputs that actually occupy the desktop. A
    # mirror only carries a parked coordinate for when it is turned off again,
    # and anchoring on that would slide every real display away from 0,0.
    mirrors = mirror_targets(displays)
    placed = [item for item in displays
              if item.get("enabled", True) and str(item.get("output", "")) not in mirrors]
    if not placed:
        return normalized
    minimum_x = min(float(item.get("x", 0)) for item in placed)
    minimum_y = min(float(item.get("y", 0)) for item in placed)
    for item in normalized.get("displays", []):
        item["x"] = round(float(item.get("x", 0)) - minimum_x)
        item["y"] = round(float(item.get("y", 0)) - minimum_y)
    return normalized


def apply_display_layout(layout: dict) -> None:
    displays = layout.get("displays", [])
    if not displays or not any(item.get("enabled", True) for item in displays):
        raise SettingsError("At least one display must remain enabled")
    # A mirror is not part of the arrangement: Hyprland stacks it exactly on its
    # source, which reads as a total overlap here, and it touches no edge of its
    # own. Only the outputs that hold their own place are checked -- and they are
    # checked against each other exactly as strictly as before.
    mirrors = mirror_targets(displays, strict=True)
    placed = [item for item in displays
              if item.get("enabled", True) and str(item.get("output", "")) not in mirrors]
    if not placed:
        raise SettingsError("At least one display must show the desktop rather than mirror another")
    rectangles: list[tuple[dict, tuple[float, float, float, float]]] = []
    for first in placed:
        first_width = float(first.get("width", 1)) / float(first.get("scale", 1))
        first_height = float(first.get("height", 1)) / float(first.get("scale", 1))
        first_rect = (float(first.get("x", 0)), float(first.get("y", 0)),
                      float(first.get("x", 0)) + first_width,
                      float(first.get("y", 0)) + first_height)
        rectangles.append((first, first_rect))
    adjacency: list[set[int]] = [set() for _ in rectangles]
    for index, (first, first_rect) in enumerate(rectangles):
        for second_index, (second, second_rect) in enumerate(rectangles[index + 1:], index + 1):
            overlaps = (first_rect[0] < second_rect[2] - 0.5
                        and first_rect[2] > second_rect[0] + 0.5
                        and first_rect[1] < second_rect[3] - 0.5
                        and first_rect[3] > second_rect[1] + 0.5)
            if overlaps:
                raise SettingsError(
                    f'{first.get("output")} overlaps {second.get("output")}; '
                    "drag their edges apart before applying")
            vertical_overlap = min(first_rect[3], second_rect[3]) > max(first_rect[1], second_rect[1])
            horizontal_overlap = min(first_rect[2], second_rect[2]) > max(first_rect[0], second_rect[0])
            touches = ((abs(first_rect[2] - second_rect[0]) < 0.5
                        or abs(second_rect[2] - first_rect[0]) < 0.5) and vertical_overlap)
            touches = touches or ((abs(first_rect[3] - second_rect[1]) < 0.5
                                  or abs(second_rect[3] - first_rect[1]) < 0.5) and horizontal_overlap)
            if touches:
                adjacency[index].add(second_index)
                adjacency[second_index].add(index)
    connected = {0}
    pending = [0]
    while pending:
        current = pending.pop()
        for neighbour in adjacency[current] - connected:
            connected.add(neighbour)
            pending.append(neighbour)
    if len(connected) != len(rectangles):
        raise SettingsError("Display layout contains gaps; connect every monitor edge-to-edge")
    render_displays(layout)
    result = run(["hyprctl", "reload"])
    if result.returncode != 0:
        raise SettingsError(result.stderr.strip() or "Unable to reload the display layout")


def layout_toml(layout: dict) -> str:
    lines = [f'primary = {toml_value(str(layout.get("primary", "")))}', ""]
    for item in layout.get("displays", []):
        lines.append("[[display]]")
        for key in ("output", "description", "enabled", "mode", "x", "y", "scale",
                    "transform", "vrr"):
            if key in item:
                lines.append(f"{key} = {toml_value(item[key])}")
        # Written only when set. Extending is the default and every display
        # carries the key, so the loop above would leave a dead mirror = "" in
        # each entry -- but leaving it out of the loop entirely is what would
        # silently drop the mirror on the way to disk.
        if item.get("mirror"):
            lines.append(f'mirror = {toml_value(str(item["mirror"]))}')
        lines.append("")
    return "\n".join(lines)


def initialize_display_config() -> None:
    """Record the machine's own display arrangement, once, on the first render.

    The tracked config names no connector: config.monitors ships a single
    catch-all rule and every named monitor rule reaches Hyprland through the
    generated fragment, which is rendered from displays.toml. Nothing writes that
    file but a confirmed layout from the Displays pane, though, so until this the
    machine of an owner who never opened the pane stayed on the catch-all for
    good -- preferred mode, auto position, scale 1 -- and workspace_outputs() had
    no saved layout to lead with, which is what loses a sleeping display its
    block.

    So the first render seeds it from what Hyprland currently reports, which is
    the arrangement the catch-all rule produced: a faithful description of this
    machine, and the baseline the user then edits. Normalized and serialized
    through the same two helpers the pane's own save path uses, so both write the
    same file.

    Never an overwrite -- the file belongs to the user from the moment it exists.
    And silent when there is nothing to record: `garage render` also runs where no
    compositor is answering, and a missing hyprctl or an empty monitor list is a
    render with no displays to snapshot rather than a failure.
    """
    if DISPLAYS_PATH.exists():
        return
    displays = display_snapshot()
    if not displays:
        return
    # Under the lock display_finish() writes displays.toml with, and re-checked
    # inside it: session start runs this while the pane is coming up, and a
    # layout confirmed in between must not be replaced by a snapshot of the
    # arrangement it was confirmed away from.
    DISPLAY_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with DISPLAY_LOCK.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if DISPLAYS_PATH.exists():
            return
        # display_snapshot() always marks one display primary -- the focused one
        # when nothing has been chosen yet -- so this only misses if the list is
        # empty, which is already handled above.
        primary = next((item["output"] for item in displays if item["primary"]), "")
        layout = normalize_display_layout({"primary": primary, "displays": displays})
        atomic_write(DISPLAYS_PATH, layout_toml(layout))


def display_test(payload: dict) -> str:
    token = uuid.uuid4().hex
    payload = normalize_display_layout(payload)
    previous_displays = display_snapshot()
    previous_primary = next((item["output"] for item in previous_displays if item["primary"]), "")
    previous = {"displays": previous_displays, "primary": previous_primary}
    pending = {"token": token, "previous": previous, "candidate": payload, "expires": time.time() + 15}
    atomic_write(PENDING_DISPLAY, json.dumps(pending))
    apply_display_layout(payload)
    subprocess.Popen(
        [str(Path(__file__).resolve()), "_display-watchdog", token],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return token


def display_finish(token: str, confirm: bool) -> None:
    DISPLAY_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with DISPLAY_LOCK.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if not PENDING_DISPLAY.exists():
            return
        pending = json.loads(PENDING_DISPLAY.read_text(encoding="utf-8"))
        if pending.get("token") != token:
            raise SettingsError("Display confirmation token expired")
        if confirm:
            atomic_write(DISPLAYS_PATH, layout_toml(pending["candidate"]))
            render_displays(pending["candidate"])
            apply_display_layout(pending["candidate"])
        else:
            apply_display_layout(pending["previous"])
        PENDING_DISPLAY.unlink(missing_ok=True)


def action(name: str, value: object | None) -> None:
    if name == "audio.output.volume":
        run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", str(float(value))], check=True)
    elif name == "audio.input.volume":
        run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SOURCE@", str(float(value))], check=True)
    elif name == "audio.output.mute":
        run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if value else "0"], check=True)
    elif name == "audio.input.mute":
        run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "1" if value else "0"], check=True)
    elif name == "audio.output.default":
        run(["pactl", "set-default-sink", str(value)], check=True)
    elif name == "audio.input.default":
        run(["pactl", "set-default-source", str(value)], check=True)
    elif name == "notifications.dnd":
        run(["swaync-client", "-dn" if value else "-df"], check=True)
    elif name == "notifications.clear":
        run(["swaync-client", "-C"], check=True)
    elif name == "glass.reset":
        config = load_preferences()
        defaults = load_toml(DEFAULTS_PATH, FALLBACK_DEFAULTS)
        # Every material preference is a glass_ key, so this needs no list of
        # its own to keep in step with the schema.
        for key, fallback in defaults["appearance"].items():
            if key.startswith("glass_"):
                config["appearance"][key] = fallback
        validate_preferences(config)
        atomic_write(PREFERENCES_PATH, dump_toml(config))
        render_preferences(config)
        # The same live push a single slider takes, rather than the full reload
        # this used to do: apply_glass now covers the core decoration options
        # too, and falls back to a reload itself if the eval cannot land.
        apply_glass(config)
    elif name.startswith("keybind."):
        keybind_action(name.split(".", 1)[1], value)
    elif name.startswith("defaults."):
        set_default_app(name.split(".", 1)[1], str(value))
    elif name == "lock.now":
        run(["loginctl", "lock-session"], check=True)
    elif name == "datetime.ntp":
        subprocess.Popen(
            ["timedatectl", "set-ntp", "true" if value else "false"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    elif name == "datetime.timezone":
        timezone = str(value)
        available = run(["timedatectl", "list-timezones"])
        if timezone not in available.stdout.splitlines():
            raise SettingsError("Unknown timezone")
        subprocess.Popen(
            ["timedatectl", "set-timezone", timezone],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    else:
        raise SettingsError(f"Unknown action: {name}")


def response(data: object = None, error: str = "") -> None:
    print(json.dumps({"ok": not error, "data": data, "error": error}, separators=(",", ":")))


def main(argv: list[str]) -> int:
    try:
        # Once per process, ahead of the dispatch rather than inside a loader:
        # `action keybind.rebind` and `display-test` reach keybindings.toml and
        # displays.toml without ever loading the preferences, and either one
        # arriving first would write a fresh file at the new path while the
        # user's own was still sitting at the old one.
        migrate_config_root()
        command = argv[1] if len(argv) > 1 else "snapshot"
        if command == "snapshot":
            response(make_snapshot())
        elif command == "render":
            render_all(load_preferences())
            response(True)
        elif command == "render-bar":
            # waybar's modules-left now lives only in the generated fragment, so
            # the bar comes up with an empty left side if it starts before the
            # first render. Its unit runs this first; narrow rather than a full
            # render, which would re-theme every toolkit at session start.
            config = load_preferences()
            render_region(config)
            render_bar_workspaces(config)
            response(True)
        elif command == "render-wallpaper":
            # hyprpaper's ExecStartPre. Deliberately not "render": that rewrites
            # a dozen toolkit configs and restarts three services, which is both
            # wasteful and racy to chain onto a second unit at session start.
            render_wallpaper(load_preferences())
            response(True)
        elif command == "apply":
            apply_preferences(load_preferences())
            response(True)
        elif command == "set":
            if len(argv) != 4:
                raise SettingsError("Usage: garage set KEY JSON_VALUE")
            # One process per wheel tick: the UI's sliders fire a set per notch,
            # so several of these run at once. Each reads the whole file and
            # writes the whole file back, and unserialised the last writer wins
            # with a copy that predates its neighbours' keys. Applying under the
            # same lock keeps the live state in step with the file rather than
            # letting a stale apply land last.
            PREFERENCES_LOCK.parent.mkdir(parents=True, exist_ok=True)
            with PREFERENCES_LOCK.open("a+", encoding="utf-8") as lock:
                fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
                config = load_preferences()
                set_nested(config, argv[2], json.loads(argv[3]))
                validate_preferences(config)
                atomic_write(PREFERENCES_PATH, dump_toml(config))
                apply_changed_preference(config, argv[2])
            response(config)
        elif command == "action":
            value = json.loads(argv[3]) if len(argv) > 3 else None
            action(argv[2], value)
            response(True)
        elif command == "display-test":
            response({"token": display_test(json.loads(argv[2]))})
        elif command == "display-confirm":
            display_finish(argv[2], True)
            response(True)
        elif command == "display-revert":
            display_finish(argv[2], False)
            response(True)
        elif command == "_display-watchdog":
            time.sleep(15)
            try:
                display_finish(argv[2], False)
            except (SettingsError, OSError, json.JSONDecodeError):
                pass
        elif command == "theme-sync":
            config = load_preferences()
            # Same gate as the manual theme_* path: an unchanged scheme means
            # every output would be byte-identical, so rewriting a dozen
            # toolkit configs and reloading Hyprland would only make the
            # desktop visibly flicker every five minutes for nothing.
            if resolve_theme(config) != applied_scheme():
                apply_theme(config)
                render_preferences(config)
                run(["hyprctl", "reload"])
            response(resolve_theme(config))
        elif command == "night-shift-sync":
            apply_night_shift(load_preferences())
            response(night_shift_active(load_preferences()))
        else:
            raise SettingsError(f"Unknown command: {command}")
        return 0
    except (SettingsError, OSError, ValueError, json.JSONDecodeError) as error:
        response(error=str(error))
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
