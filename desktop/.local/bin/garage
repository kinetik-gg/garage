#!/usr/bin/env python3
"""Human-editable settings backend for the Garage Quickshell UI."""

from __future__ import annotations

import copy
import fcntl
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
import uuid
from zoneinfo import available_timezones


HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))

# Three layers, in the order they win, and nothing writes to a layer above its
# own:
#
#   1. Shipped defaults -- preferences.defaults.toml, read-only, reaching
#      ~/.config/garage as a stow symlink into the dotfiles checkout. Every key
#      the schema has, with the value a fresh install starts on.
#   2. Host preferences -- ROOT, the only user-owned files on the machine: the
#      four below, each holding the deliberate departures from layer 1 and
#      nothing else. Back these up and the desktop comes back.
#   3. Generated state -- STATE_ROOT, machine-written and deletable. Every
#      fragment under it is rewritten from layers 1 and 2 by `garage render`, so
#      losing the whole directory costs one render and no settings.
#
# Kept apart because they have different lifetimes: layer 1 moves with the
# checkout, layer 2 must survive a reinstall, and layer 3 is a cache that has to
# be safe to throw away. Generated output used to sit inside layer 2, where
# deleting the cache meant deleting the user's settings beside it.
ROOT = CONFIG_HOME / "garage"
STATE_ROOT = STATE_HOME / "garage"
DEFAULTS_PATH = ROOT / "preferences.defaults.toml"
PREFERENCES_PATH = Path(os.environ.get("GARAGE_PREFERENCES", ROOT / "preferences.toml"))
DISPLAYS_PATH = Path(os.environ.get("GARAGE_DISPLAYS", ROOT / "displays.toml"))
# A file of its own, next to displays.toml and for the same reason: the
# shortcuts are a list of records, and preferences.toml is a flat section/key
# whitelist that has nowhere to put one.
KEYBINDINGS_PATH = Path(os.environ.get("GARAGE_KEYBINDINGS", ROOT / "keybindings.toml"))
# Which block of workspace ids each display owns. Not in displays.toml, though it
# is per-display state: that file is rewritten from the monitors Hyprland can see
# whenever a layout is applied, so a display that happened to be asleep would
# lose its block and be handed somebody else's on the way back.
WORKSPACE_BLOCKS_PATH = Path(os.environ.get("GARAGE_WORKSPACE_BLOCKS",
                                            ROOT / "workspace-blocks.toml"))
GENERATED = STATE_ROOT / "generated"
HYPRLAND_FRAGMENT = GENERATED / "preferences.lua"
DISPLAY_FRAGMENT = GENERATED / "displays.lua"
WORKSPACES_FRAGMENT = GENERATED / "workspaces.lua"
KEYBINDS_DATA = GENERATED / "keybinds.json"
KEYBINDS_CATALOG = GENERATED / "keybinds.catalog"
HYPRIDLE_CONFIG = GENERATED / "hypridle.conf"
HYPRPAPER_CONFIG = GENERATED / "hyprpaper.conf"
WALLPAPER_DIR = HOME / ".local/share/wallpaper"
CURRENT_WALLPAPER = WALLPAPER_DIR / "current"
ACCENT_FILE = GENERATED / "accent"
SCHEME_FILE = GENERATED / "color-scheme"
SEARCH_FILE = GENERATED / "search-engine"
BAR_FG_FILE = GENERATED / "bar-foreground"
CORNER_RADIUS_FILE = GENERATED / "corner-radius"
MATERIAL_FILE = GENERATED / "material"
LAUNCHER_FILE = GENERATED / "launcher"
TERMINAL_FILE = GENERATED / "terminal"
BROWSER_FILE = GENERATED / "browser"
LOCALE_ENV = GENERATED / "locale.env"
WAYBAR_CLOCK = GENERATED / "waybar-clock.jsonc"
WAYBAR_WORKSPACES = GENERATED / "waybar-workspaces.jsonc"

# The bar's left side, which is what the workspace indicator is toggled out of.
# waybar cannot append to an array from an include -- an option is won by
# whichever file names it first, and config.jsonc is read before anything it
# includes -- so the whole list has to be published here for either variant of
# it to reach the bar. custom/menu is carried along unchanged.
WAYBAR_MODULES_LEFT = ["custom/menu"]
WAYBAR_WORKSPACE_MODULE = "hyprland/workspaces"

# Toolkit configs that offer no include or indirection mechanism, so a theme
# switch has to rewrite the file itself. They are deliberately not stowed: every
# other path under ~/.config is a symlink into the dotfiles repo, and rewriting
# one of those at runtime would edit a tracked file on every switch.
GTK3_SETTINGS = CONFIG_HOME / "gtk-3.0/settings.ini"
GTK4_SETTINGS = CONFIG_HOME / "gtk-4.0/settings.ini"
XSETTINGSD_CONF = CONFIG_HOME / "xsettingsd/xsettingsd.conf"
QT6CT_CONF = CONFIG_HOME / "qt6ct/qt6ct.conf"

# Where the default applications are written. Not ~/.config/mimeapps.list: that
# path is a stow symlink into the dotfiles repo, and every writer of it -- xdg-mime
# included -- renames a temporary over it, which replaces the link with a plain
# file and cuts the config loose from the repo. The spec reads a
# <desktop>-prefixed list ahead of the plain one, so this file wins outright
# while the tracked one stays exactly as checked in.
MIMEAPPS_DESKTOP = (os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")[0] or "hyprland").lower()
MIMEAPPS_OVERRIDE = CONFIG_HOME / f"{MIMEAPPS_DESKTOP}-mimeapps.list"

THEME_TOOLKITS = {
    "dark": {"gtk": "adw-gtk3-dark", "icons": "Papirus-Dark",
             "prefer_dark": 1, "scheme": "prefer-dark", "qt_colors": "vanta.conf"},
    "light": {"gtk": "adw-gtk3", "icons": "Papirus-Light",
              "prefer_dark": 0, "scheme": "prefer-light", "qt_colors": "vanta-light.conf"},
}
PENDING_DISPLAY = STATE_ROOT / "display-pending.json"
DISPLAY_LOCK = STATE_ROOT / "display-transaction.lock"
PREFERENCES_LOCK = STATE_ROOT / "preferences.lock"

# Stamp carried in preferences.toml, read by migrate_preferences(). Bump it, and
# add the coercion there, whenever a stored value changes meaning rather than
# just changing range -- or, as v5 did, whenever the file's own shape changes and
# an existing one has to be rewritten to match.
PREFERENCES_VERSION = 5

# Where layer 2 was kept before the rename, and the files that belong to the
# user rather than to the machine -- the whole of what v4 has to carry across.
# Each is mapped to the path this process would read it from, so the move lands
# where the session is actually looking.
LEGACY_ROOT = CONFIG_HOME / "workstation"
MIGRATED_FILES = {
    "preferences.toml": PREFERENCES_PATH,
    "displays.toml": DISPLAYS_PATH,
    "keybindings.toml": KEYBINDINGS_PATH,
    "workspace-blocks.toml": WORKSPACE_BLOCKS_PATH,
}

# FALLBACK_DEFAULTS is no longer written out here. It is derived, along with the
# validation pass and `set`'s routing, from PREFERENCE_SCHEMA -- one table, below
# the constants it constrains itself with. See "The preference schema".


# The clock halves, as strftime fragments. Both the bar and the shell's own
# clock are built from these, so the two cannot drift apart.
TIME_FORMATS = {"12": "%I:%M %p", "24": "%H:%M"}
DATE_FORMATS = {"dmy": "%a %d %b", "mdy": "%a %b %d", "iso": "%a %Y-%m-%d"}
# waybar's calendar has no first-weekday option of its own, only the ISO 8601
# switch -- which is defined as weeks beginning on Monday.
FIRST_WEEKDAYS = {"sunday": False, "monday": True}


# The complete set hyprpaper 0.8.4 accepts for fit_mode. Anything else is a
# parse error that leaves the desktop with no wallpaper at all.
WALLPAPER_FITS = {"cover", "contain", "fit", "tile"}

# The two appearances, which are also the suffixes the per-appearance wallpaper
# keys are spelled with: wallpaper_light, wallpaper_dark_source, and so on.
SCHEMES = ("light", "dark")
# What the single pre-v3 wallpaper key of each kind became. The old value goes
# into both halves rather than being dropped, so a migrated desktop keeps the
# picture it had until the two are deliberately set apart.
WALLPAPER_SPLIT = {"wallpaper": "", "wallpaper_source": "_source",
                   "wallpaper_color": "_color"}


# Rounding in px per corner radius setting. Both Hyprland and the shell draw a
# visible radius of rounding * CORNER_POWER / 2, so these read as 0 / 12 / 24 px.
# The old scale started where this one ends: its Normal and Large both amplified
# past half the height of a ~32 px control, so the shell clamped them to the same
# pill and the setting had no visible effect on any button. Renaming the steps
# rather than adding a fourth keeps three, with a genuinely square option.
CORNER_RADII = {"none": 0, "normal": 7, "large": 14}
# How the old three map onto the new three: every old corner keeps its px, so a
# migrated desktop looks exactly as it did. Applied once, gated on the schema
# version, because "normal" appears on both sides and would otherwise walk a
# setting from normal to large on every load.
CORNER_RADIUS_RENAMES = {"small": "normal", "normal": "large", "large": "large"}
# The subset that cannot be confused with a current name, so it is safe to
# coerce unconditionally for a file that somehow escaped the version stamp.
CORNER_RADIUS_STALE = {old: new for old, new in CORNER_RADIUS_RENAMES.items()
                       if old not in CORNER_RADII}
# Held constant across the three sizes: only the radius scales, so a corner
# keeps the same superellipse profile whatever size it is. Must match
# Theme.cornerPower in the shell, which draws the same silhouette in QML.
CORNER_POWER = 3.37


# The active/inactive edge pair the palette draws a window border with. Shared
# with the group borders below, which are the same idea one level in: a group's
# tab strip already means "this edge is focused", so a bordered window that
# spoke a different colour would read as a second, unrelated convention.
BORDER_COLORS = {
    "dark": ("rgba(666666ff)", "rgba(181818ff)"),
    "light": ("rgba(b0b0b5ff)", "rgba(e5e5eaff)"),
}


# The animation leaves config/animations.lua leaves switched on, with the
# duration each runs at when the speed multiplier is 1. Mirrored here rather
# than read back from the compositor because the multiplier has to scale the
# configured baseline, not whatever the last push happened to leave live.
# Every other leaf is deliberately off, so none of them appear.
ANIMATION_LEAVES = {
    "global": {"speed": 3.0, "bezier": "workspaceEase"},
    "layers": {"speed": 2.4, "bezier": "workspaceEase"},
    "workspaces": {"speed": 3.0, "bezier": "workspaceEase", "style": "slide"},
}
# How far the multiplier may move a duration. Half speed is already slow enough
# to feel like a fault; double is the point where the slide stops registering
# as movement at all and may as well be Reduce Motion.
MOTION_SPEED_RANGE = (0.5, 2.0)


# One Blur step drives four numbers: the plugin's own separable blur, and
# Hyprland's blur for every surface the plugin does not decorate, so the two
# never disagree on how soft the desktop reads. Fewer, wider steps rather than a
# slider because passes is an integer 1..8 and downscale is a buffer scale --
# between them there are only about three visibly distinct settings.
# "normal" is exactly what ran before this control existed: the plugin's own
# defaults (4 passes at 0.25) and decorations.lua's size 6 / 2 passes.
# Downscale moves against the depth on purpose: a lighter blur wants a larger
# buffer to keep detail, a deeper one a smaller buffer that both widens the
# kernel and pays for the extra passes.
GLASS_BLUR_LEVELS = {
    "light": {"passes": 2, "downscale": 0.40, "size": 4, "hypr_passes": 1},
    "normal": {"passes": 4, "downscale": 0.25, "size": 6, "hypr_passes": 2},
    "deep": {"passes": 6, "downscale": 0.18, "size": 8, "hypr_passes": 3},
}
# The most see-through a window may be set. Past roughly a quarter the desktop
# starts reading through body text, which is not a setting worth offering.
GLASS_TRANSPARENCY_MAX = 0.25


# URL templates; %s is replaced with the percent-encoded query.
SEARCH_ENGINES = {
    "google": "https://www.google.com/search?q=%s",
    "duckduckgo": "https://duckduckgo.com/?q=%s",
    "bing": "https://www.bing.com/search?q=%s",
    "kagi": "https://kagi.com/search?q=%s",
    "custom": "",
}


# The roles the General pane offers a default application for, and every
# mimetype each one owns. The first type is the one whose handler is reported as
# the role's current default; setting a role writes all of them, so choosing an
# image viewer covers JPEG as well as PNG. The browser's three are what
# xdg-settings would have written for default-web-browser.
DEFAULT_APP_ROLES = {
    "browser": ("x-scheme-handler/http", "x-scheme-handler/https", "text/html"),
    "mail": ("x-scheme-handler/mailto",),
    "files": ("inode/directory",),
    "editor": ("text/plain",),
    "image": ("image/png", "image/jpeg"),
    "video": ("video/mp4", "video/x-matroska"),
    "pdf": ("application/pdf",),
}

# The field codes a desktop Exec carries for the files or URLs it is handed. A
# terminal is launched with none, so they are dropped rather than reaching the
# command line as literal arguments.
EXEC_FIELD_CODES = re.compile(r"\s*%[fFuUdDnNickvm]")


# The modifiers Hyprland's bind parser knows, and the spellings people reach for
# that mean the same thing. MOD4 is SUPER under another name; ALTGR is MOD5.
KEY_MODIFIERS = {"SUPER", "SHIFT", "CONTROL", "ALT", "CAPS", "MOD2", "MOD3", "MOD5"}
KEY_MODIFIER_ALIASES = {"CTRL": "CONTROL", "META": "SUPER", "WIN": "SUPER",
                        "MOD4": "SUPER", "ALTGR": "MOD5"}
# The order a combination is written back in, so two shortcuts that mean the
# same thing to the compositor also read the same way in the pane.
KEY_MODIFIER_ORDER = ("SUPER", "CONTROL", "ALT", "SHIFT", "CAPS", "MOD2", "MOD3", "MOD5")
# An xkb keysym name, or one of the two forms Hyprland resolves itself: code:NN
# is a raw keycode and mouse:NNN a button.
KEY_NAME = re.compile(r"(?:[A-Za-z0-9_]+|code:\d{1,3}|mouse:\d{1,4})")
# The keys that may be bound with no modifier at all. Everything else swallows
# the key across the whole desktop -- a bare "A" makes the letter untypable in
# every window -- which is a trap worth refusing rather than documenting.
KEY_STANDALONE = re.compile(
    r"(?:XF86[A-Za-z0-9_]+|F\d{1,2}|Print|Pause|Menu|Scroll_Lock"
    r"|mouse:\d{1,4}|mouse_up|mouse_down)")
# What the pane offers as the key half of a combination. Held here rather than
# in QML so there is one whitelist: anything the list cannot express is also
# something parse_combination would refuse on the way in.
KEY_CHOICES = (
    [chr(code) for code in range(ord("A"), ord("Z") + 1)]
    + [str(digit) for digit in range(10)]
    + [f"F{number}" for number in range(1, 13)]
    + ["Return", "Space", "Tab", "Escape", "BackSpace", "Delete", "Insert",
       "Home", "End", "Page_Up", "Page_Down", "Left", "Right", "Up", "Down",
       "minus", "plus", "equal", "bracketleft", "bracketright", "backslash",
       "semicolon", "apostrophe", "grave", "comma", "period", "slash",
       "Print", "Pause", "Menu"]
)
# The whitelist's own spelling of each key, found case-insensitively. Keysym
# names are mixed case on purpose -- "minus", "Page_Up", "BackSpace" -- so a key
# is normalised by adopting the spelling above rather than by upper- or
# lowercasing it. Anything not offered here (code:NN, mouse:NNN, the XF86 keys)
# has no canonical spelling to adopt and keeps the one it arrived in.
KEY_CANONICAL = {name.lower(): name for name in KEY_CHOICES}
# Ceilings, so a runaway UI or a hand-edited file cannot produce a shortcut the
# pane can no longer show or a command line nothing will run.
KEYBIND_LIMITS = {"keys": 64, "description": 120, "command": 1024}
CUSTOM_KEYBIND_MAX = 64
# Control characters have no business in a shortcut. Tab and newline are the
# exceptions: a shell command legitimately carries both, and they survive the
# round trip through TOML and JSON as escapes.
KEYBIND_CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
# The witness config/binds.lua writes as the last line of the catalog it
# publishes: this word, a tab, and the number of rows above it. It is what lets a
# reader tell a whole catalog from the leading fragment of one -- see
# read_keybind_catalog(), which is the only thing that may act on the difference.
KEYBIND_CATALOG_SENTINEL = "#end"


# How a workspace relates to a display, and the ceiling on how many one may own.
# Ten is not taste: binds.lua puts slot n on number key n % 10, so an eleventh
# workspace would have no key left to reach it.
WORKSPACE_MODES = ("per-display", "shared")
WORKSPACE_COUNT_MAX = 10
# The width of the id block each display owns, whatever its count. The ceiling
# above is the natural size: a display can never want more slots than there are
# keys, so a block that wide never has to be resized and no display's ids can
# ever depend on another display's count.
WORKSPACE_BLOCK = WORKSPACE_COUNT_MAX
# One group of the generated workspace fragment, for reading back the plan the
# compositor is still running. Anchored on the field names rather than the line,
# so it survives the fragment being reformatted.
INSTALLED_GROUP = re.compile(
    r'monitor\s*=\s*"([^"]*)"\s*,\s*first\s*=\s*(\d+)\s*,\s*count\s*=\s*(\d+)')


# ---------------------------------------------------------------------------
# The preference schema
#
# ADDING A SETTING. It used to cost seven touch points across three languages:
# preferences.defaults.toml, FALLBACK_DEFAULTS, a branch in
# validate_preferences(), a renderer, a branch in apply_changed_preference(),
# plus the QML control and its metadata. Nothing checked that the five
# Python-side ones agreed, and two of the five failed *silently* when they were
# forgotten:
#
#   * a key with no branch in validate_preferences() was simply never checked.
#     Not hypothetical: night_shift_enabled, the two wallpaper paths,
#     natural_scroll and the three touchpad switches shipped that way for
#     releases, and the table below is the first thing to make it visible -- they
#     are the "unchecked" kind now, each with the reason it is safe written next
#     to it;
#   * a key in a section whose apply branch dispatched by section rather than by
#     name -- input, lock, region, workspaces -- was applied by whatever that
#     section happened to do, which is right by luck rather than by declaration.
#
# The table below is now the only Python-side place. One addition is:
#
#   1. one entry here -- section and name (the dotted key), the default, the
#      kind and its constraints, the reason the constraint is what it is, and
#      the route `set` takes to move the running desktop onto the new value;
#   2. one line in preferences.defaults.toml, which stays the shipped source of
#      truth for values. Deliberately not generated from this table: a
#      checked-in, commented, hand-editable file is worth more than a build
#      step, and the schema coherence tests in tests/test_schema.py are the sync
#      check -- a key or value in one and not the other is a test failure now
#      rather than a silent disagreement;
#   3. a renderer, but only if the setting reaches a surface no existing
#      render_* function already writes. Most do not: a new appearance number
#      lands in preferences.lua, which render_preferences() already emits;
#   4. the QML control.
#
# Two files always, a third only for a surface that genuinely does not exist yet,
# and the control. Derived from what is below and never hand-maintained again:
# FALLBACK_DEFAULTS, the sections and keys `set` will accept, the whole of
# validate_preferences(), and apply_changed_preference()'s key -> action routing.
# Forgetting step 2 is a test failure, not a silent disagreement, and a key with
# no route is a test failure too -- see tests/test_schema_table.py.
#
# WHAT AN ENTRY SAYS.
#
#   default     The shipped value. FALLBACK_DEFAULTS is exactly these, grouped
#               by section, and it is also what a value that cannot be rendered
#               is coerced back to.
#   kind        Which predicate in PREFERENCE_KINDS decides whether a stored
#               value is usable. "int" and "float" are range-checked
#               identically -- see in_number_range() -- and the name records
#               what the renderer will coerce the number to, not an integrality
#               check the schema has never made.
#   minimum,    The range, for "int" and "float". Inclusive both ends.
#   maximum
#   members     The permitted values, for "enum". A set, tuple or mapping, so
#               the constant that already spells the choices out for the
#               renderers can be named here rather than copied.
#   renames     Withdrawn spellings, mapped to what they mean now. Applied
#               before the check and *silently*: a name this build no longer
#               offers is not a bad value, it is the same choice under the name
#               it had when it was made.
#   also        An extra condition that needs the rest of the configuration, so
#               it cannot be expressed as a kind. Called with (config, value)
#               after the kind passes.
#   normalise   Rewrites the value instead of checking it, with no note. For the
#               one preference whose stored form is a parsed structure.
#   route       Which entry of PREFERENCE_ROUTES `set` walks after the file is
#               written. Absent means the key is not settable at all.
#
# A key with no entry here does not exist: set_nested() refuses it, the
# validation pass never sees it, and preference_deltas() drops it from the file.
# ---------------------------------------------------------------------------

# Entry order is the order the validation pass walks, which is the order
# coercion notes reach the journal, and it is load-bearing in one place:
# search_custom_url's cross-key check reads search_engine, so search_engine has
# to have been coerced first. It is deliberately not required to match
# preferences.defaults.toml's order -- both are mappings, and the coherence
# tests compare keys, types and values rather than sequence.
PREFERENCE_SCHEMA: dict[str, dict] = {
    # Bookkeeping rather than a preference: written unconditionally by
    # preference_document(), never validated, and not settable. It is in the
    # table only because FALLBACK_DEFAULTS has to carry it -- a file with no
    # [schema] section reads as version 1 and replays every migration.
    "schema.preferences_version": {
        "default": PREFERENCES_VERSION, "kind": "bookkeeping",
    },

    # The desktop picture belongs to the appearance, so light and dark each keep
    # their own image, source and colour. Spelled out per appearance rather than
    # looped over SCHEMES because each really is a key of its own, with its own
    # default and its own route: only the half that is on screen may reach the
    # desktop, or dressing the light appearance from a dark session would change
    # what is behind the pane.
    #
    # The two image paths are unchecked, which is a gap the table makes visible
    # rather than one it introduces: nothing here has ever confirmed the file
    # exists, and wallpaper_target() already falls back when it does not.
    "appearance.wallpaper_light": {
        "default": "", "kind": "unchecked", "route": "wallpaper_light",
    },
    "appearance.wallpaper_dark": {
        "default": "", "kind": "unchecked", "route": "wallpaper_dark",
    },
    # Fit is shared -- it describes how an image meets the displays, which does
    # not change with the palette -- so it always reaches the desktop.
    # "stretch" was offered before anyone checked it against hyprpaper, which
    # only knows the four in WALLPAPER_FITS. Anything else is a parse error that
    # leaves the desktop with no wallpaper at all.
    "appearance.wallpaper_fit": {
        "default": "cover", "kind": "enum", "members": WALLPAPER_FITS,
        "renames": {"stretch": "cover"}, "route": "wallpaper",
    },
    "appearance.wallpaper_light_source": {
        "default": "image", "kind": "enum", "members": {"image", "color"},
        "route": "wallpaper_light",
    },
    "appearance.wallpaper_light_color": {
        "default": "#f5f5f7", "kind": "hex_color", "route": "wallpaper_light",
    },
    "appearance.wallpaper_dark_source": {
        "default": "image", "kind": "enum", "members": {"image", "color"},
        "route": "wallpaper_dark",
    },
    "appearance.wallpaper_dark_color": {
        "default": "#1c1c1e", "kind": "hex_color", "route": "wallpaper_dark",
    },
    # The swatch names the palette is built from. Held as names rather than
    # colours because the accent drives a whole generated palette, not one fill.
    "appearance.accent_color": {
        "default": "blue", "kind": "enum", "route": "accent",
        "members": {"blue", "teal", "green", "yellow", "orange", "red", "pink",
                    "purple", "slate"},
    },
    # Unchecked, and the schedule keys beside it are not: a non-bool here is
    # read through bool() by night_shift_active() and cannot fail, where a
    # malformed time would reach minutes() and raise.
    "appearance.night_shift_enabled": {
        "default": True, "kind": "unchecked", "route": "night_shift",
    },
    "appearance.night_shift_start": {
        "default": "18:00", "kind": "time", "route": "night_shift",
    },
    "appearance.night_shift_end": {
        "default": "06:00", "kind": "time", "route": "night_shift",
    },
    # Kelvin. The range is hyprsunset's: below 1000 the screen goes orange
    # enough to be unusable, above 10000 it stops being a shift at all.
    "appearance.night_shift_temperature": {
        "default": 4500, "kind": "int", "minimum": 1000, "maximum": 10000,
        "route": "night_shift",
    },
    # "auto" follows theme_light_at / theme_dark_at; the other two pin it.
    "appearance.theme_mode": {
        "default": "dark", "kind": "enum", "members": {"light", "dark", "auto"},
        "route": "theme",
    },
    "appearance.theme_light_at": {
        "default": "07:00", "kind": "time", "route": "theme",
    },
    "appearance.theme_dark_at": {
        "default": "19:00", "kind": "time", "route": "theme",
    },
    # The same withdrawn-name case as wallpaper_fit, one step further on: a file
    # that escaped the version stamp -- restored from a backup, or hand-edited --
    # still carries a name from the old corner radius scale, and it means what
    # the new name says. CORNER_RADIUS_STALE is the subset of the rename map
    # that cannot be confused with a current name, so it is safe to apply
    # unconditionally here; the ambiguous half is gated on the stamp in
    # migrate_preference_values().
    "appearance.corner_radius": {
        "default": "normal", "kind": "enum", "members": CORNER_RADII,
        "renames": CORNER_RADIUS_STALE, "route": "corner_radius",
    },
    # px per window edge. Ten is already a frame rather than a border.
    "appearance.border_size": {
        "default": 0, "kind": "int", "minimum": 0, "maximum": 10,
        "route": "border",
    },
    "appearance.reduce_motion": {
        "default": False, "kind": "bool", "route": "motion",
    },
    # A multiplier over the durations in ANIMATION_LEAVES; see MOTION_SPEED_RANGE
    # for why the ends are where they are.
    "appearance.animation_speed": {
        "default": 1.0, "kind": "float",
        "minimum": MOTION_SPEED_RANGE[0], "maximum": MOTION_SPEED_RANGE[1],
        "route": "motion",
    },
    "appearance.search_engine": {
        "default": "google", "kind": "enum", "members": SEARCH_ENGINES,
        "route": "search",
    },
    # Only a template a query cannot be put into is dropped. An empty one is the
    # state the pane is in for as long as it takes to fill the field in after
    # choosing "custom", and render_search_engine() already falls back for it --
    # so clearing this when the engine is not "custom" would make custom
    # impossible to select. Hence `also` rather than a stricter kind: the
    # condition is about search_engine, not about this value alone.
    "appearance.search_custom_url": {
