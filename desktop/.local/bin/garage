HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))

# Three layers, in the order they win, and nothing writes to a layer above its
# own:
#
#   1. Shipped defaults -- preferences.defaults.toml, read-only, reaching
#      ~/.config/garage as a stow symlink into the dotfiles checkout. Every key
#      the schema has, with the value a fresh install starts on.
#   2. Host preferences -- ROOT, the only user-owned files on the machine: the
#      four below, each holding the deliberate departures from layer 1 and
#      nothing else. Back these up and the desktop comes back.
#   3. Generated state -- STATE_ROOT, machine-written and deletable. Every
#      fragment under it is rewritten from layers 1 and 2 by `garage render`, so
#      losing the whole directory costs one render and no settings.
#
# Kept apart because they have different lifetimes: layer 1 moves with the
# checkout, layer 2 must survive a reinstall, and layer 3 is a cache that has to
# be safe to throw away. Generated output used to sit inside layer 2, where
# deleting the cache meant deleting the user's settings beside it.
ROOT = CONFIG_HOME / "garage"
STATE_ROOT = STATE_HOME / "garage"
DEFAULTS_PATH = ROOT / "preferences.defaults.toml"
PREFERENCES_PATH = Path(os.environ.get("GARAGE_PREFERENCES", ROOT / "preferences.toml"))
DISPLAYS_PATH = Path(os.environ.get("GARAGE_DISPLAYS", ROOT / "displays.toml"))
# A file of its own, next to displays.toml and for the same reason: the
# shortcuts are a list of records, and preferences.toml is a flat section/key
# whitelist that has nowhere to put one.
KEYBINDINGS_PATH = Path(os.environ.get("GARAGE_KEYBINDINGS", ROOT / "keybindings.toml"))
# Which block of workspace ids each display owns. Not in displays.toml, though it
# is per-display state: that file is rewritten from the monitors Hyprland can see
# whenever a layout is applied, so a display that happened to be asleep would
# lose its block and be handed somebody else's on the way back.
WORKSPACE_BLOCKS_PATH = Path(os.environ.get("GARAGE_WORKSPACE_BLOCKS",
                                            ROOT / "workspace-blocks.toml"))
GENERATED = STATE_ROOT / "generated"
HYPRLAND_FRAGMENT = GENERATED / "preferences.lua"
DISPLAY_FRAGMENT = GENERATED / "displays.lua"
WORKSPACES_FRAGMENT = GENERATED / "workspaces.lua"
KEYBINDS_DATA = GENERATED / "keybinds.json"
KEYBINDS_CATALOG = GENERATED / "keybinds.catalog"
HYPRIDLE_CONFIG = GENERATED / "hypridle.conf"
HYPRPAPER_CONFIG = GENERATED / "hyprpaper.conf"
WALLPAPER_DIR = HOME / ".local/share/wallpaper"
CURRENT_WALLPAPER = WALLPAPER_DIR / "current"
ACCENT_FILE = GENERATED / "accent"
SCHEME_FILE = GENERATED / "color-scheme"
SEARCH_FILE = GENERATED / "search-engine"
BAR_FG_FILE = GENERATED / "bar-foreground"
CORNER_RADIUS_FILE = GENERATED / "corner-radius"
MATERIAL_FILE = GENERATED / "material"
LAUNCHER_FILE = GENERATED / "launcher"
TERMINAL_FILE = GENERATED / "terminal"
BROWSER_FILE = GENERATED / "browser"
LOCALE_ENV = GENERATED / "locale.env"
WAYBAR_CLOCK = GENERATED / "waybar-clock.jsonc"
WAYBAR_WORKSPACES = GENERATED / "waybar-workspaces.jsonc"

# The bar's left side, which is what the workspace indicator is toggled out of.
# waybar cannot append to an array from an include -- an option is won by
# whichever file names it first, and config.jsonc is read before anything it
# includes -- so the whole list has to be published here for either variant of
# it to reach the bar. custom/menu is carried along unchanged.
WAYBAR_MODULES_LEFT = ["custom/menu"]
WAYBAR_WORKSPACE_MODULE = "hyprland/workspaces"

# Toolkit configs that offer no include or indirection mechanism, so a theme
# switch has to rewrite the file itself. They are deliberately not stowed: every
# other path under ~/.config is a symlink into the dotfiles repo, and rewriting
# one of those at runtime would edit a tracked file on every switch.
GTK3_SETTINGS = CONFIG_HOME / "gtk-3.0/settings.ini"
GTK4_SETTINGS = CONFIG_HOME / "gtk-4.0/settings.ini"
XSETTINGSD_CONF = CONFIG_HOME / "xsettingsd/xsettingsd.conf"
QT6CT_CONF = CONFIG_HOME / "qt6ct/qt6ct.conf"

# Where the default applications are written. Not ~/.config/mimeapps.list: that
# path is a stow symlink into the dotfiles repo, and every writer of it -- xdg-mime
# included -- renames a temporary over it, which replaces the link with a plain
# file and cuts the config loose from the repo. The spec reads a
# <desktop>-prefixed list ahead of the plain one, so this file wins outright
# while the tracked one stays exactly as checked in.
MIMEAPPS_DESKTOP = (os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")[0] or "hyprland").lower()
MIMEAPPS_OVERRIDE = CONFIG_HOME / f"{MIMEAPPS_DESKTOP}-mimeapps.list"

THEME_TOOLKITS = {
    "dark": {"gtk": "adw-gtk3-dark", "icons": "Papirus-Dark",
             "prefer_dark": 1, "scheme": "prefer-dark", "qt_colors": "vanta.conf"},
    "light": {"gtk": "adw-gtk3", "icons": "Papirus-Light",
              "prefer_dark": 0, "scheme": "prefer-light", "qt_colors": "vanta-light.conf"},
}
PENDING_DISPLAY = STATE_ROOT / "display-pending.json"
DISPLAY_LOCK = STATE_ROOT / "display-transaction.lock"
PREFERENCES_LOCK = STATE_ROOT / "preferences.lock"

# Stamp carried in preferences.toml, read by migrate_preferences(). Bump it, and
# add the coercion there, whenever a stored value changes meaning rather than
# just changing range.
PREFERENCES_VERSION = 4

# Where layer 2 was kept before the rename, and the files that belong to the
# user rather than to the machine -- the whole of what v4 has to carry across.
# Each is mapped to the path this process would read it from, so the move lands
# where the session is actually looking.
LEGACY_ROOT = CONFIG_HOME / "workstation"
MIGRATED_FILES = {
    "preferences.toml": PREFERENCES_PATH,
    "displays.toml": DISPLAYS_PATH,
    "keybindings.toml": KEYBINDINGS_PATH,
    "workspace-blocks.toml": WORKSPACE_BLOCKS_PATH,
}

