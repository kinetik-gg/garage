    # untouched -- so this is the one workspaces key that does not disturb the
    # compositor.
    "workspaces.indicator": {
        "default": True, "kind": "bool", "route": "workspace_indicator",
    },
    # Normalised rather than checked in place, and never reported: the pane sends
    # the whole map on every edit, so rewriting it as whatever parsing understood
    # means a hand-typed stray comma is dropped once instead of being carried
    # back out to the file on every later save. parse_workspace_counts() is
    # lenient by design -- see its docstring -- so there is no invalid value here
    # to coerce, only a value to restate.
    "workspaces.counts": {
        "default": "", "kind": "normalised", "route": "workspaces",
        "normalise": lambda value: format_workspace_counts(
            parse_workspace_counts(value)),
