GRAPH_TOP = 3
GRAPH_HEIGHT = 16
GRAPH_BOTTOM = GRAPH_TOP + GRAPH_HEIGHT


# ---------------------------------------------------------------------------
# Tolerant primitives
#
# Every source below is optional hardware. A missing file is the normal case on
# somebody else's machine, not an error, so the readers return None and the
# callers decide what a missing number means for their metric. Nothing in this
# file may raise its way out to a traceback in the bar.
# ---------------------------------------------------------------------------


def read_text(path: Path) -> str | None:
    try:
        return path.read_text().strip()
    except (OSError, UnicodeDecodeError):
        return None


def read_int(path: Path) -> int | None:
    text = read_text(path)
    try:
        return int(text)
    except (TypeError, ValueError):
        return None


def run(command: list[str], timeout: float = 2) -> str | None:
    """Best-effort subprocess. A missing binary is a None, not an exception."""
    try:
        result = subprocess.run(command, text=True, capture_output=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout


def atomic_write(path: Path, text: str) -> None:
    """Replace `path` in one step, matching the backend's writer.

    Waybar reads the SVG the instant the path is printed, and the popover reads
    the history files while the bar is writing them. A partial file would be
    read as a broken image or as corrupt JSON, so the write lands under a
    temporary name and arrives whole.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def rate(current: int | None, previous: int | None, elapsed: float) -> float:
    """Per-second delta, floored at zero.

    Counters reset when an interface goes down or a device is re-plugged, and a
    reset read as a delta is a spectacular negative spike. Clamping is the only
    honest answer: the rate over an interval that contains a reset is unknown,
    and zero is closer than minus four gigabytes.
    """
    if current is None or previous is None or elapsed <= 0:
        return 0.0
    return max(0, current - previous) / elapsed


def log_scale(mib_per_second: float) -> float:
    """Throughput as 0..100 on the log curve the old disk graph used."""
    return min(100.0, math.log1p(max(0.0, mib_per_second)) / math.log1p(LOG_CEILING_MIB) * 100)


def compact_rate(mib_per_second: float) -> str:
    if mib_per_second >= 1024:
        return f"{mib_per_second / 1024:.1f}G"
    if mib_per_second >= 1:
        return f"{mib_per_second:.1f}M"
    return f"{mib_per_second * 1024:.0f}K"


def compact_span(seconds: float) -> str:
    if seconds < 90:
        return f"{seconds:.0f}s"
    return f"{seconds / 60:.1f} min"


# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------


def cpu_counters() -> tuple[int, int]:
    """Aggregate jiffies and idle jiffies from /proc/stat's first line."""
    fields = [int(value) for value in Path("/proc/stat").read_text().splitlines()[0].split()[1:]]
    return sum(fields), fields[3] + fields[4]


def cpu_core_counters() -> list[tuple[int, int]]:
    cores = []
    for line in Path("/proc/stat").read_text().splitlines():
        if not line.startswith("cpu") or not line[3:4].isdigit():
            continue
        fields = [int(value) for value in line.split()[1:]]
        cores.append((sum(fields), fields[3] + fields[4]))
    return cores


def cpu_percent(current: tuple[int, int], previous: tuple[int, int] | None) -> float:
    if previous is None:
        return 0.0
    total_delta = current[0] - previous[0]
    idle_delta = current[1] - previous[1]
    if total_delta <= 0:
        return 0.0
    return max(0.0, min(100.0, 100 * (1 - idle_delta / total_delta)))


def loadavg() -> list[float] | None:
    text = read_text(Path("/proc/loadavg"))
    if not text:
        return None
    try:
        return [float(value) for value in text.split()[:3]]
    except ValueError:
        return None


def memory_values() -> dict:
    values = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        key, value = line.split(":", 1)
        values[key] = int(value.split()[0]) * 1024
    total = values["MemTotal"]
    available = values.get("MemAvailable", values.get("MemFree", 0))
    used = total - available
    return {
        "used": used,
        "total": total,
        "available": available,
        "percent": used / total * 100 if total else 0.0,
    }


def memory_pressure() -> float | None:
    """PSI some avg10 for memory, or None where PSI is not compiled in.

    "some" rather than "full": some is the share of time at least one task was
    stalled waiting on memory, which is the number that moves before anything
    is visibly wrong. full only moves once nothing can run at all.
    """
    text = read_text(Path("/proc/pressure/memory"))
    if not text:
        return None
    for line in text.splitlines():
        if not line.startswith("some"):
            continue
        for field in line.split()[1:]:
            key, _, value = field.partition("=")
            if key == "avg10":
                try:
                    return float(value)
                except ValueError:
                    return None
    return None


# Preference order, not discovery order. A box can expose several of these at
# once (k10temp plus an nct6xxx superio that also claims a CPU reading) and
# k10temp/coretemp are the ones reading the on-die sensor.
CPU_TEMP_CHIPS = ("k10temp", "coretemp", "zenpower")

# The package or control temperature, whichever the chip calls it. temp1_input
# on a k10temp is Tctl and on a coretemp is core 0, so the labels are what
# actually distinguish "the CPU is this hot" from "one core is this hot".
PACKAGE_LABELS = ("tctl", "tdie", "package id 0", "package")


def cpu_temperature() -> tuple[float | None, str | None]:
    """The CPU package temperature, found by chip name rather than by index.

    hwmon numbering is assigned in probe order and probe order is not stable
    across boots -- the NVMe controller and the GPU race the CPU sensor for
    hwmon0 -- so anything that hardcodes an index reports the SSD's temperature
    after an unlucky reboot. The scan is eight small reads and costs well under
    a millisecond, which is cheaper than being wrong.
    """
    chips: dict[str, Path] = {}
    for name_file in sorted(Path("/sys/class/hwmon").glob("*/name")):
        name = read_text(name_file)
        if name in CPU_TEMP_CHIPS:
            chips.setdefault(name, name_file.parent)

    for chip in CPU_TEMP_CHIPS:
        root = chips.get(chip)
        if root is None:
            continue
        labelled: dict[str, tuple[str, Path]] = {}
        for label_file in sorted(root.glob("temp*_label")):
            label = read_text(label_file)
            if label:
                input_path = label_file.with_name(label_file.name.replace("_label", "_input"))
                labelled.setdefault(label.lower(), (label, input_path))
        for wanted in PACKAGE_LABELS:
            entry = labelled.get(wanted)
            if entry is None:
                continue
            milli = read_int(entry[1])
            if milli is not None:
                return milli / 1000, f"{chip} {entry[0]}"
        milli = read_int(root / "temp1_input")
        if milli is not None:
            return milli / 1000, chip

    # Last resort for boxes with no hwmon CPU driver at all -- most ARM SoCs,
    # some VMs. Reported under its own zone type so nobody mistakes it for a
    # package reading.
    for type_file in sorted(Path("/sys/class/thermal").glob("thermal_zone*/type")):
        zone_type = (read_text(type_file) or "").lower()
        if "x86_pkg" in zone_type or "cpu" in zone_type or "soc" in zone_type:
            milli = read_int(type_file.with_name("temp"))
            if milli is not None:
                return milli / 1000, zone_type
    return None, None


def default_interface() -> str | None:
    """The interface carrying the default route, from /proc/net/route.

    Named interfaces drift (enp11s0 today, enp12s0 after a BIOS update) and a
    machine with docker0, a VPN and wifi has half a dozen of them. The default
    route is the one definition of "the network" that stays true.
    """
    text = read_text(Path("/proc/net/route"))
    if not text:
        return None
    for line in text.splitlines()[1:]:
        fields = line.split()
        if len(fields) > 3 and fields[1] == "00000000" and int(fields[3], 16) & 2:
            return fields[0]
    return None


def network_counters(interface: str) -> tuple[int | None, int | None]:
    root = Path(f"/sys/class/net/{interface}/statistics")
    return read_int(root / "rx_bytes"), read_int(root / "tx_bytes")


def disk_device_override() -> str | None:
    """WAYBAR_DISK_DEVICE, for a root this cannot follow on its own.

    LVM, LUKS, bcachefs across two drives -- findmnt names a mapper device that
    has no sysfs stat of its own. Kept separate from detection because the
    override has to beat the cached device in the state file, and a caller that
    only consulted detect_block_device() would keep using yesterday's answer.
    """
    override = os.environ.get("WAYBAR_DISK_DEVICE", "").strip().removeprefix("/dev/")
    return override or None


def detect_block_device() -> str | None:
    """The whole disk backing /, not the partition.

    /sys/class/block/<part>/stat counts only that partition's traffic, so a
    graph built on it misses everything on /home or a swap partition on the
    same drive. findmnt gives the partition; the sysfs symlink's parent gives
    the disk it belongs to.
    """
    override = disk_device_override()
    if override:
        return override

    source = run(["findmnt", "--noheadings", "--output", "SOURCE", "/"])
    if source:
        # btrfs reports "/dev/nvme0n1p2[/@]" -- the subvolume is not part of
        # the device path.
        name = Path(source.strip().split("[", 1)[0]).name
        sys_path = Path("/sys/class/block") / name
        if (sys_path / "partition").exists():
            return sys_path.resolve().parent.name
        if sys_path.exists():
            return name

    for pattern in ("nvme*n*", "sd*", "vd*", "mmcblk*"):
        for path in sorted(Path("/sys/class/block").glob(pattern)):
            if not (path / "partition").exists():
                return path.name
    return None


def disk_counters(device: str) -> tuple[int | None, int | None]:
    """Sectors read and written. Fields 3 and 7 of the sysfs stat line."""
    text = read_text(Path(f"/sys/class/block/{device}/stat"))
    if not text:
        return None, None
    fields = text.split()
    if len(fields) < 7:
        return None, None
    try:
        return int(fields[2]), int(fields[6])
    except ValueError:
        return None, None


def sector_size(device: str) -> int:
    return read_int(Path(f"/sys/class/block/{device}/queue/hw_sector_size")) or 512


def disk_temperature(device: str) -> float | None:
    for sensor in sorted(Path(f"/sys/class/block/{device}/device").glob("hwmon*/temp1_input")):
        milli = read_int(sensor)
        if milli is not None:
            return milli / 1000
    return None


# ---------------------------------------------------------------------------
# GPUs
#
# Three vendors, three completely different stories, and only two of them can
# answer "how busy are you".
#
#   NVIDIA  nvidia-smi. Nothing useful in sysfs under the proprietary driver --
#           /sys/class/drm/cardN/device carries no busy or VRAM attributes at
#           all -- so the subprocess is not laziness, it is the only interface.
#   AMD     amdgpu sysfs. gpu_busy_percent and mem_info_vram_* are free reads.
#   Intel   No busy percentage exists outside of perf counters that need root
#           or CAP_PERFMON. So this reports the frequency ratio and says so.
#           Presenting that ratio as "utilization" would be a fabrication: a
#           GPU can sit at max clock doing nothing.
# ---------------------------------------------------------------------------

# Where a GPU stops being an aperture carved out of system RAM and starts being
# a card with its own memory. There is no sysfs flag for this -- an APU and a
# dGPU are both PCI class 0x030000 behind a bridge -- and a device-id table
# would be stale within a generation. VRAM size is the one signal that has
# stayed true: integrated parts carve 512 MiB to 2 GiB, discrete cards start at
# 4. It only decides which GPU the bar's single strip follows, and the bar
# falls back to whatever is present if the guess finds nothing.
DISCRETE_VRAM_FLOOR = 4 * 1024**3


def nvidia_gpus() -> list[dict]:
    output = run([
        "nvidia-smi",
        "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
        "--format=csv,noheader,nounits",
    ])
    if not output:
        return []
    gpus = []
    for line in output.splitlines():
        parts = [part.strip() for part in line.split(",")]
        if len(parts) != 5:
            continue
        name = parts[0]
        try:
            load = float(parts[1])
            used = int(parts[2]) * MIB
            total = int(parts[3]) * MIB
            temperature = float(parts[4])
        except ValueError:
            continue
        gpus.append({
            "name": name,
            "vendor": "nvidia",
            "load": load,
            "load_kind": "utilization",
            "vram_used": used,
            "vram_total": total,
            "temp_c": temperature,
            "discrete": True,
        })
    return gpus


def _drm_hwmon_temp(device: Path) -> float | None:
    for sensor in sorted(device.glob("hwmon/hwmon*/temp1_input")):
        milli = read_int(sensor)
        if milli is not None:
            return milli / 1000
    return None


def _drm_devices(vendor_id: str) -> list[Path]:
    devices = []
    for card in sorted(Path("/sys/class/drm").glob("card[0-9]*")):
        # card1-HDMI-A-1 and friends are connectors, not cards.
        if "-" in card.name:
            continue
        device = card / "device"
        if read_text(device / "vendor") == vendor_id:
            devices.append(device)
    return devices


def amd_gpus() -> list[dict]:
    gpus = []
    for device in _drm_devices("0x1002"):
        total = read_int(device / "mem_info_vram_total")
        used = read_int(device / "mem_info_vram_used")
        busy = read_int(device / "gpu_busy_percent")
        if total is None and busy is None:
            continue
        gpus.append({
            "name": read_text(device / "product_name") or "AMD Radeon Graphics",
            "vendor": "amd",
            "load": float(busy) if busy is not None else None,
            "load_kind": "utilization" if busy is not None else None,
            "vram_used": used,
            "vram_total": total,
            "temp_c": _drm_hwmon_temp(device),
            "discrete": bool(total and total >= DISCRETE_VRAM_FLOOR),
        })
    return gpus


def intel_gpus() -> list[dict]:
    gpus = []
    for device in _drm_devices("0x8086"):
        card = device.parent
        # i915 hangs the frequency knobs off the card, xe off a per-tile path.
        actual = read_int(card / "gt_act_freq_mhz")
        maximum = read_int(card / "gt_max_freq_mhz")
        if actual is None:
            actual = read_int(device / "tile0/gt0/freq0/act_freq")
            maximum = read_int(device / "tile0/gt0/freq0/max_freq")
        load = None
        if actual is not None and maximum:
            load = min(100.0, actual / maximum * 100)
        total = read_int(device / "lmem_total_bytes")
        gpus.append({
            "name": read_text(device / "product_name") or "Intel Graphics",
            "vendor": "intel",
            "load": load,
            # Never called utilization. See the comment above this section.
            "load_kind": "activity (freq proxy)" if load is not None else None,
            "vram_used": None,
            "vram_total": total,
            "temp_c": _drm_hwmon_temp(device),
            "discrete": bool(total and total >= DISCRETE_VRAM_FLOOR),
        })
    return gpus


def discover_gpus() -> list[dict]:
    """Every GPU on the box, discrete ones first.

    Order matters because the bar has room for exactly one GPU strip and the
    discrete card is the one whose load anybody is watching.
    """
    gpus = nvidia_gpus() + amd_gpus() + intel_gpus()
    gpus.sort(key=lambda gpu: not gpu.get("discrete"))
    return gpus


def primary_gpu(gpus: list[dict]) -> dict | None:
    return gpus[0] if gpus else None


# ---------------------------------------------------------------------------
# Bar state
#
# One JSON file per widget, holding the rolling history and whatever raw
# counters that widget's next delta needs. Written under flock because two
# waybar ticks can overlap and a lost update is a visible notch in the graph.
# ---------------------------------------------------------------------------


def load_state(path: Path) -> dict:
    try:
        state = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def push_history(state: dict, key: str, value: float) -> None:
    """Append one point, priming a fresh graph flat rather than ramping.

    A new history filled with zeros draws a line climbing from the floor to the
    current value over the first four minutes, which reads as a load spike that
    never happened. Filling it with the first real sample draws a flat line,
    which is the honest claim: nothing is known about before now.
    """
    history = state.get(key)
    if not isinstance(history, list) or not history:
        history = [value] * POINTS
    else:
        history = (history + [value])[-POINTS:]
    state[key] = history


def sample_widget(widget: str, state: dict, now: float) -> dict:
    """Read one widget's sources and return its display fields.

    Returns the fields to merge into the state -- value/value2 feed the graph,
    display/extra/tooltip feed the strip, counters carry the next delta. Only
    the requested widget's sources are touched.
    """
    if widget == "cpu":
        counters = cpu_counters()
        previous = state.get("counters")
        percent = cpu_percent(counters, tuple(previous) if isinstance(previous, list) and len(previous) == 2 else None)
        load = loadavg()
        parts = [f"CPU {percent:.1f}%"]
        if load:
            parts.append(f"load {load[0]:.2f} {load[1]:.2f} {load[2]:.2f}")
        return {
            "value": percent,
            "display": f"{percent:.0f}%",
            "tooltip_parts": parts,
            "active": percent >= 25,
            "counters": list(counters),
        }

    if widget == "memory":
        memory = memory_values()
        pressure = memory_pressure()
        parts = [
            f"Memory {memory['used'] / 1024**3:.1f} / {memory['total'] / 1024**3:.1f} GiB "
            f"({memory['percent']:.1f}%)",
            f"available {memory['available'] / 1024**3:.1f} GiB",
        ]
        if pressure is not None:
            parts.append(f"pressure {pressure:.2f}%")
        return {
            "value": memory["percent"],
            "display": f"{memory['percent']:.0f}%",
            "tooltip_parts": parts,
            "active": memory["percent"] >= 70,
        }

    if widget == "temp":
        celsius, label = cpu_temperature()
        if celsius is None:
            raise OSError("no CPU temperature sensor")
        return {
            "value": max(0.0, min(100.0, celsius)),
            "display": f"{celsius:.0f}°",
            "tooltip_parts": [f"CPU {celsius:.1f}°C", label or "unknown sensor"],
            "active": celsius >= 75,
        }

    if widget == "network":
        # Re-detected every tick rather than cached: /proc/net/route is one
        # cheap read, and a VPN coming up moves the default route to a new
        # interface while the old one is still present, so a cached name would
        # keep reporting a link that no longer carries anything.
        interface = default_interface()
        if not interface:
            raise OSError("no default route")
        received, sent = network_counters(interface)
        if received is None or sent is None:
            raise OSError(f"no counters for {interface}")
        # Counters belong to an interface, so a route that moved invalidates
        # them -- a fresh card's small counters against the old card's large
        # ones is a negative delta, and clamping that to zero would still be a
        # made-up number rather than a missing one.
        previous = state.get("counters") if state.get("device") == interface else None
        down = up = 0.0
        if isinstance(previous, list) and len(previous) == 3:
            elapsed = now - previous[2]
            down = rate(received, previous[0], elapsed) / MIB
            up = rate(sent, previous[1], elapsed) / MIB
        return {
            "value": log_scale(down),
            "value2": log_scale(up),
            "display": compact_rate(down),
            "extra": compact_rate(up),
            "tooltip_parts": [
                interface,
                f"↓ {down:,.2f} MiB/s",
                f"↑ {up:,.2f} MiB/s",
            ],
            "active": down + up >= 0.1,
            "device": interface,
            "counters": [received, sent, now],
        }

    if widget == "disk":
        # Cached across ticks because detection shells out to findmnt and the
        # root device does not move while the session is up. Revalidated every
        # tick against the stat file, so an override or a re-plug still lands.
        device = disk_device_override() or state.get("device")
        if not device or not Path(f"/sys/class/block/{device}/stat").exists():
            device = detect_block_device()
        if not device:
            raise OSError("no block device backing /")
        read_sectors, write_sectors = disk_counters(device)
        if read_sectors is None:
            raise OSError(f"no stat for {device}")
        previous = state.get("counters") if state.get("device") == device else None
        read_mib = write_mib = 0.0
        if isinstance(previous, list) and len(previous) == 3:
            elapsed = now - previous[2]
            size = sector_size(device)
            read_mib = rate(read_sectors, previous[0], elapsed) * size / MIB
            write_mib = rate(write_sectors, previous[1], elapsed) * size / MIB
        total_mib = read_mib + write_mib
        celsius = disk_temperature(device)
        parts = [
            device,
            f"read {read_mib:,.1f} MiB/s",
            f"write {write_mib:,.1f} MiB/s",
        ]
        if celsius is not None:
            parts.append(f"{celsius:.1f}°C")
        parts.append("log scale")
        return {
            "value": log_scale(total_mib),
            "display": compact_rate(total_mib),
            "tooltip_parts": parts,
            "active": total_mib >= 1,
            "device": device,
            "counters": [read_sectors, write_sectors, now],
        }

    gpus = discover_gpus()
    gpu = primary_gpu(gpus)
    if gpu is None:
        raise OSError("no GPU found")
    load = gpu["load"]
    used = gpu.get("vram_used")
    total = gpu.get("vram_total")
    vram_percent = used / total * 100 if used is not None and total else None
    parts = [gpu["name"]]
    if load is not None:
        parts.append(f"{gpu['load_kind']} {load:.0f}%")
    if used is not None and total:
        parts.append(f"VRAM {used / 1024**3:.1f} / {total / 1024**3:.1f} GiB")
    elif total:
        parts.append(f"VRAM {total / 1024**3:.1f} GiB")
    if gpu.get("temp_c") is not None:
        parts.append(f"{gpu['temp_c']:.0f}°C")
    if len(gpus) > 1:
        parts.append(f"+{len(gpus) - 1} more GPU")
    return {
        "value": load if load is not None else 0.0,
        "value2": vram_percent,
        "display": f"{load:.0f}%" if load is not None else "--",
        "extra": f"{used / 1024**3:.1f}G" if used is not None else "",
        "tooltip_parts": parts,
        "active": bool(load is not None and load >= 10),
    }


def update_state(widget: str, state: dict, now: float) -> dict:
    """Fold one fresh sample into the widget's state, or reuse the last one."""
    if now - state.get("last_sample", 0) < MIN_SAMPLE_INTERVAL and state.get("history"):
        return state

    # Smoothed so the tooltip can say how much time the strip covers without
    # storing a timestamp per point. A tick that ran long or a machine that
    # slept would otherwise make one interval stand for all 120.
    previous_sample = state.get("last_sample")
    if previous_sample:
        period = now - previous_sample
        if 0 < period < 60:
            stored = state.get("period")
            state["period"] = period if not stored else stored * 0.8 + period * 0.2

    current = sample_widget(widget, state, now)
    push_history(state, "history", current["value"])
    if current.get("value2") is not None:
        push_history(state, "history2", current["value2"])

    state.update(current)
    state["last_sample"] = now
    return state


def mark_unavailable(widget: str, state: dict, error: object) -> None:
    """Degrade a widget to "n/a" in place, keeping whatever history exists.

    An unplugged interface or a GPU that went away mid-session must not blank
    the strip or fail the tick -- waybar treats a nonzero exit as a broken
    module and stops calling it at all.
    """
    state.update({
        "display": "n/a",
        "extra": "",
        "tooltip_parts": [f"{widget.upper()} unavailable", str(error)],
        "active": False,
    })
    state.setdefault("history", [0] * POINTS)


def tooltip_for(widget: str, state: dict) -> str:
    """One physical line, because waybar reads exactly one line as the tooltip.

    The parts are the lines the old per-module tooltips had; joining them with
    a separator is how activity-graph.py kept a multi-part tooltip inside the
    image module's two-line protocol.
    """
    parts = list(state.get("tooltip_parts") or [widget.upper()])
    period = state.get("period")
    if period:
        parts.append(f"last {compact_span(POINTS * period)}")
    return " | ".join(str(part) for part in parts)


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------


def _clamp_sample(value) -> float:
    """One stored reading as a number between 0 and 100, or 0 if it is neither."""
    try:
        return min(100.0, max(0.0, float(value)))
    except (TypeError, ValueError):
        return 0.0


def _resample(samples: list[float], columns: int) -> list[float]:
    """The history reduced to about one point per pixel of graph.

    POINTS is 120 and a strip's graph is 22px wide, so a line drawn straight
    from the history puts five vertices in every pixel column. On a steady
    series that is invisible; on a volatile one -- a GPU under load moving tens
    of percent a second -- the five disagree, and what renders is a vertical
    hash rather than a line. There is no more detail in it than the mean, only
    more ink: the strip does not have the pixels to say what those five samples
    did, and the dashboard, which does, plots the same history unreduced.

    The mean rather than the maximum of each bucket, because the maximum of five
    samples is what the busiest instant did and a strip of those reads as a
    machine permanently at full tilt.
    """
    if columns < 2 or len(samples) <= columns:
        return list(samples)
    reduced = []
    for index in range(columns):
        start = index * len(samples) // columns
        end = max(start + 1, (index + 1) * len(samples) // columns)
        bucket = samples[start:end]
        reduced.append(sum(bucket) / len(bucket))
    return reduced


def _coordinates(history: list[float], graph_x: float,
                 graph_width: float) -> list[tuple[float, float]]:
    """The stored history as points, plotted straight.

    The axis is linear because every history that needs a logarithm has already
    had one. Throughput is stored through log_scale() at the moment it is
    sampled, since idle is 0.01 MiB/s and an NVMe burst is 3000; the rest are
    percentages, and a percentage is already the scale it wants to be read on.

    Curving them again was worse than redundant. log1p put 1% of load at 15% of
    the graph's height and 20% at 66%, so a card ticking over near idle drew a
    line thrashing across the full height of the strip -- and a 45C package
    reading sat just under the top of its graph.
    """
    samples = _resample([_clamp_sample(value) for value in history],
                        max(2, int(round(graph_width)) + 1))
    if len(samples) == 1:
        samples = samples * 2
    span = max(1, len(samples) - 1)
    coordinates = []
    for index, value in enumerate(samples):
        x = graph_x + index * graph_width / span
        y = GRAPH_BOTTOM - value / 100 * GRAPH_HEIGHT
        coordinates.append((x, y))
    return coordinates


def _render_glyph(name: str, x: float = 0) -> str:
    """One Phosphor glyph in the strip's shared 14px icon box."""
    top = (22 - ICON_SIZE) / 2
    return (f'<g transform="translate({x:g} {top:g}) scale({ICON_SIZE / 256:.6f})" '
            f'fill="{THEME_FG}" fill-opacity="{ICON_OPACITY}">'
            f'<path d="{ICON_PATHS[name]}"/></g>')


def _render_icon(layout: dict) -> str:
    """The metric's identifying glyph, when the strip needs one."""
    return _render_glyph(layout["icon"])


def _render_graph(layout: dict, state: dict) -> str:
    graph_x = layout["graph_x"]
    graph_width = layout["graph_width"]

    history = state.get("history") or [0.0] * POINTS
    coordinates = _coordinates(list(history), graph_x, graph_width)
    points = " ".join(f"{x:.2f},{y:.2f}" for x, y in coordinates)
    area = (
        f"M {coordinates[0][0]:.2f} {GRAPH_BOTTOM} "
        + " ".join(f"L {x:.2f} {y:.2f}" for x, y in coordinates)
        + f" L {coordinates[-1][0]:.2f} {GRAPH_BOTTOM} Z"
    )

    # The second series gets no fill and a thinner, dimmer stroke: two filled
    # areas at 8% stack into a muddy block where they overlap, and the whole
    # point of the second line is that it reads as subordinate to the first.
    secondary = ""
    history2 = state.get("history2")
    if isinstance(history2, list) and history2:
        second = _coordinates(list(history2), graph_x, graph_width)
        second_points = " ".join(f"{x:.2f},{y:.2f}" for x, y in second)
        secondary = (
            f'\n  <polyline points="{second_points}" fill="none" stroke="{THEME_FG}" '
            f'stroke-opacity="0.34" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>'
        )

    opacity = "0.92" if state.get("active") else "0.62"

    midline = GRAPH_TOP + GRAPH_HEIGHT / 2
    return f'''<path d="M {graph_x} {midline:.1f} H {graph_x + graph_width}" stroke="{THEME_FG}" stroke-opacity="0.10" stroke-width="1"/>
  <path d="M {graph_x} {GRAPH_BOTTOM} H {graph_x + graph_width}" stroke="{THEME_FG}" stroke-opacity="0.16" stroke-width="1"/>
  <path d="{area}" fill="{THEME_FG}" fill-opacity="0.08"/>
  <polyline points="{points}" fill="none" stroke="{THEME_FG}" stroke-opacity="{opacity}" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>{secondary}'''


def render_widget(widget: str, state: dict) -> str:
    """Optional icon and graph, then the strip's one or two readings.

    Network has neither: its down/up arrows label the figures directly. Keeping
    icon and graph independently optional avoids reserving an empty leading box.
    """
    layout = LAYOUTS[widget]
    display = html.escape(str(state.get("display", "--")))
    extra = html.escape(str(state.get("extra", "")))
    extra_text = ""
    if extra and "extra_x" in layout:
        extra_text = f'\n  <text x="{layout["extra_x"]}" y="11" class="secondary">{extra}</text>'

    icon = f"{_render_icon(layout)}\n  " if "icon" in layout else ""
    if "down_icon_x" in layout:
        icon = (_render_glyph("arrow-down", layout["down_icon_x"])
                + "\n  " + _render_glyph("arrow-up", layout["up_icon_x"]) + "\n  ")
    graph = f"{_render_graph(layout, state)}\n  " if "graph_width" in layout else ""
    return f'''{icon}{graph}<text x="{layout["value_x"]}" y="11">{display}</text>{extra_text}'''


def render_svg(widget: str, state: dict) -> str:
    width = LAYOUTS[widget]["width"]
    return f'''<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="22" viewBox="0 0 {width} 22">
  <style>
    text {{ font-family: "Plus Jakarta Sans", sans-serif; font-size: 11.5px; font-weight: 600; dominant-baseline: central; fill: {THEME_FG}; fill-opacity: 1.0; }}
    .secondary {{ fill-opacity: 0.75; }}
  </style>
  {render_widget(widget, state)}
</svg>
'''


# ---------------------------------------------------------------------------
# Snapshots
# ---------------------------------------------------------------------------


class Snapshotter:
    """Full-system snapshots with the counters a rate needs held in memory.

    Deliberately does not touch the bar's history files. The bar owns those and
    guards them with a minimum sample interval; a second writer at 1 Hz would
    double the sample rate and the two would race over the same 120 slots. The
    popover reads that history exactly once, as the seed, and keeps its own
    from there.
    """

    def __init__(self) -> None:
        self.device = detect_block_device()
        self.sector_size = sector_size(self.device) if self.device else 512
        self.interface = default_interface()
        self.previous: dict | None = None

    def _counters(self) -> dict:
        received = sent = None
        if self.interface:
            received, sent = network_counters(self.interface)
        read_sectors = write_sectors = None
        if self.device:
            read_sectors, write_sectors = disk_counters(self.device)
        return {
            "ts": time.time(),
            "cpu": cpu_counters(),
            "cores": cpu_core_counters(),
            "rx": received,
            "tx": sent,
            "reads": read_sectors,
            "writes": write_sectors,
        }

    def prime(self) -> None:
        self.previous = self._counters()

    def snapshot(self) -> dict:
        current = self._counters()
        previous = self.previous
        elapsed = current["ts"] - previous["ts"] if previous else 0.0

        cores = []
        if previous and len(previous["cores"]) == len(current["cores"]):
            cores = [
                round(cpu_percent(now, before), 2)
                for now, before in zip(current["cores"], previous["cores"])
            ]

        # Re-detected each snapshot: a VPN coming up or a dock being plugged in
        # moves the default route mid-stream, and a stream that pinned the
        # interface at startup would silently report zero forever.
        interface = default_interface()
        if interface != self.interface:
            self.interface = interface
            previous = None

        memory = memory_values()
        celsius, label = cpu_temperature()
        self.previous = current

        return {
            "ts": current["ts"],
            "cpu": {
                "load": round(cpu_percent(current["cpu"], previous["cpu"] if previous else None), 2),
                "per_core": cores,
                "loadavg": loadavg(),
            },
            "temp": {"cpu_c": celsius, "label": label},
            "memory": {
                "used": memory["used"],
                "total": memory["total"],
                "available": memory["available"],
                "pressure_some_avg10": memory_pressure(),
            },
            "network": {
                "iface": self.interface,
                "rx_bps": round(rate(current["rx"], previous["rx"] if previous else None, elapsed), 1),
                "tx_bps": round(rate(current["tx"], previous["tx"] if previous else None, elapsed), 1),
            },
            "disk": {
                "device": self.device,
                "read_bps": round(
                    rate(current["reads"], previous["reads"] if previous else None, elapsed) * self.sector_size, 1
                ),
                "write_bps": round(
                    rate(current["writes"], previous["writes"] if previous else None, elapsed) * self.sector_size, 1
                ),
            },
            "gpus": discover_gpus(),
        }


def seed_object() -> dict:
    """The bar's stored history, so the popover's graphs open already drawn.

    Flat lists of numbers throughout, one key per series rather than tuples per
    point, so a consumer never has to branch on which widget it is holding.
    """
    seed: dict[str, list[float]] = {}
    for widget in WIDGETS:
        state = load_state(STATE_DIR / f"{widget}.json")
        history = state.get("history")
        if isinstance(history, list) and history:
            seed[widget] = history
        second = state.get("history2")
        if isinstance(second, list) and second:
            suffix = "up" if widget == "network" else "vram"
            seed[f"{widget}_{suffix}"] = second
    return {"ts": time.time(), "seed": seed}


# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------


def bar_svg(widget: str) -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    state_path = STATE_DIR / f"{widget}.json"
    svg_path = CACHE_DIR / f"{widget}.svg"

    with (STATE_DIR / f"{widget}.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_state(state_path)
        try:
            state = update_state(widget, state, time.time())
        except (OSError, ValueError, KeyError, IndexError, subprocess.SubprocessError) as error:
            mark_unavailable(widget, state, error)
        atomic_write(state_path, json.dumps(state))
        atomic_write(svg_path, render_svg(widget, state))

    print(svg_path)
    print(tooltip_for(widget, state))
    return 0


def stream() -> int:
    print(json.dumps(seed_object()), flush=True)
    snapshotter = Snapshotter()
    snapshotter.prime()
    # Paced against a deadline rather than sleeping a flat second, because a
    # snapshot costs ~30ms (nvidia-smi) and sleeping after it makes every
    # object 1.03s apart. The popover plots these on a fixed 1 Hz axis, so that
    # drift is a graph that runs slow by three percent forever.
    deadline = time.monotonic()
    while True:
        deadline += STREAM_INTERVAL
        time.sleep(max(0.0, deadline - time.monotonic()))
        try:
            print(json.dumps(snapshotter.snapshot()), flush=True)
        except BrokenPipeError:
            # The popover closed. Nothing to report and nowhere to report it.
            return 0
        except (OSError, ValueError) as error:
            print(json.dumps({"ts": time.time(), "error": str(error)}), flush=True)


def once() -> int:
    snapshotter = Snapshotter()
    snapshotter.prime()
    time.sleep(PRIME_DELAY)
    print(json.dumps(snapshotter.snapshot()))
    return 0


USAGE = """usage: garage-metrics --bar-svg <widget> | --stream | --once

  --bar-svg <widget>  render one waybar strip; prints the SVG path then the tooltip
  --stream            one JSON snapshot per line at 1 Hz, seeded from bar history
  --once              one JSON snapshot, then exit

  widgets: {widgets}
""".format(widgets=" ".join(WIDGETS))


def main(argv: list[str]) -> int:
    command = argv[1] if len(argv) > 1 else ""
    if command in {"-h", "--help", "help"}:
        print(USAGE, end="")
        return 0
    if command == "--bar-svg":
        widget = argv[2] if len(argv) > 2 else ""
        if widget not in LAYOUTS:
            print(USAGE, end="", file=sys.stderr)
            return 2
        return bar_svg(widget)
    if command == "--stream":
        return stream()
    if command == "--once":
        return once()
    print(USAGE, end="", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except KeyboardInterrupt:
        raise SystemExit(130)
