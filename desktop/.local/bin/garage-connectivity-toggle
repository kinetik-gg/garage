#!/bin/sh
set -eu

device=${1:-}
action=${2:-}

case "$device:$action" in
    wifi:set)
        if [ "${SWAYNC_TOGGLE_STATE:-false}" = true ]; then
            nmcli radio wifi on
        else
            nmcli radio wifi off
        fi
        ;;
    wifi:status)
        [ "$(nmcli radio wifi)" = enabled ] && echo true || echo false
        ;;
    bluetooth:set)
        if [ "${SWAYNC_TOGGLE_STATE:-false}" = true ]; then
            bluetoothctl power on
        else
            bluetoothctl power off
        fi
        ;;
    bluetooth:status)
        bluetoothctl show | grep -q "Powered: yes" && echo true || echo false
        ;;
    *)
        echo "usage: garage-connectivity-toggle {wifi|bluetooth} {set|status}" >&2
        exit 2
        ;;
esac
