#!/usr/bin/env bash
set -euo pipefail

# slurp must run as an interruptible background child, never inside a command
# substitution: a substitution is the script's foreground work, and bash defers
# signal traps until foreground work finishes -- so the shell's capture timeout
# (shell.qml's wedge guard, 120s) would kill this wrapper while slurp kept the
# screen grabbed. Measured: a forgotten region pick sat for six minutes and
# disarmed outside-click dismissal shell-wide. Backgrounding + wait lets the
# TERM through to slurp immediately.
pick() {
    local out_file=$1
    shift
    "$@" > "$out_file" &
    local pid=$!
    trap 'kill -TERM '"$pid"' 2>/dev/null || true' TERM INT
    local rc=0
    wait "$pid" || rc=$?
    trap - TERM INT
    return "$rc"
}

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

case "${1:-}" in
    region)
        pick "$tmp" slurp || exit 0
        geometry="$(<"$tmp")"
        grim -g "$geometry" - | wl-copy --type image/png
        ;;
    monitor)
        pick "$tmp" slurp -o -r -f '%o' || exit 0
        output="$(<"$tmp")"
        if [[ -z "$output" ]]; then
            notify-send --urgency=critical --expire-time=2400 "Screenshot failed" "No monitor was selected."
            exit 1
        fi
        grim -o "$output" - | wl-copy --type image/png
        ;;
    window)
        active_workspaces="$(hyprctl monitors -j | jq '[.[] | .activeWorkspace.id, .specialWorkspace.id] | map(select(. != 0))')"
        windows="$(hyprctl clients -j | jq --argjson active "$active_workspaces" -r '
            .[]
            | select(.mapped and (.hidden | not))
            | select(.pinned or (.workspace.id as $id | $active | index($id)))
            | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1]) \(.title | gsub("[\\r\\n]"; " "))"
        ')"
        if [[ -z "$windows" ]]; then
            notify-send --urgency=normal --expire-time=2400 "Screenshot" "No visible windows to capture."
            exit 0
        fi
        pick "$tmp" slurp -r <<< "$windows" || exit 0
        geometry="$(<"$tmp")"
        grim -g "$geometry" - | wl-copy --type image/png
        ;;
    *)
        echo "usage: garage-screenshot-copy {region|monitor|window}" >&2
        exit 2
        ;;
esac

notify-send --expire-time=1600 "Screenshot copied" "Image is ready to paste from the clipboard."
