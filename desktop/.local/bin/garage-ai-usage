#!/usr/bin/env python3
"""AI subscription usage widget data source, via Tokscale.

Modes:
  --bar    Compact waybar custom-module payload (return-type json).
  --json   Popover payload: subscriptions usage + today's token/cost totals.
  --probe  Locate the tokscale CLI; exit 0 + path, or exit 1 + reason.

Tokscale is optional. When it cannot be found, --bar prints an empty text
(so hide-empty-text hides the module) and exits 0, --probe exits nonzero
with a reason, and --json reports {"available": false}.
"""

import json
import math
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from zoneinfo import ZoneInfo


HOME = Path.home()
TOKSCALE_CANDIDATES = [HOME / ".local/share/tokscale/node_modules/.bin/tokscale"]
CACHE_DIR = HOME / ".cache/garage-ai-usage"
CACHE_FILE = CACHE_DIR / "usage.json"
TODAY_CACHE_FILE = CACHE_DIR / "today.json"
TODAY_CACHE_TTL = 120


def find_tokscale():
    """Return the tokscale CLI path, or None if it cannot be located."""
    for candidate in TOKSCALE_CANDIDATES:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)

    path_hit = shutil.which("tokscale")
    if path_hit:
        return path_hit

    return None


def valid(payload):
    return isinstance(payload, list) and any(
        item.get("provider") in {"Codex", "Claude"} for item in payload if isinstance(item, dict)
    )


def atomic_write_json(path, payload):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f"{path.stem}-", suffix=".json", dir=CACHE_DIR)
    with os.fdopen(fd, "w") as handle:
        json.dump(payload, handle)
    os.replace(temporary, path)


def load_usage(tokscale):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    try:
        result = subprocess.run(
            ["/usr/bin/timeout", "5", tokscale, "usage", "--json"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        payload = json.loads(result.stdout)
        if valid(payload):
            atomic_write_json(CACHE_FILE, payload)
            return payload, False
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        pass

    try:
        with CACHE_FILE.open() as handle:
            payload = json.load(handle)
        if valid(payload):
            return payload, True
    except (OSError, json.JSONDecodeError):
        pass

    return [], True


def load_today(tokscale):
    """Return today's token/cost payload, tolerant of failure -> None.

    Cached separately since the underlying call scans session directories
    and is comparatively expensive; served from cache within TODAY_CACHE_TTL.
    """
    try:
        stat = TODAY_CACHE_FILE.stat()
        if datetime.now().timestamp() - stat.st_mtime < TODAY_CACHE_TTL:
            with TODAY_CACHE_FILE.open() as handle:
                return json.load(handle)
    except (OSError, json.JSONDecodeError):
        pass

    try:
        result = subprocess.run(
            ["/usr/bin/timeout", "5", tokscale, "--json", "--today", "--no-spinner"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        payload = json.loads(result.stdout)
        atomic_write_json(TODAY_CACHE_FILE, payload)
        return payload
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        pass

    try:
        with TODAY_CACHE_FILE.open() as handle:
            return json.load(handle)
    except (OSError, json.JSONDecodeError):
        return None


def provider(payload, name):
    return next((item for item in payload if item.get("provider") == name), {})


def metric(item, label):
    return next((m for m in item.get("metrics", []) if m.get("label") == label), {})


def percent(item, label):
    value = metric(item, label).get("remaining_percent")
    return f"{value:.0f}%" if isinstance(value, (int, float)) else "—"


def reset(item, label):
    value = metric(item, label).get("resets_at")
    if not value:
        return "not reported"
    try:
        reset_at = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if reset_at.tzinfo is None:
            reset_at = reset_at.replace(tzinfo=timezone.utc)
        return reset_at.astimezone(ZoneInfo("Asia/Jakarta")).strftime("%Y-%m-%d %H:%M WIB")
    except (ValueError, KeyError):
        return value


def reset_days(item, label):
    value = metric(item, label).get("resets_at")
    if not value:
        return "—"
    try:
        reset_at = datetime.fromisoformat(value.replace("Z", "+00:00"))
        if reset_at.tzinfo is None:
            reset_at = reset_at.replace(tzinfo=timezone.utc)
        days = max(0, math.ceil((reset_at - datetime.now(timezone.utc)).total_seconds() / 86400))
        return f"{days}D"
    except ValueError:
        return "—"


def build_bar_output(tokscale):
    if tokscale is None:
        return {"text": "", "tooltip": "", "class": "unavailable"}

    payload, stale = load_usage(tokscale)
    codex = provider(payload, "Codex")
    claude = provider(payload, "Claude")

    codex_remaining = percent(codex, "Weekly")
    claude_remaining = percent(claude, "Weekly")
    codex_reset_days = reset_days(codex, "Weekly")
    claude_reset_days = reset_days(claude, "Weekly")
    codex_plan = codex.get("plan", "unknown plan")
    claude_plan = claude.get("plan", "unknown plan")

    if not payload:
        return {
            "text": "AI —",
            "tooltip": "Tokscale subscription usage unavailable",
            "class": "unavailable",
        }

    freshness = " (cached)" if stale else ""
    return {
        "text": f"OAI {codex_remaining} {codex_reset_days}   ANT {claude_remaining} {claude_reset_days}",
        "tooltip": (
            f"OAI / Codex ({codex_plan})\n"
            f"  Weekly: {codex_remaining} remaining ({codex_reset_days})\n"
            f"  Reset: {reset(codex, 'Weekly')}\n"
            f"  Session: {percent(codex, 'Session')} remaining\n"
            f"ANT / Claude ({claude_plan})\n"
            f"  Weekly: {claude_remaining} remaining ({claude_reset_days})\n"
            f"  Reset: {reset(claude, 'Weekly')}\n"
            f"  Session: {percent(claude, 'Session')} remaining\n"
            f"Source: Tokscale{freshness}"
        ),
        "class": "stale" if stale else "available",
    }


def build_json_output(tokscale):
    if tokscale is None:
        return {"available": False}

    payload, stale = load_usage(tokscale)
    today = load_today(tokscale)

    return {
        "available": bool(payload),
        "fetched_at": datetime.now(timezone.utc).isoformat(),
        "stale": stale,
        "subscriptions": payload,
        "today": today,
    }


def run_probe(tokscale):
    if tokscale is None:
        print("tokscale not found: checked ~/.local/share/tokscale/node_modules/.bin/tokscale and PATH", file=sys.stderr)
        return 1
    print(tokscale)
    return 0


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "--bar"
    tokscale = find_tokscale()

    if mode == "--probe":
        return run_probe(tokscale)
    if mode == "--json":
        print(json.dumps(build_json_output(tokscale)))
        return 0
    if mode == "--bar":
        print(json.dumps(build_bar_output(tokscale)))
        return 0

    print(f"usage: {sys.argv[0]} [--bar|--json|--probe]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
