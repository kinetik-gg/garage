#!/bin/sh

# GTK_MODULES is normally inherited from the graphical session, but Thunar can
# also arrive through a terminal, a desktop file, or D-Bus/systemd activation.
# Put the Garage integration on every one of those launch paths instead of
# relying on whichever environment happened to start the first Thunar process.
garage_thunar_module="${XDG_DATA_HOME:-$HOME/.local/share}/garage/gtk-modules/garage-thunar.so"
case ":${GTK_MODULES:-}:" in
    *":$garage_thunar_module:"*) ;;
    *)
        if [ -r "$garage_thunar_module" ]; then
            export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}$garage_thunar_module"
        fi
        ;;
esac
unset garage_thunar_module

exec /usr/bin/thunar "$@"
