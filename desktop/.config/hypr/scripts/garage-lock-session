#!/bin/sh

inhibitor="lock"
state_root=${XDG_STATE_HOME:-"$HOME/.local/state"}
generated="$state_root/garage/generated"
monitor_state="$generated/hyprlock-monitor.conf"
display_config="${XDG_CONFIG_HOME:-"$HOME/.config"}/garage/displays.toml"

configured_primary() {
    [ -r "$display_config" ] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    python3 - "$display_config" <<'PY' 2>/dev/null || true
import sys
import tomllib

with open(sys.argv[1], "rb") as source:
    primary = tomllib.load(source).get("primary", "")
if isinstance(primary, str):
    print(primary)
PY
}

lock_geometry() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0
    primary=$(configured_primary)
    case $primary in
        *[!A-Za-z0-9_.:-]*) primary= ;;
    esac
    hyprctl monitors -j 2>/dev/null |
        jq -r --arg primary "$primary" '
            [ .[] | select((.disabled // false) != true) ] as $enabled
            | (($enabled | map(select(.name == $primary)) | first)
               // ($enabled | first) // {})
            | ((.scale // 1) | tonumber) as $reportedScale
            | (if $reportedScale > 0 then $reportedScale else 1 end) as $scale
            | (.name // "") as $name
            | [(if $name | test("^[A-Za-z0-9_.:-]+$") then $name else "" end),
               (320 * $scale | round), (44 * $scale | round)]
            | map(tostring) | join("|")
        ' 2>/dev/null || true
}

write_monitor_state() {
    geometry=$(lock_geometry)
    IFS='|' read -r monitor auth_width auth_height <<EOF
$geometry
EOF
    case $monitor in
        *[!A-Za-z0-9_.:-]*) monitor= ;;
    esac
    case $auth_width:$auth_height in
        *[!0-9:]* | :* | *:) auth_width=320; auth_height=44 ;;
    esac

    mkdir -p -- "$generated"
    temporary=$(mktemp "$generated/.hyprlock-monitor.XXXXXX")
    chmod 600 "$temporary"
    # shellcheck disable=SC2016
    # $auth_monitor is Hyprlang syntax, not a shell expression.
    printf '%s\n' \
        '# Generated by garage-lock-session.' \
        "\$auth_monitor = $monitor" \
        "\$auth_width = $auth_width" \
        "\$auth_height = $auth_height" >"$temporary"
    mv -f -- "$temporary" "$monitor_state"
}

cleanup() {
    if [ -n "${temporary:-}" ]; then
        rm -f -- "$temporary"
    fi
    timeout 2 qs -c garage ipc call notifications release "$inhibitor" >/dev/null 2>&1 || true
}

trap cleanup EXIT HUP INT TERM
write_monitor_state
timeout 2 qs -c garage ipc call shell closeNotifications >/dev/null 2>&1 || true
timeout 2 qs -c garage ipc call notifications inhibit "$inhibitor" >/dev/null 2>&1 || true
hyprlock --immediate-render
