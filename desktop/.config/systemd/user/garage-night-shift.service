[Unit]
Description=Synchronize Night Shift with Jakarta local time
# This timer is active with the user manager, including before graphical login.
# Pulling hyprsunset here would transitively pull graphical-session.target.
After=hyprsunset.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
ExecStart=%h/.config/hypr/scripts/garage-night-shift-sync
