[Unit]
Description=Subtle desktop volume and brightness OSD
PartOf=graphical-session.target
After=graphical-session.target pipewire-pulse.service

[Service]
ExecStart=/usr/bin/swayosd-server --config %h/.config/swayosd/config.toml
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
