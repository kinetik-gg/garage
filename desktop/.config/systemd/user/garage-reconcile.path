[Unit]
Description=Watch Garage host preferences for reconciliation
PartOf=graphical-session.target
# Do not order a path unit after graphical-session.target. Path units are
# implicitly ordered before paths.target, which is below basic.target; reversing
# that chain here creates a cycle and lets the target become active before UWSM.

[Path]
PathChanged=%h/.config/garage/preferences.toml
PathChanged=%h/.config/garage/displays.toml
PathChanged=%h/.config/garage/keybindings.toml
PathChanged=%h/.config/garage/workspace-blocks.toml
Unit=garage-reconcile.service

[Install]
WantedBy=graphical-session.target
