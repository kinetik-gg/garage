/* Structure only. Palettes define the colour names, then import this. */
window {
    width: 680px;
    border: 1px;
    border-radius: 16px;
    border-color: @border-color;
    background-color: @background;
}

mainbox {
    padding: 0px;
    spacing: 0px;
    background-color: transparent;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 16px 18px;
    spacing: 14px;
    border: 0px;
    border-radius: 0px;
    background-color: transparent;
    children: [ prompt, entry ];
}

prompt {
    text-color: @foreground-muted;
    background-color: transparent;
    font: "CaskaydiaMono Nerd Font Mono 18";
}

entry {
    placeholder: "Spotlight Search";
    placeholder-color: @foreground-muted;
    text-color: @foreground-strong;
    background-color: transparent;
    font: "Plus Jakarta Sans 20";
}

message {
    enabled: true;
    padding: 10px 18px;
    border: 1px 0px 0px;
    border-color: @border-color;
    border-radius: 0px;
    background-color: transparent;
    text-color: @foreground-strong;
}

textbox {
    expand: true;
    background-color: transparent;
    text-color: @foreground-strong;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 0px;
    border: 1px 0px 0px;
    border-color: @border-color;
    background-color: transparent;
}

element {
    padding: 8px 18px;
    border-radius: 0px;
    spacing: 14px;
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selection;
    text-color: @foreground-strong;
}

element-icon {
    size: 32px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    font: "Plus Jakarta Sans 13";
}
