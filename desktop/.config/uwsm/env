export BROWSER=xdg-open
export TERM=xterm-kitty
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export HYPRCURSOR_THEME="macOS"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="macOS"
export XCURSOR_SIZE=24

# GTK3 cannot express two Thunar-only interactions in CSS: its shortcuts pane
# exposes every row through one treeview node, and its CSD toolbar spans the
# whole window instead of the content pane. This tiny module is a no-op outside
# Thunar; bootstrap compiles it for the installed GTK version. The dedicated
# Thunar wrapper also sets this variable because terminal and D-Bus activation
# do not reliably inherit a graphical session's original environment.
garage_thunar_module="${XDG_DATA_HOME:-$HOME/.local/share}/garage/gtk-modules/garage-thunar.so"
if [ -r "$garage_thunar_module" ]; then
	export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}$garage_thunar_module"
fi
unset garage_thunar_module

# LANG chosen in System Preferences > Language & Region. Sourced rather than
# written here: this file is a stow symlink into the dotfiles repo, and the
# setting has to be writable at runtime. Absent until the first render, which
# leaves the session on the system locale -- the same as no override.
if [ -r "${XDG_STATE_HOME:-$HOME/.local/state}/garage/generated/locale.env" ]; then
	. "${XDG_STATE_HOME:-$HOME/.local/state}/garage/generated/locale.env"
fi

